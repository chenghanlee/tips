# Local-only Compose superuser: migrations create vector and pg_textsearch.
PGUSER=postgres
PGPASSWORD=postgres
PGHOST=localhost
PGPORT=5433

# Give each worktree a unique suffix, e.g. _31 (tips_dev_31 / tips_test_31).
TIPS_DB_SUFFIX=

# PORT sets the local HTTP port. PHX_HOST is used by production configuration.
PHX_HOST=localhost
PORT=4000
