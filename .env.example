# Local-only Compose superuser: migrations create vector and pg_textsearch.
PGUSER=postgres
PGPASSWORD=postgres
PGHOST=localhost
PGPORT=5433

# Give each worktree a unique suffix, e.g. _31 (tips_dev_31 / tips_test_31).
TIPS_DB_SUFFIX=

# PORT sets the local HTTP port. PHX_HOST is used by production configuration.
PHX_HOST=localhost
PORT=4000

# Provider settings. Dev and test read these names from this file; exported values win.
# Leave them empty until you work on a feature that needs them.
# Use NAME=value, NAME='value' or NAME="value" (no $, ` or \ inside double quotes).
OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_SIGNING_KEY=
