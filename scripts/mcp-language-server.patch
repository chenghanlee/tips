+func syncMessages(t *testing.T, pipe *recordingPipe) []*Message {
+	t.Helper()
+	reader := bufio.NewReader(bytes.NewReader(pipe.Bytes()))
+	var messages []*Message
+	for {
+		msg, err := ReadMessage(reader)
+		if errors.Is(err, io.EOF) {
+			return messages
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		messages = append(messages, msg)
+	}
+}
+
+func assertSyncChange(t *testing.T, msg *Message, version int32, text string) {
+	t.Helper()
+	var params struct {
+		TextDocument struct {
+			Version int32 `json:"version"`
+		} `json:"textDocument"`
+		ContentChanges []struct {
+			Text string `json:"text"`
+		} `json:"contentChanges"`
+	}
+	if err := json.Unmarshal(msg.Params, &params); err != nil {
+		t.Fatal(err)
+	}
+	if msg.Method != "textDocument/didChange" || params.TextDocument.Version != version || len(params.ContentChanges) != 1 || params.ContentChanges[0].Text != text {
+		t.Fatalf("unexpected change: method=%s params=%s", msg.Method, msg.Params)
+	}
+}
+
+func TestSyncSkipsUnchangedButRefreshStillSends(t *testing.T) {
+	c, pipe := testClient()
+	path := filepath.Join(t.TempDir(), "sample.ex")
+	if err := os.WriteFile(path, []byte("original"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	ctx := context.Background()
+	if err := c.OpenFile(ctx, path); err != nil {
+		t.Fatal(err)
+	}
+	t.Chdir(filepath.Dir(path))
+	for range 3 {
+		if err := c.SyncFile(ctx, "sample.ex"); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if messages := syncMessages(t, pipe); len(messages) != 1 || messages[0].Method != "textDocument/didOpen" {
+		t.Fatalf("unchanged sync sent extra notifications: %v", messages)
+	}
+	for want := int32(2); want <= 3; want++ {
+		version, _, err := c.NotifyChangeVersion(ctx, path)
+		if err != nil || version != want {
+			t.Fatalf("refresh version=%d err=%v", version, err)
+		}
+		if err := c.SyncFile(ctx, path); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := os.WriteFile(path, []byte("edited"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	// A forced refresh also updates the last-sent contents used by navigation.
+	if _, _, err := c.NotifyChangeVersion(ctx, path); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.SyncFile(ctx, path); err != nil {
+		t.Fatal(err)
+	}
+	messages := syncMessages(t, pipe)
+	if len(messages) != 4 {
+		t.Fatalf("got %d messages, want 4", len(messages))
+	}
+	assertSyncChange(t, messages[1], 2, "original")
+	assertSyncChange(t, messages[2], 3, "original")
+	assertSyncChange(t, messages[3], 4, "edited")
+}
