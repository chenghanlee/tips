+		raw, err := json.Marshal(map[string]any{"uri": uri, "diagnostics": []any{}})
+		if err != nil {
+			t.Fatal(err)
+		}
+		HandleDiagnostics(c, raw)
+	}
+	publish()
+	c.stdin = &publishOnWrite{pipe, publish}
+	version, before, err := c.NotifyChangeVersion(ctx, path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	after, _ := c.DiagnosticsSeq(uri)
+	if version != 2 || before != 1 || after != 2 {
+		t.Fatalf("version=%d before=%d after=%d; want 2,1,2", version, before, after)
+	}
+	snapshot, ok := c.WaitForDiagnostics(ctx, uri, before, version, time.Second)
+	if !ok || snapshot.Sequence != 2 {
+		t.Fatalf("post-send publication lost: %+v, %v", snapshot, ok)
+	}
+}
