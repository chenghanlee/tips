+
+// Run the real bridge and a framed fake language server as separate processes.
+func TestBridgeLifecycleHelper(t *testing.T) {
+	if os.Getenv("MCP_LIFECYCLE_HELPER") != "1" {
+		return
+	}
+	if len(os.Args) == 4 && os.Args[3] == "fake-lsp" {
+		lifecycleFakeLSP()
+		os.Exit(0)
+	}
+	for i, arg := range os.Args {
+		if arg == "--" {
+			os.Args = append([]string{os.Args[0]}, os.Args[i+1:]...)
+			break
+		}
+	}
+	flag.CommandLine = flag.NewFlagSet("bridge", flag.ExitOnError)
+	main()
+}
+
+func lifecycleFakeLSP() {
+	trace, _ := os.OpenFile(os.Getenv("MCP_LIFECYCLE_TRACE"), os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0600)
+	defer trace.Close()
+	reader := bufio.NewReader(os.Stdin)
+	for {
+		size := 0
+		for {
+			line, err := reader.ReadString('\n')
+			if err != nil {
+				if os.Getenv("MCP_LIFECYCLE_MODE") == "stubborn" {
+					for {
+						time.Sleep(time.Hour)
+					}
+				}
+				return
+			}
+			if line == "\r\n" {
+				break
+			}
+			if strings.HasPrefix(line, "Content-Length:") {
+				size, _ = strconv.Atoi(strings.TrimSpace(strings.TrimPrefix(line, "Content-Length:")))
+			}
+		}
+		body := make([]byte, size)
+		if _, err := io.ReadFull(reader, body); err != nil {
+			return
+		}
+		var message map[string]any
+		if json.Unmarshal(body, &message) != nil {
+			return
+		}
+		message["pid"] = os.Getpid()
+		_ = json.NewEncoder(trace).Encode(message)
+		method, _ := message["method"].(string)
+		if method == "exit" && os.Getenv("MCP_LIFECYCLE_MODE") != "stubborn" {
+			return
+		}
+		id, exists := message["id"]
+		if !exists {
+			continue
+		}
+		if method == "initialize" && os.Getenv("MCP_LIFECYCLE_MODE") == "initializing" {
+			continue
+		}
+		var result any
+		if method == "initialize" {
+			result = map[string]any{"capabilities": map[string]any{}}
+		}
+		reply, _ := json.Marshal(map[string]any{"jsonrpc": "2.0", "id": id, "result": result})
+		fmt.Fprintf(os.Stdout, "Content-Length: %d\r\n\r\n%s", len(reply), reply)
+	}
+}
+
+func TestBridgeStartsInWorkspaceAndStopsWithSession(t *testing.T) {
+	for _, mode := range []string{"eof", "signal", "stubborn", "initializing"} {
+		t.Run(mode, func(t *testing.T) {
+			t.Parallel()
+			workspace, err := filepath.EvalSymlinks(t.TempDir())
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := os.WriteFile(filepath.Join(workspace, "mix.exs"), []byte("# lifecycle fixture\n"), 0600); err != nil {
+				t.Fatal(err)
+			}
+			trace := filepath.Join(t.TempDir(), "events.jsonl")
+			executable, err := os.Executable()
+			if err != nil {
+				t.Fatal(err)
+			}
+			cmd := exec.Command(executable, "-test.run=^TestBridgeLifecycleHelper$", "--", "--workspace", workspace, "--lsp", executable, "--", "-test.run=^TestBridgeLifecycleHelper$", "--", "fake-lsp")
+			cmd.Env = append(os.Environ(), "MCP_LIFECYCLE_HELPER=1", "MCP_LIFECYCLE_TRACE="+trace, "MCP_LIFECYCLE_MODE="+mode)
+			var output bytes.Buffer
+			cmd.Stdout, cmd.Stderr = &output, &output
+			stdin, err := cmd.StdinPipe()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := cmd.Start(); err != nil {
+				t.Fatal(err)
+			}
+			defer stdin.Close()
+			defer cmd.Process.Kill()
+			done := make(chan error, 1)
+			go func() { done <- cmd.Wait() }()
+			events := []map[string]any{}
+			deadline := time.Now().Add(5 * time.Second)
+			ready := false
+			var lspPID int
+			for time.Now().Before(deadline) {
+				data, _ := os.ReadFile(trace)
+				events = nil
+				for _, line := range bytes.Split(data, []byte("\n")) {
+					var event map[string]any
+					if json.Unmarshal(line, &event) != nil {
+						continue
+					}
+					events = append(events, event)
+					lspPID = int(event["pid"].(float64))
+					if event["method"] == "initialize" && mode == "initializing" {
+						ready = true
+					}
+					if event["method"] == "initialized" {
+						ready = true
+					}
+				}
+				if ready {
+					break
+				}
+				time.Sleep(20 * time.Millisecond)
+			}
+			if lspPID != 0 {
+				defer syscall.Kill(lspPID, syscall.SIGKILL)
+			}
+			if !ready {
+				t.Fatal("LSP did not start before a tool call")
+			}
+			params := events[0]["params"].(map[string]any)
+			if params["rootUri"] != "file://"+workspace {
+				t.Fatalf("wrong LSP root: %v", params["rootUri"])
+			}
+			if mode == "signal" || mode == "initializing" {
+				_ = cmd.Process.Signal(syscall.SIGTERM)
+			} else {
+				_ = stdin.Close()
+			}
+			select {
+			case err := <-done:
+				if err != nil {
+					t.Fatalf("bridge exit: %v\n%s", err, output.String())
+				}
+			case <-time.After(8 * time.Second):
+				t.Fatal("bridge survived session shutdown")
+			}
+			if syscall.Kill(lspPID, 0) == nil {
+				t.Fatal("LSP survived bridge shutdown")
+			}
+			if strings.Contains(output.String(), "panic:") {
+				t.Fatalf("shutdown panic: %s", output.String())
+			}
+		})
+	}
+}
