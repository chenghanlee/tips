+func TestRelativeToolsUseOneAbsoluteDocument(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "sample #1.ex")
+	if err := os.WriteFile(path, []byte("sample\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	t.Chdir(filepath.Dir(path))
+	relative := "sample #1.ex"
+	t.Setenv("ASTRA_URI_TEST_SERVER", "1")
+	client, err := lsp.NewClient(os.Args[0], "-test.run=^TestRelativePathServer$")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = client.Cmd.Process.Kill(); _ = client.Cmd.Wait() }()
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	if err := client.OpenFile(ctx, path); err != nil {
+		t.Fatal(err)
+	}
+	hover, err := GetHoverInfo(ctx, client, relative, 1, 1)
+	if err != nil || hover != "canonical document" {
+		t.Fatalf("hover=%q err=%v", hover, err)
+	}
+	lenses, err := GetCodeLens(ctx, client, relative)
+	if err != nil || !strings.Contains(lenses, "canonical lens") {
+		t.Fatalf("code lenses=%q err=%v", lenses, err)
+	}
+	if _, err := ExecuteCodeLens(ctx, client, relative, 1); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := RenameSymbol(ctx, client, relative, 1, 1, "renamed"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := ApplyTextEdits(ctx, client, relative, []TextEdit{{StartLine: 1, EndLine: 1, NewText: "edited"}}); err != nil {
+		t.Fatal(err)
+	}
+	content, err := os.ReadFile(path)
+	if err != nil || string(content) != "edited\n" {
+		t.Fatalf("edit=%q err=%v", content, err)
+	}
+}
