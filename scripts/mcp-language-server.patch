+package main
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"math"
+	"strings"
+	"testing"
+
+	"github.com/mark3labs/mcp-go/server"
+)
+
+// Invalid coordinates must be rejected before any language-server call or edit.
+func TestPositionToolsRejectInvalidCoordinates(t *testing.T) {
+	s := &mcpServer{mcpServer: server.NewMCPServer("test", "1", server.WithRecovery())}
+	if err := s.registerTools(); err != nil {
+		t.Fatal(err)
+	}
+	for _, tool := range []string{"definition", "references", "hover", "rename_symbol"} {
+		for _, field := range []string{"line", "column"} {
+			for _, value := range []any{nil, "1", 0, -1, 1.5, 4294967296.0} {
+				t.Run(fmt.Sprintf("%s/%s/%v", tool, field, value), func(t *testing.T) {
+					args := map[string]any{"filePath": "unused.ex", "line": 1, "column": 1, "newName": "renamed"}
+					if value == nil {
+						delete(args, field)
+					} else {
+						args[field] = value
+					}
+					raw, err := json.Marshal(map[string]any{"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": map[string]any{"name": tool, "arguments": args}})
+					if err != nil {
+						t.Fatal(err)
+					}
+					response := s.mcpServer.HandleMessage(context.Background(), raw)
+					encoded, err := json.Marshal(response)
+					if err != nil {
+						t.Fatal(err)
+					}
+					var envelope struct {
+						Result struct {
+							IsError bool `json:"isError"`
+							Content []struct {
+								Text string `json:"text"`
+							} `json:"content"`
+						} `json:"result"`
+					}
+					if err := json.Unmarshal(encoded, &envelope); err != nil {
+						t.Fatal(err)
+					}
+					if !envelope.Result.IsError || len(envelope.Result.Content) != 1 || !strings.Contains(envelope.Result.Content[0].Text, field+" must be a positive integer") {
+						t.Fatalf("invalid coordinate reached beyond validation: %s", encoded)
+					}
+				})
+			}
+		}
+	}
+}
+
+// The parser is shared by all position tools, including edits through rename.
+func TestParsePositionBoundaries(t *testing.T) {
+	for _, value := range []any{1, float64(1), float64(math.MaxUint32)} {
+		position, err := parsePosition(map[string]any{"line": value, "column": value})
+		if err != nil || position[0] < 1 || position[0] != position[1] {
+			t.Fatalf("value=%v position=%v err=%v", value, position, err)
+		}
+		want := 1
+		if value == float64(math.MaxUint32) {
+			want = math.MaxUint32
+		}
+		if position[0] != want {
+			t.Fatalf("got %v, want %d", position, want)
+		}
+	}
+	for _, value := range []float64{math.NaN(), math.Inf(1), math.Inf(-1)} {
+		if _, err := parsePosition(map[string]any{"line": value, "column": 1}); err == nil {
+			t.Fatalf("accepted non-finite coordinate: %v", value)
+		}
+	}
+}
