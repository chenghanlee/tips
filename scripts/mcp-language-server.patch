+
+func (c *recordingClient) IsFileOpen(string) bool { return false }
+func (c *recordingClient) OpenFile(_ context.Context, path string) error {
+	c.opened = append(c.opened, path)
+	return nil
+}
+func (c *recordingClient) NotifyChange(context.Context, string) error { return nil }
+func (c *recordingClient) DidChangeWatchedFiles(_ context.Context, p protocol.DidChangeWatchedFilesParams) error {
+	c.events = append(c.events, p.Changes...)
+	return nil
+}
+
+type filteredClient struct{ *recordingClient }
+
+func (c *filteredClient) ShouldOpenFile(path string) bool { return filepath.Ext(path) == ".exs" }
+
+func TestAutomaticOpenFilterPreservesFileEvents(t *testing.T) {
+	root := t.TempDir()
+	for _, name := range []string{"mix.exs", "README.md"} {
+		if err := os.WriteFile(filepath.Join(root, name), []byte("fixture"), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, filtered := range []bool{false, true} {
+		client := &recordingClient{}
+		var endpoint LSPClient = client
+		if filtered {
+			endpoint = &filteredClient{client}
+		}
+		w := NewWorkspaceWatcher(endpoint)
+		for _, name := range []string{"mix.exs", "README.md"} {
+			w.openMatchingFile(context.Background(), filepath.Join(root, name))
+		}
+		want := 2
+		if filtered {
+			want = 1
+		}
+		if len(client.opened) != want {
+			t.Errorf("filtered=%v: opened %v", filtered, client.opened)
+		}
+		// Watching assets and opening text documents are separate LSP operations.
+		w.handleFileEvent(context.Background(), "file://"+filepath.Join(root, "README.md"), protocol.FileChangeType(protocol.Changed))
+		if len(client.events) != 1 {
+			t.Errorf("filtered=%v: lost watched file event", filtered)
+		}
+	}
