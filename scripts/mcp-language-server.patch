+func TestExpertOverlappingProjects(t *testing.T) {
+	client, fast := startupClient(t, "cold")
+	slowRoot := filepath.Join(filepath.Dir(filepath.Dir(fast)), "slow")
+	if err := os.MkdirAll(slowRoot, 0700); err != nil {
+		t.Fatal(err)
+	}
+	for _, name := range []string{"mix.exs", "sample.ex"} {
+		if err := os.WriteFile(filepath.Join(slowRoot, name), []byte("# fixture\n"), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 21*time.Second)
+	defer cancel()
+	var wg sync.WaitGroup
+	for _, path := range []string{fast, filepath.Join(slowRoot, "sample.ex")} {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			result, err := ReadDefinitionAt(ctx, client, path, 1, 2)
+			if err != nil || !strings.Contains(result, "File: "+path) {
+				t.Errorf("project %s released before its compile: %q, %v", path, result, err)
+			}
+		}()
+	}
+	wg.Wait()
+}
