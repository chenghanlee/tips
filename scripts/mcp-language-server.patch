+func TestExpertMissingStartupWaitsOnce(t *testing.T) {
+	client, path := startupClient(t, "missing")
+	for i := 0; i < 2; i++ {
+		ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second+200*time.Millisecond)
+		start := time.Now()
+		result, err := ReadDefinitionAt(ctx, client, path, 1, 2)
+		elapsed := time.Since(start)
+		cancel()
+		if err != nil || !strings.Contains(result, "startup unconfirmed") {
+			t.Fatalf("missing startup: %q, %v", result, err)
+		}
+		if i == 0 && elapsed < 150*time.Millisecond {
+			t.Fatal("first call skipped startup wait")
+		}
+		if i == 1 && elapsed > 100*time.Millisecond {
+			t.Fatal("second call repeated startup wait")
+		}
+	}
+}
