+)
+
+type recordingPipe struct{ bytes.Buffer }
+
+func (p *recordingPipe) Close() error { return nil }
+func (p *recordingPipe) Write(b []byte) (int, error) {
+	// Widen the interval between checking openFiles and completing didOpen.
+	time.Sleep(time.Millisecond)
+	return p.Buffer.Write(b)
+}
+
+func testClient() (*Client, *recordingPipe) {
+	pipe := &recordingPipe{}
+	return &Client{stdin: pipe, openFiles: make(map[string]*OpenFileInfo),
+		diagnostics:         make(map[protocol.DocumentUri][]protocol.Diagnostic),
+		diagnosticsVersions: make(map[protocol.DocumentUri]*int32), diagnosticsSeq: make(map[protocol.DocumentUri]uint64), diagnosticsPublished: make(chan struct{}),
+		handlers: make(map[string]chan *Message)}, pipe
+}
+
+func TestConcurrentOpenSendsOneNotification(t *testing.T) {
+	c, pipe := testClient()
+	path := filepath.Join(t.TempDir(), "sample.ex")
+	if err := os.WriteFile(path, []byte("defmodule Sample do\nend\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	var wg sync.WaitGroup
+	start := make(chan struct{})
+	for range 32 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			<-start
+			if err := c.OpenFile(context.Background(), path); err != nil {
+				t.Error(err)
+			}
+		}()
+	}
+	close(start)
+	wg.Wait()
+	reader := bufio.NewReader(bytes.NewReader(pipe.Bytes()))
+	count := 0
+	for {
+		msg, err := ReadMessage(reader)
+		if err != nil {
+			if errors.Is(err, io.EOF) {
+				break
+			}
+			t.Fatal(err)
+		}
+		if msg.Method == "textDocument/didOpen" {
+			count++
+		}
+	}
+	if count != 1 {
+		t.Fatalf("sent %d didOpen notifications; want 1", count)
+	}
+}
+
+func TestOlderPublishCannotOverwriteNewerWarning(t *testing.T) {
+	c, _ := testClient()
+	uri := protocol.DocumentUri("file:///sample.ex")
+	HandleDiagnostics(c, json.RawMessage(`{"uri":"file:///sample.ex","version":3,"diagnostics":[{"range":{"start":{"line":1,"character":0},"end":{"line":1,"character":1}},"message":"current warning"}]}`))
+	HandleDiagnostics(c, json.RawMessage(`{"uri":"file:///sample.ex","version":2,"diagnostics":[]}`))
+	got := c.GetFileDiagnostics(uri)
+	if len(got) != 1 || got[0].Message != "current warning" {
+		t.Fatalf("older publication overwrote current warning: %v", got)
+	}
+}
+
+func TestCallCancellationRemovesPendingRequest(t *testing.T) {
+	c, _ := testClient()
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Millisecond)
+	defer cancel()
+	err := c.Call(ctx, "textDocument/documentSymbol", nil, nil)
+	if !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("wanted deadline error, got %v", err)
+	}
+	if len(c.handlers) != 0 {
+		t.Fatalf("pending requests leaked: %d", len(c.handlers))
+	}
+}
+
+func TestConcurrentChangesAreSentInVersionOrder(t *testing.T) {
+	c, pipe := testClient()
+	path := filepath.Join(t.TempDir(), "sample.ex")
+	if err := os.WriteFile(path, []byte("defmodule Sample do\nend\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.OpenFile(context.Background(), path); err != nil {
+		t.Fatal(err)
+	}
+	var wg sync.WaitGroup
+	for range 32 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			if err := c.NotifyChange(context.Background(), path); err != nil {
+				t.Error(err)
+			}
+		}()
+	}
+	wg.Wait()
+	reader := bufio.NewReader(bytes.NewReader(pipe.Bytes()))
+	want := int32(2)
+	for {
+		msg, err := ReadMessage(reader)
+		if err != nil {
+			if errors.Is(err, io.EOF) {
+				break
+			}
+			t.Fatal(err)
+		}
+		if msg.Method == "textDocument/didChange" {
+			var params protocol.DidChangeTextDocumentParams
+			if err := json.Unmarshal(msg.Params, &params); err != nil {
+				t.Fatal(err)
+			}
+			if params.TextDocument.Version != want {
+				t.Fatalf("got wire version %d, want %d", params.TextDocument.Version, want)
+			}
+			want++
+		}
+	}
+	if want != 34 {
+		t.Fatalf("got %d changes, want 32", want-2)
+	}
+}
+
+func TestDiagnosticsWaitDoesNotAcceptOlderVersion(t *testing.T) {
+	c, _ := testClient()
+	uri := protocol.DocumentUri("file:///sample.ex")
+	HandleDiagnostics(c, json.RawMessage(`{"uri":"file:///sample.ex","version":2,"diagnostics":[]}`))
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	snapshot, matched := c.WaitForDiagnostics(ctx, uri, 0, 3, time.Second)
+	if matched || snapshot.Version == nil || *snapshot.Version != 2 {
+		t.Fatalf("older version accepted: %+v, %v", snapshot, matched)
+	}
+	HandleDiagnostics(c, json.RawMessage(`{"uri":"file:///sample.ex","version":3,"diagnostics":[]}`))
+	snapshot, matched = c.WaitForDiagnostics(context.Background(), uri, 0, 3, time.Second)
+	if !matched || snapshot.Version == nil || *snapshot.Version != 3 {
+		t.Fatalf("matching version rejected: %+v, %v", snapshot, matched)
+	}
+}
+
+func TestUnversionedDiagnosticsRemainIdentifiable(t *testing.T) {
+	c, _ := testClient()
+	HandleDiagnostics(c, json.RawMessage(`{"uri":"file:///sample.ex","diagnostics":[]}`))
+	snapshot, published := c.WaitForDiagnostics(context.Background(), "file:///sample.ex", 0, 3, time.Second)
+	if !published || snapshot.Version != nil || snapshot.Sequence != 1 {
+		t.Fatalf("missing version treated as verified: %+v", snapshot)
+	}
+}
+
+func TestCallReturnsWhenServerCloses(t *testing.T) {
+	c, _ := testClient()
+	c.closed = make(chan struct{})
+	close(c.closed)
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	err := c.Call(ctx, "textDocument/documentSymbol", nil, nil)
+	if err == nil || errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("did not report connection closure: %v", err)
+	}
+}
+
+func TestReopenDoesNotInheritOldDiagnosticVersion(t *testing.T) {
+	c, _ := testClient()
+	path := filepath.Join(t.TempDir(), "sample.ex")
+	if err := os.WriteFile(path, []byte("defmodule Sample do\nend\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.OpenFile(context.Background(), path); err != nil {
+		t.Fatal(err)
+	}
+	uri := protocol.DocumentUri("file://" + path)
+	publish := func(version int, message string) {
+		raw, err := json.Marshal(map[string]any{"uri": uri, "version": version, "diagnostics": []map[string]any{{"message": message}}})
+		if err != nil {
+			t.Fatal(err)
+		}
+		HandleDiagnostics(c, raw)
+	}
+	publish(10, "old")
+	if err := c.CloseFile(context.Background(), path); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.OpenFile(context.Background(), path); err != nil {
+		t.Fatal(err)
+	}
+	publish(1, "new")
+	if got := c.GetFileDiagnostics(uri); len(got) != 1 || got[0].Message != "new" {
+		t.Fatalf("new diagnostics rejected after reopen: %v", got)
+	}
+}
+
+func TestRelativeAndAbsolutePathsShareDocument(t *testing.T) {
+	c, pipe := testClient()
+	path := filepath.Join(t.TempDir(), "sample.ex")
+	if err := os.WriteFile(path, []byte("sample"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	t.Chdir(filepath.Dir(path))
+	relative := "sample.ex"
+	ctx := context.Background()
+	if err := c.OpenFile(ctx, relative); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.OpenFile(ctx, path); err != nil {
+		t.Fatal(err)
+	}
+	if !c.IsFileOpen(relative) || !c.IsFileOpen(path) {
+		t.Fatal("open state differs by path spelling")
+	}
+	if err := c.NotifyChange(ctx, relative); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.CloseFile(ctx, path); err != nil {
+		t.Fatal(err)
+	}
+	if c.IsFileOpen(relative) || c.IsFileOpen(path) {
+		t.Fatal("relative document remains open after absolute close")
+	}
+	reader := bufio.NewReader(bytes.NewReader(pipe.Bytes()))
+	methods := []string{"textDocument/didOpen", "textDocument/didChange", "textDocument/didClose"}
+	for _, method := range methods {
+		msg, err := ReadMessage(reader)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var params struct {
+			TextDocument struct {
+				URI string `json:"uri"`
+			} `json:"textDocument"`
+		}
+		if err := json.Unmarshal(msg.Params, &params); err != nil {
+			t.Fatal(err)
+		}
+		if msg.Method != method || params.TextDocument.URI != "file://"+path {
+			t.Fatalf("got %s %s, want %s file://%s", msg.Method, params.TextDocument.URI, method, path)
+		}
+	}
+	if _, err := ReadMessage(reader); !errors.Is(err, io.EOF) {
+		t.Fatalf("extra document notification: %v", err)
+	}
+}
+
+type publishOnWrite struct {
+	*recordingPipe
+	publish func()
+}
+
+func (p *publishOnWrite) Write(b []byte) (int, error) {
+	if p.publish != nil {
+		publish := p.publish
+		p.publish = nil
+		publish()
+	}
+	return p.recordingPipe.Write(b)
+}
