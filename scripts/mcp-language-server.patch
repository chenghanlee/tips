+func TestSyncSkipsUnchangedButRefreshStillSends(t *testing.T) {
+	c, pipe := testClient()
+	path := filepath.Join(t.TempDir(), "sample.ex")
+	if err := os.WriteFile(path, []byte("original"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	ctx := context.Background()
+	if err := c.OpenFile(ctx, path); err != nil {
+		t.Fatal(err)
+	}
+	t.Chdir(filepath.Dir(path))
+	for range 3 {
+		if err := c.SyncFile(ctx, "sample.ex"); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if messages := syncMessages(t, pipe); len(messages) != 1 || messages[0].Method != "textDocument/didOpen" {
+		t.Fatalf("unchanged sync sent extra notifications: %v", messages)
+	}
+	for want := int32(2); want <= 3; want++ {
+		version, _, err := c.NotifyChangeVersion(ctx, path)
+		if err != nil || version != want {
+			t.Fatalf("refresh version=%d err=%v", version, err)
+		}
+		if err := c.SyncFile(ctx, path); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := os.WriteFile(path, []byte("edited"), 0600); err != nil {
+		t.Fatal(err)
+	}
