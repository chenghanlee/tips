+		_ = json.Unmarshal(msg.Params, &params)
+		if msg.Method == "textDocument/didOpen" {
+			opened = params.TextDocument.URI
+			opens++
+			continue
+		}
+		if msg.ID == nil {
+			continue
+		}
+		result := `{"contents":{"kind":"plaintext","value":"wrong document"}}`
+		valid := opens == 1 && params.TextDocument.URI == opened && strings.HasPrefix(opened, "file:///")
+		if msg.Method == "textDocument/hover" && valid {
+			result = `{"contents":{"kind":"plaintext","value":"canonical document"}}`
