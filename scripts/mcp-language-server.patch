+	}
+	defer reader.Close()
+	defer writer.Close()
+	client, _ := testClient()
+	pipe := &signaledPipe{WriteCloser: writer, started: make(chan struct{})}
+	client.stdin = pipe
+	path := filepath.Join(t.TempDir(), "large.ex")
+	if err := os.WriteFile(path, []byte(strings.Repeat("x", 1<<20)), 0600); err != nil {
+		t.Fatal(err)
+	}
+	leader, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	done := make(chan error, 1)
+	go func() { done <- client.OpenFile(leader, path) }()
+	<-pipe.started
+	for _, operation := range []string{"document", "transport"} {
+		ctx, stop := context.WithTimeout(context.Background(), 50*time.Millisecond)
+		result := make(chan error, 1)
+		go func() {
+			if operation == "document" {
+				result <- client.OpenFile(ctx, path)
+			} else {
+				result <- client.Notify(ctx, "test", nil)
+			}
+		}()
+		select {
+		case err := <-result:
+			if !errors.Is(err, context.DeadlineExceeded) {
+				t.Errorf("%s: %v", operation, err)
+			}
+		case <-time.After(time.Second):
+			t.Errorf("%s lock ignored deadline", operation)
+		}
+		stop()
+	}
+	cancel()
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.Canceled) {
+			t.Errorf("cancel write: %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Error("blocked document write ignored cancellation")
+	}
