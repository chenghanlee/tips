+// An actual LSP subprocess checks that navigation uses the latest buffer and
+// source position, even when workspace search cannot find the dependency.
+func TestDefinitionServer(t *testing.T) {
+	mode := os.Getenv("TIPS_DEFINITION_TEST_SERVER")
+	if mode == "" {
+		return
+	}
+	reader := bufio.NewReader(os.Stdin)
+	sourceURI := os.Getenv("TIPS_DEFINITION_SOURCE_URI")
+	targetURI := protocol.DocumentUri(os.Getenv("TIPS_DEFINITION_TARGET_URI"))
+	synced := false
+	referenceRequests := 0
+	for {
+		msg, err := lsp.ReadMessage(reader)
+		if err != nil {
+			os.Exit(0)
+		}
+		if msg.Method == "textDocument/didChange" {
+			var params struct {
+				TextDocument struct {
+					URI     string `json:"uri"`
+					Version int    `json:"version"`
+				} `json:"textDocument"`
+				ContentChanges []struct {
+					Text string `json:"text"`
+				} `json:"contentChanges"`
+			}
+			_ = json.Unmarshal(msg.Params, &params)
+			if params.TextDocument.URI == sourceURI {
+				expected := "# edited\nDeps.fetch()\n"
+				if mode == "empty_no_newline" {
+					expected = strings.TrimSuffix(expected, "\n")
+				}
+				synced = params.TextDocument.Version == 2 && len(params.ContentChanges) == 1 && params.ContentChanges[0].Text == expected
+			}
+		}
+		if msg.ID == nil {
+			continue
+		}
+		response := &lsp.Message{JSONRPC: "2.0", ID: msg.ID}
+		var result any
+		loc := protocol.Location{URI: targetURI, Range: protocol.Range{Start: protocol.Position{Line: 1, Character: 6}, End: protocol.Position{Line: 1, Character: 11}}}
+		switch msg.Method {
+		case "textDocument/definition":
+			var params protocol.DefinitionParams
+			_ = json.Unmarshal(msg.Params, &params)
+			if !synced || params.TextDocument.URI != protocol.DocumentUri(sourceURI) || params.Position.Line != 1 || params.Position.Character != 6 {
+				response.Error = &lsp.ResponseError{Code: -32602, Message: "wrong position or stale document"}
+			} else {
+				switch mode {
+				case "empty":
+				case "error":
+					response.Error = &lsp.ResponseError{Code: -32603, Message: "project engine unavailable"}
+				case "multiple", "multiple_long_line":
+					second := loc
+					second.Range.Start.Line = 2
+					second.Range.End.Line = 2
+					result = []protocol.Location{loc, loc, second}
+				case "links":
+					link := protocol.DefinitionLink{TargetURI: targetURI, TargetRange: protocol.Range{Start: protocol.Position{Line: 1}, End: protocol.Position{Line: 1, Character: 24}}, TargetSelectionRange: loc.Range}
+					result = []protocol.DefinitionLink{link, link}
+				default:
+					result = loc
+				}
+			}
+		case "textDocument/hover":
+			var params protocol.HoverParams
+			_ = json.Unmarshal(msg.Params, &params)
+			if !synced || params.TextDocument.URI != protocol.DocumentUri(sourceURI) || params.Position.Line != 1 || params.Position.Character != 6 {
+				response.Error = &lsp.ResponseError{Code: -32602, Message: "wrong position or stale hover document"}
+			} else if mode == "error" {
+				response.Error = &lsp.ResponseError{Code: -32603, Message: "project engine unavailable"}
+			} else if mode != "empty" && mode != "empty_no_newline" {
+				result = protocol.Hover{Contents: protocol.MarkupContent{Kind: "markdown", Value: "Fresh docs for Deps.fetch/0"}}
+			}
+		case "textDocument/references":
+			referenceRequests++
+			var params protocol.ReferenceParams
+			_ = json.Unmarshal(msg.Params, &params)
+			if referenceRequests != 1 || !synced || params.TextDocument.URI != protocol.DocumentUri(sourceURI) || params.Position.Line != 1 || params.Position.Character != 6 || params.Context.IncludeDeclaration {
+				response.Error = &lsp.ResponseError{Code: -32602, Message: "wrong context, stale document, or repeated references request"}
+			} else if mode == "error" {
+				response.Error = &lsp.ResponseError{Code: -32603, Message: "project engine unavailable"}
+			} else if mode != "empty" {
+				second := loc
+				second.Range.Start.Line = 2
+				second.Range.End.Line = 2
+				result = []protocol.Location{loc, loc, second}
+			}
+		case "textDocument/documentSymbol":
+			if mode == "large_module" || mode == "long_line" || mode == "multiple_long_line" {
+				result = []protocol.DocumentSymbol{{Name: "Deps", Kind: protocol.Module, Range: protocol.Range{Start: protocol.Position{}, End: protocol.Position{Line: 10002}}}}
+			} else if mode == "no_symbols" {
+				response.Error = &lsp.ResponseError{Code: -32601, Message: "document symbols unavailable"}
+			} else {
+				result = []protocol.DocumentSymbol{{Name: "Deps", Kind: protocol.Module, Range: protocol.Range{Start: protocol.Position{}, End: protocol.Position{Line: 3, Character: 3}}, Children: []protocol.DocumentSymbol{
+					{Name: "fetch/0", Kind: protocol.Function, Range: protocol.Range{Start: protocol.Position{Line: 1}, End: protocol.Position{Line: 1, Character: 24}}},
+					{Name: "other/0", Kind: protocol.Function, Range: protocol.Range{Start: protocol.Position{Line: 2}, End: protocol.Position{Line: 2, Character: 24}}},
+				}}}
+			}
+		default:
+			response.Error = &lsp.ResponseError{Code: -32601, Message: "unexpected request: " + msg.Method}
+		}
+		if response.Error == nil {
+			response.Result, _ = json.Marshal(result)
+		}
+		if lsp.WriteMessage(os.Stdout, response) != nil {
+			os.Exit(3)
+		}
+	}
+}
