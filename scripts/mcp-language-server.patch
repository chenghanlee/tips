+func parsePosition(arguments map[string]any) ([2]int, error) {
+	position := [2]int{}
+	for i, name := range []string{"line", "column"} {
+		var number float64
+		switch value := arguments[name].(type) {
+		case float64:
+			number = value
+		case int:
+			number = float64(value)
+		default:
+			return position, fmt.Errorf("%s must be a positive integer", name)
+		}
+		if math.IsNaN(number) || number < 1 || number > math.MaxUint32 || number != math.Trunc(number) {
+			return position, fmt.Errorf("%s must be a positive integer within the LSP position range", name)
+		}
+		position[i] = int(number)
+	}
+	return position, nil
+}
