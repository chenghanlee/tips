+package tools
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"github.com/isaacphi/mcp-language-server/internal/lsp"
+	"github.com/isaacphi/mcp-language-server/internal/protocol"
+)
+
+// ReadDefinitionAt navigates from a call site in the source file's project.
+// Positions are 1-based; columns use LSP's default UTF-16 encoding, as hover does.
+func ReadDefinitionAt(ctx context.Context, client *lsp.Client, filePath string, line, column int) (string, error) {
+	ctx, cancel := context.WithTimeout(ctx, toolTimeout)
+	defer cancel()
+	position, err := navigationPosition(ctx, client, filePath, line, column)
+	if err != nil {
+		return "", err
+	}
+	for {
+		started := time.Now()
+		result, err := client.Definition(ctx, protocol.DefinitionParams{TextDocumentPositionParams: position})
+		if err != nil {
+			return "", fmt.Errorf("definition request failed: %w", err)
+		}
+		var locations []protocol.Location
+		switch value := result.Value.(type) {
+		case protocol.Definition:
+			switch definition := value.Value.(type) {
+			case protocol.Location:
+				locations = []protocol.Location{definition}
+			case []protocol.Location:
+				locations = definition
+			}
+		case []protocol.DefinitionLink:
+			for _, link := range value {
+				locations = append(locations, protocol.Location{URI: link.TargetURI, Range: link.TargetSelectionRange})
+			}
+		}
+		if len(locations) == 0 {
+			retry, err := client.RetryLoading(ctx, filePath, started)
+			if err != nil {
+				return "", err
+			}
+			if retry {
+				continue
+			}
+			return fmt.Sprintf("No definition returned for %s at L%d:C%d. The project may still be loading, or the symbol/source may be unavailable; this does not prove the symbol is absent.", filePath, line, column) + client.ProjectStatus(filePath), nil
+		}
+		return formatNavigationLocations(locations, true), nil
+	}
+}
