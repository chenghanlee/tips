+package tools
+
+import (
+	"context"
+	"fmt"
+	"math"
+	"net/url"
+	"os"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/isaacphi/mcp-language-server/internal/lsp"
+	"github.com/isaacphi/mcp-language-server/internal/protocol"
+)
+
+// Synchronize the caller's document, preserving the context used for project selection.
+func navigationPosition(ctx context.Context, client *lsp.Client, filePath string, line, column int) (protocol.TextDocumentPositionParams, error) {
+	var params protocol.TextDocumentPositionParams
+	if line < 1 || column < 1 || uint64(line) > math.MaxUint32 || uint64(column) > math.MaxUint32 {
+		return params, fmt.Errorf("line and column must be positive integers no greater than %d", uint64(math.MaxUint32))
+	}
+	uri, err := lsp.FileURI(filePath)
+	if err != nil {
+		return params, err
+	}
+	if err := client.OpenFile(ctx, filePath); err != nil {
+		return params, fmt.Errorf("could not open file: %w", err)
+	}
+	if err := client.SyncFile(ctx, filePath); err != nil {
+		return params, fmt.Errorf("could not synchronize file: %w", err)
+	}
+	return protocol.TextDocumentPositionParams{
+		TextDocument: protocol.TextDocumentIdentifier{URI: protocol.DocumentUri(uri)},
+		Position:     protocol.Position{Line: uint32(line - 1), Character: uint32(column - 1)},
+	}, nil
+}
+
+// Locations remain useful even when source is missing or preview space runs out.
+// Reading previews directly avoids starting another project engine for dependencies.
+func formatNavigationLocations(locations []protocol.Location, preview bool) string {
+	var output strings.Builder
+	seen := make(map[protocol.Location]bool)
+	budget := 8 * 1024
+	for _, loc := range locations {
+		if seen[loc] {
+			continue
+		}
+		seen[loc] = true
+		target := string(loc.URI)
+		parsed, err := url.Parse(target)
+		local := err == nil && parsed.Scheme == "file" && (parsed.Host == "" || parsed.Host == "localhost")
+		if local {
+			target = parsed.Path
+		}
+		fmt.Fprintf(&output, "---\n\nFile: %s\nRange: L%d:C%d - L%d:C%d\n", target, loc.Range.Start.Line+1, loc.Range.Start.Character+1, loc.Range.End.Line+1, loc.Range.End.Character+1)
+		if !preview {
+			continue
+		}
+		if !local {
+			output.WriteString("Source excerpt unavailable for this URI.\n")
+			continue
+		}
+		if budget == 0 {
+			output.WriteString("Source preview omitted: response preview budget exhausted.\n")
+			continue
+		}
+		content, err := os.ReadFile(target)
+		if err != nil {
+			fmt.Fprintf(&output, "Source excerpt unavailable: %v\n", err)
+			continue
+		}
+		lines := strings.Split(string(content), "\n")
+		start := int(loc.Range.Start.Line)
+		if start >= len(lines) {
+			output.WriteString("Source excerpt unavailable: target line is outside the file.\n")
+			continue
+		}
+		end := min(start+40, len(lines))
+		excerpt := addLineNumbers(strings.Join(lines[start:end], "\n"), start+1)
+		truncated := end < len(lines) || len(excerpt) > budget
+		if len(excerpt) > budget {
+			excerpt = excerpt[:budget]
+			for !utf8.ValidString(excerpt) {
+				excerpt = excerpt[:len(excerpt)-1]
+			}
+			budget = 0
+		} else {
+			budget -= len(excerpt)
+		}
+		fmt.Fprintf(&output, "\nSource preview (up to 40 lines; may include neighboring code):\n\n%s\n", excerpt)
+		if truncated {
+			output.WriteString("Preview truncated; read the file at the location above for more.\n")
+		}
+	}
+	return output.String()
+}
