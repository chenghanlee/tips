+package tools
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/isaacphi/mcp-language-server/internal/protocol"
+)
+
+func TestReferencePosition(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "live_acceptance.ex")
+	src := "defmodule TipsWeb.LiveAcceptance do\n" +
+		"  def on_mount(_, _, _, socket), do: {:cont, socket}\n" +
+		"  def register_user(attrs), do: attrs\n" +
+		"end\n" +
+		"int Foo::bar() {\n"
+	if err := os.WriteFile(path, []byte(src), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	cases := []struct {
+		name  string
+		start protocol.Position
+		sym   string
+		want  uint32
+	}{
+		{"qualified module → last segment", protocol.Position{Line: 0}, "TipsWeb.LiveAcceptance", 18},
+		{"unqualified name → itself", protocol.Position{Line: 1, Character: 2}, "on_mount", 6},
+		{"qualified function absent → last segment fallback", protocol.Position{Line: 2, Character: 2}, "Accounts.register_user", 6},
+		{"identifier boundary: 'user' inside 'register_user' is not a match", protocol.Position{Line: 2, Character: 2}, "user", 2},
+		{"C++ qualified function → last segment", protocol.Position{Line: 4}, "Foo::bar", 9},
+		{"C++ qualified function absent → last segment fallback", protocol.Position{Line: 4}, "Other::bar", 9},
+		{"absent → unchanged", protocol.Position{Line: 3}, "Missing", 0},
+	}
+	for _, c := range cases {
+		got := referencePosition(path, c.start, c.sym)
+		if got.Line != c.start.Line || got.Character != c.want {
+			t.Errorf("%s: got %+v, want character %d", c.name, got, c.want)
+		}
+	}
+}
+
+func TestSymbolBaseName(t *testing.T) {
+	cases := map[string]string{
+		"Tips.Accounts.register_user/1": "Tips.Accounts.register_user",
+		"TipsWeb.LiveAcceptance":        "TipsWeb.LiveAcceptance",
+		"path/to/thing":                 "path/to/thing",
+		"weird/":                        "weird/",
+	}
+	for in, want := range cases {
+		if got := symbolBaseName(in); got != want {
+			t.Errorf("%q: got %q, want %q", in, got, want)
+		}
+	}
+}
+
+func TestSymbolMatches(t *testing.T) {
+	sym := func(name string) protocol.WorkspaceSymbolResult {
+		return &protocol.SymbolInformation{Name: name}
+	}
+	cases := []struct {
+		symbol, query string
+		want          bool
+	}{
+		{"Tips.Accounts.register_user/1", "register_user", true},
+		{"Tips.Accounts.register_user/1", "Tips.Accounts.register_user", true},
+		{"Tips.Accounts.register_user/1", "Accounts.register_user", true},
+		{"Other.Accounts.register_user/1", "Accounts.register_user", true},
+		{"Tips.Accounts.register_user/1", "Web.Accounts.register_user", false},
+		{"TipsWeb.LiveAcceptance", "TipsWeb.LiveAcceptance", true},
+		{"TipsWeb", "TipsWeb.LiveAcceptance", false},
+		{"register_user", "Tips.Accounts.register_user", true},
+		{"Foo::bar", "bar", true},
+		{"bar", "Foo::bar", true},
+		{"Outer::Foo::bar", "Foo::bar", true},
+		{"Other::bar", "Foo::bar", false},
+		{"unregister_user/1", "register_user", false},
+	}
+	for _, c := range cases {
+		if got := symbolMatches(sym(c.symbol), c.query); got != c.want {
+			t.Errorf("symbolMatches(%q, %q) = %v, want %v", c.symbol, c.query, got, c.want)
+		}
+	}
+}
