+func TestExpertColdFirstCalls(t *testing.T) {
+	for _, tool := range []struct {
+		name string
+		run  func(context.Context, *lsp.Client, string, int, int) (string, error)
+	}{{"definition", ReadDefinitionAt}, {"references", FindReferencesAt}, {"hover", GetHoverInfo}} {
+		t.Run(tool.name, func(t *testing.T) {
+			client, path := startupClient(t, "cold")
+			ctx, cancel := context.WithTimeout(context.Background(), 21*time.Second)
+			defer cancel()
+			result, err := tool.run(ctx, client, path, 1, 2)
+			if err != nil || (!strings.Contains(result, "File:") && result != "ready") {
+				t.Fatalf("cold first call: %q, %v", result, err)
+			}
+		})
+	}
+	t.Run("diagnostics", func(t *testing.T) {
+		client, path := startupClient(t, "cold")
+		ctx, cancel := context.WithTimeout(context.Background(), 21*time.Second)
+		defer cancel()
+		result, err := GetDiagnosticsForFile(ctx, client, path, 0, false)
+		if err != nil || !strings.Contains(result, "Diagnostics in File: 0") || !strings.Contains(result, "version not supplied") {
+			t.Fatalf("cold diagnostics: %q, %v", result, err)
+		}
+	})
+}
