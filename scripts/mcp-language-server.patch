+// A real framed LSP subprocess models Expert's ignored cold lookups, skipped
+// cold changes, unversioned publications and loading notices. No Expert install required.
+func TestExpertStartupServer(t *testing.T) {
+	mode := os.Getenv("TIPS_STARTUP_SERVER")
+	if mode == "" {
+		return
+	}
+	var mu sync.Mutex
+	send := func(msg *lsp.Message) {
+		mu.Lock()
+		defer mu.Unlock()
+		if lsp.WriteMessage(os.Stdout, msg) != nil {
+			os.Exit(2)
+		}
+	}
+	log := func(s string) {
+		raw, _ := json.Marshal(map[string]any{"type": 3, "message": s})
+		send(&lsp.Message{JSONRPC: "2.0", Method: "window/logMessage", Params: raw})
+	}
+	var stateMu sync.Mutex
+	compiled := map[string]bool{}
+	requests := map[string]int{}
+	reader := bufio.NewReader(os.Stdin)
+	for {
+		msg, err := lsp.ReadMessage(reader)
+		if err != nil {
+			os.Exit(0)
+		}
+		var p struct {
+			RootURI      string `json:"rootUri"`
+			TextDocument struct {
+				URI string `json:"uri"`
+			} `json:"textDocument"`
+		}
+		_ = json.Unmarshal(msg.Params, &p)
+		root := filepath.Dir(strings.TrimPrefix(p.TextDocument.URI, "file://"))
+		name := filepath.Base(root)
+		switch msg.Method {
+		case "initialize":
+			if mode == "early" || mode == "endless" || mode == "late" || mode == "empty-log" {
+				name = filepath.Base(strings.TrimPrefix(p.RootURI, "file://"))
+				stateMu.Lock()
+				compiled[name] = true
+				stateMu.Unlock()
+				log("Compiled " + name + " in 0.1 seconds")
+			}
+			send(&lsp.Message{JSONRPC: "2.0", ID: msg.ID, Result: json.RawMessage(`{"capabilities":{}}`)})
+		case "test/lateLoading":
+			log("Search index is loading for " + name + "...")
+			send(&lsp.Message{JSONRPC: "2.0", ID: msg.ID, Result: json.RawMessage(`null`)})
+		case "textDocument/didOpen":
+			if mode == "missing" || mode == "stall" || mode == "early" || mode == "endless" || mode == "late" || mode == "empty-log" || strings.HasPrefix(mode, "typed") || strings.HasPrefix(mode, "failure-") {
+				continue
+			}
+			go func(name string) {
+				delay := 80 * time.Millisecond
+				if name == "slow" {
+					delay = 250 * time.Millisecond
+				}
+				time.Sleep(delay)
+				stateMu.Lock()
+				compiled[name] = true
+				stateMu.Unlock()
+				log("Compiled " + name + " in 0.08 seconds")
+			}(name)
+		case "textDocument/didChange":
+			stateMu.Lock()
+			ready := compiled[name]
+			stateMu.Unlock()
+			if ready {
+				raw, _ := json.Marshal(map[string]any{"uri": p.TextDocument.URI, "diagnostics": []any{}})
+				send(&lsp.Message{JSONRPC: "2.0", Method: "textDocument/publishDiagnostics", Params: raw})
+			}
+		case "textDocument/definition", "textDocument/references", "textDocument/hover":
+			if mode == "stall" {
+				continue
+			}
+			stateMu.Lock()
+			ready := compiled[name]
+			requests[name]++
+			n := requests[name]
+			stateMu.Unlock()
+			if msg.Method == "textDocument/references" {
+				reason := ""
+				if !ready || ((mode == "loading" || mode == "typed" || mode == "typed-late") && n <= 2) || mode == "endless" {
+					reason = "index_not_ready"
+				}
+				if strings.HasPrefix(mode, "failure-") {
+					reason = strings.TrimPrefix(mode, "failure-")
+				}
+				if mode == "typed" || mode == "typed-late" {
+					if n > 2 {
+						reason = ""
+						ready = true
+					}
+				}
+				if reason != "" {
+					data, _ := json.Marshal(map[string]any{"reason": reason, "detail": "retained detail"})
+					send(&lsp.Message{JSONRPC: "2.0", ID: msg.ID, Error: &lsp.ResponseError{Code: -32803, Message: reason, Data: data}})
+					if mode == "typed-late" {
+						log("Search index is loading for " + name + "...")
+					}
+					continue
+				}
+			}
+			var result any
+			if msg.Method == "textDocument/references" {
+				result = []protocol.Location{}
+			}
+			if mode == "empty-log" {
+				log("Search index is loading for " + name + "...")
+			}
+			if ready && ((mode == "loading" && n == 1) || mode == "endless") {
+				log("Search index is loading for " + name + "...")
+			} else if ready && mode != "early" && mode != "late" && mode != "empty-log" {
+				loc := protocol.Location{URI: protocol.DocumentUri(p.TextDocument.URI), Range: protocol.Range{Start: protocol.Position{Line: 0}, End: protocol.Position{Line: 0, Character: 3}}}
+				switch msg.Method {
+				case "textDocument/definition":
+					result = loc
+				case "textDocument/references":
+					result = []protocol.Location{loc}
+				case "textDocument/hover":
+					result = protocol.Hover{Contents: protocol.MarkupContent{Kind: "plaintext", Value: "ready"}}
+				}
+			}
+			raw, _ := json.Marshal(result)
+			send(&lsp.Message{JSONRPC: "2.0", ID: msg.ID, Result: raw})
+		}
+	}
+}
