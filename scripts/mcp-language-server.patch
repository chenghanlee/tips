+package tools
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/isaacphi/mcp-language-server/internal/lsp"
+)
+
+// A subprocess mock verifies the document identity actually sent on the wire.
+func TestRelativePathServer(t *testing.T) {
+	if os.Getenv("ASTRA_URI_TEST_SERVER") != "1" {
+		return
+	}
+	reader := bufio.NewReader(os.Stdin)
+	opened := ""
+	opens := 0
+	for {
+		msg, err := lsp.ReadMessage(reader)
+		if err != nil {
+			os.Exit(0)
+		}
+		var params struct {
+			TextDocument struct {
+				URI string `json:"uri"`
+			} `json:"textDocument"`
+		}
+		_ = json.Unmarshal(msg.Params, &params)
+		if msg.Method == "textDocument/didOpen" {
+			opened = params.TextDocument.URI
+			opens++
+			continue
+		}
+		if msg.ID == nil {
+			continue
+		}
+		result := `{"contents":{"kind":"plaintext","value":"wrong document"}}`
+		valid := opens == 1 && params.TextDocument.URI == opened && strings.HasPrefix(opened, "file:///")
+		if msg.Method == "textDocument/hover" && valid {
+			result = `{"contents":{"kind":"plaintext","value":"canonical document"}}`
+		}
+		if msg.Method == "textDocument/codeLens" {
+			if !valid {
+				os.Exit(2)
+			}
+			result = `[{"range":{"start":{"line":0,"character":0},"end":{"line":0,"character":1}},"command":{"title":"canonical lens","command":"test.lens"}}]`
+		}
+		if msg.Method == "workspace/executeCommand" {
+			result = `null`
+		}
+		if msg.Method == "textDocument/rename" {
+			if !valid {
+				os.Exit(2)
+			}
+			result = `{"changes":{}}`
+		}
+		if err := lsp.WriteMessage(os.Stdout, &lsp.Message{JSONRPC: "2.0", ID: msg.ID, Result: json.RawMessage(result)}); err != nil {
+			os.Exit(3)
+		}
+	}
+}
+
+func TestRelativeToolsUseOneAbsoluteDocument(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "sample #1.ex")
+	if err := os.WriteFile(path, []byte("sample\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	t.Chdir(filepath.Dir(path))
+	relative := "sample #1.ex"
+	t.Setenv("ASTRA_URI_TEST_SERVER", "1")
+	client, err := lsp.NewClient(os.Args[0], "-test.run=^TestRelativePathServer$")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = client.Cmd.Process.Kill(); _ = client.Cmd.Wait() }()
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	if err := client.OpenFile(ctx, path); err != nil {
+		t.Fatal(err)
+	}
+	hover, err := GetHoverInfo(ctx, client, relative, 1, 1)
+	if err != nil || hover != "canonical document" {
+		t.Fatalf("hover=%q err=%v", hover, err)
+	}
+	lenses, err := GetCodeLens(ctx, client, relative)
+	if err != nil || !strings.Contains(lenses, "canonical lens") {
+		t.Fatalf("code lenses=%q err=%v", lenses, err)
+	}
+	if _, err := ExecuteCodeLens(ctx, client, relative, 1); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := RenameSymbol(ctx, client, relative, 1, 1, "renamed"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := ApplyTextEdits(ctx, client, relative, []TextEdit{{StartLine: 1, EndLine: 1, NewText: "edited"}}); err != nil {
+		t.Fatal(err)
+	}
+	content, err := os.ReadFile(path)
+	if err != nil || string(content) != "edited\n" {
+		t.Fatalf("edit=%q err=%v", content, err)
+	}
+}
