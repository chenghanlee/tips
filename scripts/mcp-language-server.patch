+	if _, _, err := c.NotifyChangeVersion(ctx, path); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.SyncFile(ctx, path); err != nil {
+		t.Fatal(err)
+	}
+	messages := syncMessages(t, pipe)
+	if len(messages) != 4 {
+		t.Fatalf("got %d messages, want 4", len(messages))
+	}
