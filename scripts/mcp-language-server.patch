+package lsp
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+)
+
+// Expert 0.1.10's log messages are hints, not a readiness protocol. Compilation
+// can fail and indexing can still be loading after a compile notice. This small
+// adapter only recovers cold calls; it never certifies empty results as complete.
+type expertProject struct {
+	compiled      bool
+	waitAttempted bool
+	waiting       bool
+	lastLoading   time.Time
+}
+
+type expertStartup struct {
+	mu       sync.Mutex
+	projects map[string]*expertProject
+	changed  chan struct{}
+}
+
+func (e *expertStartup) project(name string) *expertProject {
+	if e.projects[name] == nil {
+		e.projects[name] = &expertProject{}
+	}
+	return e.projects[name]
+}
+
+func (e *expertStartup) signal() { close(e.changed); e.changed = make(chan struct{}) }
+
+func (e *expertStartup) observe(raw json.RawMessage) {
+	var event struct {
+		Message string `json:"message"`
+	}
+	if json.Unmarshal(raw, &event) != nil {
+		return
+	}
+	message := strings.TrimSpace(event.Message)
+	// Expert may prepend project metadata to the otherwise identical log text.
+	if strings.HasPrefix(message, "[") {
+		if i := strings.Index(message, "] "); i >= 0 {
+			message = message[i+2:]
+		}
+	}
+	var name string
+	compiled := false
+	if tail, ok := strings.CutPrefix(message, "Compiled "); ok {
+		if i := strings.LastIndex(tail, " in "); i > 0 {
+			name = tail[:i]
+			compiled = true
+		}
+	} else if tail, ok := strings.CutPrefix(message, "Search index is loading for "); ok {
+		name = strings.TrimSuffix(tail, "...")
+	}
+	if name == "" {
+		return
+	}
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	p := e.project(name)
+	if compiled {
+		p.compiled = true
+	} else {
+		p.lastLoading = time.Now()
+	}
+	e.signal()
+}
+
+// Expert routes to the closest Mix project. The log only identifies its folder
+// name, so same-basename projects in one server remain outside this MVP's scope.
+func expertProjectName(path string) string {
+	absolute, err := filepath.Abs(path)
+	if err != nil {
+		return ""
+	}
+	for dir := filepath.Dir(absolute); ; dir = filepath.Dir(dir) {
+		if info, err := os.Stat(filepath.Join(dir, "mix.exs")); err == nil && !info.IsDir() {
+			return filepath.Base(dir)
+		}
+		if filepath.Dir(dir) == dir {
+			return ""
+		}
+	}
+}
+
+// WaitForProject is called after didOpen, which triggers lazy project startup.
+// One attempt per project/session; concurrent callers share it. Leave 20 seconds
+// for the operation and diagnostics publication inside the overall tool budget.
+func (c *Client) WaitForProject(ctx context.Context, path string) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if c.expert == nil {
+		return nil
+	}
+	name := expertProjectName(path)
+	if name == "" {
+		return nil
+	}
+	deadline, ok := ctx.Deadline()
+	if !ok {
+		return fmt.Errorf("Expert startup wait requires a bounded tool context")
+	}
+	remaining := time.Until(deadline.Add(-20 * time.Second))
+	if remaining <= 0 {
+		return ctx.Err()
+	}
+	e := c.expert
+	e.mu.Lock()
+	p := e.project(name)
+	if p.compiled || (p.waitAttempted && !p.waiting) {
+		e.mu.Unlock()
+		return nil
+	}
+	leader := !p.waitAttempted
+	if leader {
+		p.waitAttempted = true
+		p.waiting = true
+	}
+	e.mu.Unlock()
+	if leader {
+		defer func() { e.mu.Lock(); p.waiting = false; e.signal(); e.mu.Unlock() }()
+	}
+	timer := time.NewTimer(remaining)
+	defer timer.Stop()
+	for {
+		e.mu.Lock()
+		done := p.compiled || !p.waiting
+		changed := e.changed
+		e.mu.Unlock()
+		if done {
+			return nil
+		}
+		select {
+		case <-changed:
+		case <-timer.C:
+			return ctx.Err()
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-c.closed:
+			return fmt.Errorf("language server closed during project startup")
+		}
+	}
+}
+
+// RetryLoading only retries after evidence emitted since this request began.
+// A missing/late notice is not proof of readiness. Retain uncertainty on empty.
+func (c *Client) RetryLoading(ctx context.Context, path string, since time.Time) (bool, error) {
+	if err := ctx.Err(); err != nil {
+		return false, err
+	}
+	if c.expert == nil {
+		return false, nil
+	}
+	name := expertProjectName(path)
+	if name == "" {
+		return false, nil
+	}
+	e := c.expert
+	e.mu.Lock()
+	loading := e.project(name).lastLoading.After(since)
+	e.mu.Unlock()
+	if !loading {
+		return false, nil
+	}
+	timer := time.NewTimer(IndexRetryDelay)
+	defer timer.Stop()
+	select {
+	case <-timer.C:
+		return true, nil
+	case <-ctx.Done():
+		return false, ctx.Err()
+	case <-c.closed:
+		return false, fmt.Errorf("language server closed while search index was loading")
+	}
+}
+
+func (c *Client) ProjectStatus(path string) string {
+	if c.expert == nil {
+		return ""
+	}
+	name := expertProjectName(path)
+	if name == "" {
+		return ""
+	}
+	e := c.expert
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	p := e.project(name)
+	status := "Expert startup unconfirmed."
+	if p.compiled {
+		status = "Expert project compilation observed; index readiness unconfirmed."
+	}
+	if !p.lastLoading.IsZero() {
+		status += " Search index loading was observed."
+	}
+	return "\n" + status
+}
+
+// ShouldOpenFile limits automatic document opens, not filesystem notifications.
+// Expert still needs asset/config change events but cannot analyze those as Elixir.
+func (c *Client) ShouldOpenFile(path string) bool {
+	if c.expert == nil {
+		return true
+	}
+	switch filepath.Ext(path) {
+	case ".ex", ".exs", ".eex", ".heex", ".leex":
+		return true
+	default:
+		return false
+	}
+}
+
+// IndexRetryDelay is shared by the legacy definition adapter and typed references.
+const IndexRetryDelay = 2 * time.Second
