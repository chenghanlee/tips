+func TestDefinitionAtNavigatesWithoutWorkspaceSearch(t *testing.T) {
+	for _, mode := range []string{"single", "multiple", "links", "no_symbols", "missing_source", "empty", "error", "large_module", "long_line", "multiple_long_line"} {
+		t.Run(mode, func(t *testing.T) {
+			dir := t.TempDir()
+			source := filepath.Join(dir, "call.ex")
+			target := filepath.Join(dir, "dependency #1.ex")
+			if err := os.WriteFile(source, []byte("# old\nOld.fetch()\n"), 0600); err != nil {
+				t.Fatal(err)
+			}
+			if mode != "missing_source" {
+				content := "defmodule Deps do\n  def fetch(), do: :fresh\n  def other(), do: :other\nend\n"
+				if mode == "large_module" {
+					content = "defmodule Deps do\n  def fetch(), do: :fresh\n" + strings.Repeat("# unrelated module content\n", 10000) + "end\n"
+				}
+				if mode == "long_line" || mode == "multiple_long_line" {
+					content = "defmodule Deps do\n  def fetch(), do: :fresh # " + strings.Repeat("😀", 10000) + "\n" + strings.Repeat("# context\n", 10000) + "end\n"
+				}
+				if err := os.WriteFile(target, []byte(content), 0600); err != nil {
+					t.Fatal(err)
+				}
+			}
+			uri, _ := lsp.FileURI(source)
+			t.Setenv("TIPS_DEFINITION_TEST_SERVER", mode)
+			t.Setenv("TIPS_DEFINITION_SOURCE_URI", uri)
+			t.Setenv("TIPS_DEFINITION_TARGET_URI", string(protocol.URIFromPath(target)))
+			client, err := lsp.NewClient(os.Args[0], "-test.run=^TestDefinitionServer$")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer func() { _ = client.Cmd.Process.Kill(); _ = client.Cmd.Wait() }()
+			ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+			defer cancel()
+			if err := client.OpenFile(ctx, source); err != nil {
+				t.Fatal(err)
+			}
+			if err := os.WriteFile(source, []byte("# edited\nDeps.fetch()\n"), 0600); err != nil {
+				t.Fatal(err)
+			}
+			t.Chdir(dir)
+			output, err := ReadDefinitionAt(ctx, client, "call.ex", 2, 7)
+			if mode == "error" {
+				if err == nil || !strings.Contains(err.Error(), "project engine unavailable") {
+					t.Fatalf("output=%q err=%v", output, err)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if mode == "empty" {
+				if !strings.Contains(output, "No definition returned") {
+					t.Fatalf("output=%q", output)
+				}
+				return
+			}
+			if len(output) > 9000 || !utf8.ValidString(output) {
+				t.Fatalf("unbounded or invalid UTF-8 output: %d bytes", len(output))
+			}
+			if mode == "multiple_long_line" && !strings.Contains(output, "preview budget exhausted") {
+				t.Fatalf("missing preview budget notice: %s", output)
+			}
+			wantLocations := 1
+			if mode == "multiple" || mode == "multiple_long_line" {
+				wantLocations = 2
+			}
+			if strings.Count(output, "File: "+target+"\n") != wantLocations {
+				t.Fatalf("locations not preserved/deduplicated: %s", output)
+			}
+			if !strings.Contains(output, "L2:C7") {
+				t.Fatalf("missing original selection: %s", output)
+			}
+			if mode == "missing_source" {
+				if !strings.Contains(output, "Source excerpt unavailable") {
+					t.Fatalf("missing extraction failure: %s", output)
+				}
+			} else {
+				if !strings.Contains(output, "Source preview") {
+					t.Fatalf("context not labeled: %s", output)
+				}
+				if !strings.Contains(output, "def fetch(), do: :fresh") || strings.Contains(output, "defmodule Deps") {
+					t.Fatalf("wrong source excerpt: %s", output)
+				}
+			}
+		})
+	}
