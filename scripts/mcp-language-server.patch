+package tools
+
+import (
+	"bufio"
+	"context"
+	"fmt"
+	"os"
+	"strings"
+
+	"github.com/isaacphi/mcp-language-server/internal/lsp"
+	"github.com/isaacphi/mcp-language-server/internal/protocol"
+)
+
+// referencePosition returns the position to use for a references request on
+// a symbol found by workspace/symbol. Servers report the range of the whole
+// declaration, whose start often precedes the name or sits on the first
+// segment of a qualified name (for example "TipsWeb" in
+// "defmodule TipsWeb.LiveAcceptance"). Querying there resolves the wrong
+// symbol. This moves the cursor onto the last segment of symbolName when the
+// full name, or failing that the last segment alone, appears as a whole
+// identifier on the range's first line. Otherwise it returns start unchanged.
+func referencePosition(path string, start protocol.Position, symbolName string) protocol.Position {
+	line, ok := readLine(path, int(start.Line))
+	if !ok {
+		return start
+	}
+	segment := lastSegment(symbolName)
+	if idx := indexIdentifier(line, symbolName); idx >= 0 {
+		return protocol.Position{Line: start.Line, Character: uint32(idx + len(symbolName) - len(segment))}
+	}
+	if idx := indexIdentifier(line, segment); idx >= 0 {
+		return protocol.Position{Line: start.Line, Character: uint32(idx)}
+	}
+	return start
+}
+
+// indexIdentifier finds name in line as a whole identifier: the bytes on
+// either side must not be identifier characters.
+func indexIdentifier(line, name string) int {
+	from := 0
+	for {
+		i := strings.Index(line[from:], name)
+		if i < 0 {
+			return -1
+		}
+		idx := from + i
+		end := idx + len(name)
+		if (idx == 0 || !isIdent(line[idx-1])) && (end == len(line) || !isIdent(line[end])) {
+			return idx
+		}
+		from = idx + 1
+	}
+}
+
+func isIdent(b byte) bool {
+	return b == '_' || b == '?' || b == '!' ||
+		(b >= '0' && b <= '9') || (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z')
+}
+
+func readLine(path string, n int) (string, bool) {
+	f, err := os.Open(path)
+	if err != nil {
+		return "", false
+	}
+	defer f.Close()
+	scanner := bufio.NewScanner(f)
+	scanner.Buffer(make([]byte, 0, 64*1024), 1024*1024)
+	for i := 0; scanner.Scan(); i++ {
+		if i == n {
+			return scanner.Text(), true
+		}
+	}
+	return "", false
+}
+
+// symbolBaseName strips an Elixir/Erlang arity suffix ("/1") from a
+// workspace symbol name so "Tips.Accounts.register_user/1" matches a query
+// for "Tips.Accounts.register_user" or "register_user".
+func symbolBaseName(name string) string {
+	slash := strings.LastIndex(name, "/")
+	if slash < 0 || slash == len(name)-1 {
+		return name
+	}
+	for _, b := range []byte(name[slash+1:]) {
+		if b < '0' || b > '9' {
+			return name
+		}
+	}
+	return name[:slash]
+}
+
+// lastSegment returns the bare name for dotted and C++ qualified symbols.
+func lastSegment(name string) string {
+	start := strings.LastIndex(name, ".") + 1
+	if colon := strings.LastIndex(name, "::"); colon >= 0 && colon+2 > start {
+		start = colon + 2
+	}
+	return name[start:]
+}
+
+// symbolMatches reports whether a workspace symbol answers a query for
+// symbolName. The symbol's arity suffix is ignored. A qualified query
+// ("Mod.fun") matches the same qualified name, a longer name ending in
+// ".Mod.fun", or a bare "fun" for servers that report unqualified names. An unqualified query ("fun") matches "fun"
+// or any qualified name ending in ".fun" or "::fun".
+func symbolMatches(symbol protocol.WorkspaceSymbolResult, symbolName string) bool {
+	name := symbolBaseName(symbol.GetName())
+	if name == symbolName {
+		return true
+	}
+	if segment := lastSegment(symbolName); segment != symbolName && name == segment {
+		return true
+	}
+	return strings.HasSuffix(name, "."+symbolName) || strings.HasSuffix(name, "::"+symbolName)
+}
+
+// lookupSymbols queries workspace/symbol for symbolName. Some servers index
+// functions by bare name only and return nothing for a qualified query, so
+// on an empty result for "Mod.fun" it retries with "fun"; callers filter the
+// wider result with symbolMatches.
+func lookupSymbols(ctx context.Context, client *lsp.Client, symbolName string) ([]protocol.WorkspaceSymbolResult, error) {
+	results, err := querySymbols(ctx, client, symbolName)
+	if err != nil || len(results) > 0 {
+		return results, err
+	}
+	if dot := strings.LastIndex(symbolName, "."); dot >= 0 {
+		return querySymbols(ctx, client, symbolName[dot+1:])
+	}
+	return results, nil
+}
+
+func querySymbols(ctx context.Context, client *lsp.Client, query string) ([]protocol.WorkspaceSymbolResult, error) {
+	symbolResult, err := client.Symbol(ctx, protocol.WorkspaceSymbolParams{Query: query})
+	if err != nil {
+		return nil, fmt.Errorf("failed to fetch symbol: %v", err)
+	}
+	results, err := symbolResult.Results()
+	if err != nil {
+		return nil, fmt.Errorf("failed to parse results: %v", err)
+	}
+	return results, nil
+}
