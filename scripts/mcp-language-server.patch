+func TestExpertStoppedServerHonorsShorterDeadline(t *testing.T) {
+	client, path := startupClient(t, "stall")
+	ctx, cancel := context.WithTimeout(context.Background(), 100*time.Millisecond)
+	defer cancel()
+	start := time.Now()
+	_, err := ReadDefinitionAt(ctx, client, path, 1, 2)
+	if err == nil || !strings.Contains(err.Error(), "deadline") {
+		t.Fatalf("wanted deadline, got %v", err)
+	}
+	if time.Since(start) > time.Second {
+		t.Fatal("did not respect caller deadline")
+	}
