+	"github.com/isaacphi/mcp-language-server/internal/protocol"
+)
+
+// Reject redundant updates and navigation requests against stale document text.
+func TestNavigationSyncServer(t *testing.T) {
+	if os.Getenv("TIPS_SYNC_SERVER") != "1" {
+		t.Skip("subprocess fixture")
+	}
+	reader := bufio.NewReader(os.Stdin)
+	var current, uri string
+	redundant := false
+	for {
+		msg, err := lsp.ReadMessage(reader)
+		if err != nil {
+			os.Exit(0)
+		}
+		var params struct {
+			TextDocument struct {
+				URI  string `json:"uri"`
+				Text string `json:"text"`
+			} `json:"textDocument"`
+			ContentChanges []struct {
+				Text string `json:"text"`
+			} `json:"contentChanges"`
+		}
+		if err := json.Unmarshal(msg.Params, &params); err != nil {
+			os.Exit(2)
+		}
+		switch msg.Method {
+		case "textDocument/didOpen":
+			uri, current = params.TextDocument.URI, params.TextDocument.Text
+		case "textDocument/didChange":
+			if len(params.ContentChanges) != 1 {
+				os.Exit(3)
+			}
+			text := params.ContentChanges[0].Text
+			redundant = redundant || text == current
+			current = text
+		}
+		if msg.ID == nil {
+			continue
+		}
+		response := &lsp.Message{JSONRPC: "2.0", ID: msg.ID}
+		disk, err := os.ReadFile(strings.TrimPrefix(uri, "file://"))
+		if redundant {
+			response.Error = &lsp.ResponseError{Code: -32603, Message: "redundant didChange"}
+		} else if err != nil || string(disk) != current || params.TextDocument.URI != uri {
+			response.Error = &lsp.ResponseError{Code: -32603, Message: "stale navigation document"}
+		} else {
+			loc := protocol.Location{URI: protocol.DocumentUri(uri), Range: protocol.Range{Start: protocol.Position{Line: 1}, End: protocol.Position{Line: 1, Character: 5}}}
+			switch msg.Method {
+			case "textDocument/hover":
+				response.Result, _ = json.Marshal(protocol.Hover{Contents: protocol.MarkupContent{Kind: "plaintext", Value: current}})
+			case "textDocument/definition":
+				response.Result, _ = json.Marshal(loc)
+			case "textDocument/references":
+				response.Result, _ = json.Marshal([]protocol.Location{loc})
+			default:
+				response.Error = &lsp.ResponseError{Code: -32601, Message: "unexpected request"}
+			}
+		}
+		if lsp.WriteMessage(os.Stdout, response) != nil {
+			os.Exit(4)
+		}
+	}
+}
+
+func TestNavigationSkipsUnchangedUpdates(t *testing.T) {
+	for _, tool := range []struct {
+		name string
+		run  func(context.Context, *lsp.Client, string, int, int) (string, error)
+	}{{"hover", GetHoverInfo}, {"definition", ReadDefinitionAt}, {"references", FindReferencesAt}} {
+		t.Run(tool.name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "call.ex")
+			t.Setenv("TIPS_SYNC_SERVER", "1")
+			client, err := lsp.NewClient(os.Args[0], "-test.run=^TestNavigationSyncServer$")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer func() { _ = client.Cmd.Process.Kill(); _ = client.Cmd.Wait() }()
+			ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+			defer cancel()
+			for _, content := range []string{"# original\nvalue()\n", "# edited\nvalue()\n", "# original\nvalue()\n"} {
+				if err := os.WriteFile(path, []byte(content), 0600); err != nil {
+					t.Fatal(err)
+				}
+				for range 3 {
+					if _, err := tool.run(ctx, client, path, 2, 1); err != nil {
+						t.Fatal(err)
+					}
+				}
+			}
+		})
+	}
+}
