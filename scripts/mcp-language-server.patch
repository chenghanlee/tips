+
+// DiagnosticsSeq returns how many publishDiagnostics notifications have arrived for uri and a
+// channel that is closed when the next notification for any file arrives.
+func (c *Client) DiagnosticsSeq(uri protocol.DocumentUri) (uint64, <-chan struct{}) {
+	c.diagnosticsMu.RLock()
+	defer c.diagnosticsMu.RUnlock()
+
+	return c.diagnosticsSeq[uri], c.diagnosticsPublished
+}
+
+// DiagnosticSnapshot keeps the list and its provenance together under one lock.
+type DiagnosticSnapshot struct {
+	Diagnostics []protocol.Diagnostic
+	Version     *int32
+	Sequence    uint64
+}
+
+// WaitForDiagnostics returns a publication at least as new as the requested
+// version. Unversioned results are returned as such, never certified as current.
+// The snapshot is captured here so a later publication cannot replace it between
+// waking the caller and reading the cache.
+func (c *Client) WaitForDiagnostics(ctx context.Context, uri protocol.DocumentUri, after uint64, version int32, timeout time.Duration) (DiagnosticSnapshot, bool) {
+	timer := time.NewTimer(timeout)
+	defer timer.Stop()
+	for {
+		c.diagnosticsMu.RLock()
+		snapshot := DiagnosticSnapshot{c.diagnostics[uri], c.diagnosticsVersions[uri], c.diagnosticsSeq[uri]}
+		published := c.diagnosticsPublished
+		c.diagnosticsMu.RUnlock()
+		if snapshot.Sequence > after && (snapshot.Version == nil || *snapshot.Version >= version) {
+			return snapshot, true
+		}
+		select {
+		case <-published:
+		case <-timer.C:
+			return snapshot, false
+		case <-ctx.Done():
+			return snapshot, false
+		}
+	}
+}
