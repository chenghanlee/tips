+++ b/internal/tools/references_at.go
@@ -0,0 +1,29 @@
+package tools
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/isaacphi/mcp-language-server/internal/lsp"
+	"github.com/isaacphi/mcp-language-server/internal/protocol"
+)
+
+// FindReferencesAt retains the caller's source/project context instead of
+// moving the request to a declaration discovered through workspace search.
+func FindReferencesAt(ctx context.Context, client *lsp.Client, filePath string, line, column int) (string, error) {
+	position, err := navigationPosition(ctx, client, filePath, line, column)
+	if err != nil {
+		return "", err
+	}
+	locations, err := client.References(ctx, protocol.ReferenceParams{
+		TextDocumentPositionParams: position,
+		Context:                    protocol.ReferenceContext{IncludeDeclaration: false},
+	})
+	if err != nil {
+		return "", fmt.Errorf("references request failed: %w", err)
+	}
+	if len(locations) == 0 {
+		return fmt.Sprintf("No references returned for %s at L%d:C%d. The project may still be indexing; this does not prove there are no usages.", filePath, line, column), nil
+	}
+	return "References returned by the language server for the project selected by the source file; other projects may have additional usages.\n\n" + formatNavigationLocations(locations, false), nil
+}
