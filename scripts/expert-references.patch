+defmodule Engine.CodeIntelligence.ReferencesOutcomeTest do
+  use ExUnit.Case, async: false
+  use Patch
+
+  import Forge.Test.CursorSupport
+  import Forge.Test.EventualAssertions
+  import Forge.Test.Fixtures
+
+  alias Engine.CodeIntelligence.References
+  alias Engine.Search.Store
+  alias Engine.Search.Store.Backends.Ets
+
+  setup do
+    project = project()
+    Ets.destroy_all(project)
+    Engine.set_project(project)
+    start_supervised!(Engine.ApplicationCache)
+    start_supervised!(Forge.Document.Store)
+    start_supervised!(Engine.Dispatch)
+    start_supervised!(Ets)
+    on_exit(fn -> Ets.destroy_all(project) end)
+    %{project: project}
+  end
+
+  test "disabled and loading are distinct from a successful empty search", %{project: project} do
+    owner = self()
+
+    create = fn _ ->
+      send(owner, {:indexing, self()})
+
+      receive do
+        :finish -> {:ok, []}
+      end
+    end
+
+    start_supervised!({Store, [project, create, fn _, _ -> {:ok, [], []} end, Ets]})
+    assert {:error, :index_not_ready} = references()
+    Store.enable()
+    assert_receive {:indexing, loader}
+    assert {:error, :index_not_ready} = references()
+    send(loader, :finish)
+    assert_eventually Store.loaded?()
+    assert [] = references()
+  end
+
+  test "failed initialization remains an explicit failure", %{project: project} do
+    start_supervised!(
+      {Store, [project, fn _ -> {:error, :disk_failure} end, fn _, _ -> {:ok, [], []} end, Ets]}
+    )
+
+    Store.enable()
+    assert_eventually match?({:error, {:index_failed, :disk_failure}}, references())
+    refute Store.loaded?()
+  end
+
+  test "a query timeout while installing the index remains retryable", %{project: project} do
+    owner = self()
+
+    patch(Ets, :replace_all, fn entries ->
+      send(owner, {:installing, self()})
+
+      receive do
+        :finish_install -> real(Ets).replace_all(entries)
+      end
+    end)
+
+    start_supervised!(
+      {Store, [project, fn _ -> {:ok, []} end, fn _, _ -> {:ok, [], []} end, Ets]}
+    )
+
+    Store.enable()
+    assert_receive {:installing, store}, 1_000
+
+    try do
+      # Exercise the real Store call's five-second deadline.
+      assert {:error, :index_not_ready} = references()
+    after
+      send(store, :finish_install)
+    end
+
+    assert_eventually Store.loaded?()
+    assert [] = references()
+  end
+
+  test "query errors and unresolved symbols are not successful empty results", %{project: project} do
+    start_supervised!(
+      {Store, [project, fn _ -> {:ok, []} end, fn _, _ -> {:ok, [], []} end, Ets]}
+    )
+
+    Store.enable()
+    assert_eventually Store.loaded?()
+    patch(Ets, :find_by_subject, {:error, :broken_backend})
+    assert {:error, {:query_failed, :broken_backend}} = references()
+    {position, document} = pop_cursor(":unresolved|", as: :document)
+
+    assert {:error, :unresolved_symbol} =
+             References.references(Forge.Ast.analyze(document), position, false)
+  end
+
+  for phase <- [:new, :prepare, :replace_all, :refresh, :raise] do
+    test "index initialization failure during #{phase} cannot become ready", %{project: project} do
+      phase = unquote(phase)
+
+      create = initialization_failure(phase)
+      start_supervised!({Store, [project, create, fn _, _ -> {:error, :disk_failure} end, Ets]})
+      Store.enable()
+      assert_eventually match?({:error, {:index_failed, _}}, references())
+      refute Store.loaded?()
+    end
+  end
+
+  test "a backend timeout during stale-index installation is a failure", %{project: project} do
+    patch(Ets, :prepare, fn pid ->
+      {:ok, _} = GenServer.call(pid, :prepare, :infinity)
+      {:ok, :stale}
+    end)
+
+    patch(Ets, :delete_by_path, fn _ -> exit({:timeout, :backend}) end)
+
+    start_supervised!(
+      {Store, [project, fn _ -> {:ok, []} end, fn _, _ -> {:ok, [], ["/failed.ex"]} end, Ets]}
+    )
+
+    Store.enable()
+
+    assert_eventually match?(
+                        {:error, {:index_failed, {:exit, {:timeout, :backend}}}},
+                        references()
+                      )
+
+    refute Store.loaded?()
+  end
+
+  defp initialization_failure(phase) do
+    if phase in [:new, :prepare, :replace_all], do: patch(Ets, phase, {:error, :disk_failure})
+    if phase == :refresh, do: patch(Ets, :prepare, {:ok, :stale})
+
+    fn _ ->
+      if phase == :raise, do: raise("indexer failed"), else: {:ok, []}
+    end
+  end
+
+  defp references do
+    {position, document} = pop_cursor("defmodule Sam|ple do\nend", as: :document)
+    References.references(Forge.Ast.analyze(document), position, false)
+  end
+end
