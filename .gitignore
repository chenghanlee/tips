.DS_Store
# Tracked: the repository's own skills, linked for Claude and Codex. Everything else is local.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/dexter
!.claude/skills/design-software
!.claude/skills/implement-software
!.claude/skills/review-software-correctness
!.claude/skills/review-software-design
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/dexter
!.agents/skills/design-software
!.agents/skills/implement-software
!.agents/skills/review-software-correctness
!.agents/skills/review-software-design
.codex/
.env
.env.*
!.env.example
.agent-runs/
/agent/lsp/vendor/
/agent/elixir-agent-tools/
.worktrees/
/agent/teams/allocations/
__pycache__/
*.pyc
docs/implementation/communication/

# Phoenix generated files
# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/
/screenshots/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
tips-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Dexter workspace index and prototype client state
/.dexter/
docs/implementation/handoffs/
