#!/usr/bin/env bash
# Start the dispatcher in this Herdr pane. Its settings are [dispatcher] in config.toml.
if [[ $# -gt 1 || ( $# -eq 1 && $1 != --new-pane ) ]]; then
  echo 'Usage: agent/teams/dispatch [--new-pane]' >&2
  exit 2
fi
cd "$(dirname "$0")/../.." || exit
settings=$(python3 -c '
import sys, tomllib
d = tomllib.load(open(sys.argv[1], "rb"))["dispatcher"]
print(d["model"], d["effort"], d["compact_percent"], sep="\n")
' "${TIPS_TEAM_CONFIG:-agent/teams/config.toml}") || exit
{
  IFS= read -r model
  IFS= read -r effort
  IFS= read -r compact_percent
} <<<"$settings"
if [[ ${1:-} == --new-pane ]]; then
  if [[ ${HERDR_ENV:-} != 1 || -z ${HERDR_PANE_ID:-} ]]; then
    echo '--new-pane requires a session running inside Herdr.' >&2
    exit 1
  fi
  layout=$(herdr pane layout --current) || exit
  direction=$(python3 -c '
import json, sys
panes = json.load(sys.stdin)["result"]["layout"]["panes"]
rect = next(p["rect"] for p in panes if p["pane_id"] == sys.argv[1])
print("right" if rect["width"] >= 120 else "down")
' "$HERDR_PANE_ID" <<<"$layout") || exit
  pane=$(herdr pane split --current --direction "$direction" --cwd "$PWD" --no-focus) || exit
  pane_id=$(python3 -c 'import json, sys; print(json.load(sys.stdin)["result"]["pane"]["pane_id"])' <<<"$pane") || exit
  printf -v command 'TIPS_TEAM_CONFIG=%q %q' "${TIPS_TEAM_CONFIG:-$PWD/agent/teams/config.toml}" "$PWD/agent/teams/dispatch"
  herdr pane run "$pane_id" "$command" || exit
  echo "Dispatcher launch submitted to Herdr pane $pane_id. Check that pane for startup or approval prompts."
  exit 0
fi
model_args=()
if [[ -n $model ]]; then
  model_args=(--model "$model")
fi
advisor_args=()
case "$model" in
  ""|*fable*) ;;
  *) advisor_args=(--advisor fable) ;;
esac
# Every ring starts a turn over the whole context, so compact early; GitHub holds the state.
CLAUDE_AUTOCOMPACT_PCT_OVERRIDE=$compact_percent exec claude --permission-mode auto \
  "${model_args[@]}" --effort "$effort" "${advisor_args[@]}" \
  --append-system-prompt 'You are the Tips technical program manager and dispatcher. Read AGENTS.md and agent/teams/README.md. Use the Project 15 milestone plan, issue dependencies and product value to choose and prepare the next eligible task yourself; do not wait for the user to mark tasks Ready. At startup, on every done or blocked message and when the user says the board changed, apply its Common path and Rules; reread them if they are no longer in context.' \
  'Run herdr agent rename "$HERDR_PANE_ID" dispatcher, then begin.'
