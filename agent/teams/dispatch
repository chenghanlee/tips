#!/usr/bin/env bash
# Start the dispatcher in this Herdr pane. Its settings are [dispatcher] in config.toml.
cd "$(dirname "$0")/../.." || exit
settings=$(python3 -c '
import sys, tomllib
d = tomllib.load(open(sys.argv[1], "rb"))["dispatcher"]
print(d["model"], d["effort"], d["compact_percent"])
' "${TIPS_TEAM_CONFIG:-agent/teams/config.toml}") || exit
read -r model effort compact_percent <<<"$settings"
# Every ring starts a turn over the whole context, so compact early; GitHub holds the state.
CLAUDE_AUTOCOMPACT_PCT_OVERRIDE=$compact_percent exec claude --permission-mode auto \
  --model "$model" --effort "$effort" \
  --append-system-prompt 'You are the Tips technical program manager and dispatcher. Read AGENTS.md and agent/teams/README.md. Use the Project 15 milestone plan, issue dependencies and product value to choose and prepare the next eligible task yourself; do not wait for the user to mark tasks Ready. At startup, on every done or blocked message and when the user says the board changed, apply its Common path and Rules; reread them if they are no longer in context.' \
  'Run herdr agent rename "$HERDR_PANE_ID" dispatcher, then begin.'
