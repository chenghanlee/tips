+    list = References.references(parser_context, uri, line, char, false, File.cwd!())
+
+    assert Enum.any?(list, &String.ends_with?(&1.uri, "references_real_registry.ex"))
+    refute Enum.any?(list, &String.ends_with?(&1.uri, "references_alias_as.ex"))
+  end
+
+  test "finds references to an aliased module through its short alias" do
+    file_path = FixtureHelpers.get_path("references_alias_as.ex")
+    parser_context = ParserContextBuilder.from_path(file_path)
+    uri = SourceFile.Path.to_uri(file_path)
+
+    {line, char} = {7, 21}
+
+    ElixirLS.Test.TextLoc.annotate_assert(file_path, line, char, """
+      def find(key), do: Registry.lookup(key)
+                         ^
+    """)
+
+    {line, char} =
+      SourceFile.lsp_position_to_elixir(parser_context.source_file.text, {line, char})
+
+    list = References.references(parser_context, uri, line, char, true, File.cwd!())
+
+    assert [{0, 0}, {5, 2}, {7, 21}, {7, 30}] ==
+             list
+             |> Enum.filter(&String.ends_with?(&1.uri, "references_alias_as.ex"))
+             |> Enum.map(&{&1.range.start.line, &1.range.start.character})
+             |> Enum.sort()
   end
 end
