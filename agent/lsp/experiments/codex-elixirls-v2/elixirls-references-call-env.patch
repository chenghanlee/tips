diff -ruN a/apps/language_server/test/providers/references/locator_test.exs b/apps/language_server/test/providers/references/locator_test.exs
--- a/apps/language_server/test/providers/references/locator_test.exs	2026-09-25 16:06:08
+++ b/apps/language_server/test/providers/references/locator_test.exs	2026-09-25 16:06:08
@@ -2361,4 +2361,134 @@
     |> Enum.at(line - 1)
     |> String.slice((column - 1)..-1//1)
   end
+
+  describe "resolves each call in its own lexical env" do
+    test "variable rebound later on the same line", %{trace: trace} do
+      buffer = """
+      defmodule LexEnvRefs.One do
+        def x, do: :one
+      end
+
+      defmodule LexEnvRefs.Two do
+        def x, do: :two
+      end
+
+      defmodule LexEnvRefs.Caller do
+        def f, do: (mod = LexEnvRefs.One; mod.x(); mod = LexEnvRefs.Two; mod.x())
+        def g, do: (mod = LexEnvRefs.One; mod = mod.x(); mod)
+      end
+      """
+
+      assert Locator.references(buffer, 2, 7, trace) == [
+               %{
+                 range: %{start: %{line: 10, column: 41}, end: %{line: 10, column: 42}},
+                 uri: nil
+               },
+               %{range: %{start: %{line: 11, column: 47}, end: %{line: 11, column: 48}}, uri: nil}
+             ]
+
+      assert Locator.references(buffer, 6, 7, trace) == [
+               %{range: %{start: %{line: 10, column: 72}, end: %{line: 10, column: 73}}, uri: nil}
+             ]
+    end
+
+    test "variable bound by one clause of a one-line fn", %{trace: trace} do
+      buffer = """
+      defmodule LexEnvRefs.One do
+        def x, do: :one
+      end
+
+      defmodule LexEnvRefs.Caller do
+        def f(mods), do: Enum.map(mods, fn LexEnvRefs.One = mod -> mod.x(); mod -> mod end)
+      end
+      """
+
+      assert Locator.references(buffer, 2, 7, trace) == [
+               %{range: %{start: %{line: 6, column: 66}, end: %{line: 6, column: 67}}, uri: nil}
+             ]
+    end
+
+    test "attribute redefined later on the same line", %{trace: trace} do
+      buffer = """
+      defmodule LexEnvRefs.One do
+        def x, do: :one
+      end
+
+      defmodule LexEnvRefs.Two do
+        def x, do: :two
+      end
+
+      defmodule LexEnvRefs.Caller do
+        @mod LexEnvRefs.One
+        def f, do: @mod.x(); @mod LexEnvRefs.Two; def g, do: @mod.x()
+      end
+      """
+
+      assert Locator.references(buffer, 2, 7, trace) == [
+               %{range: %{start: %{line: 11, column: 19}, end: %{line: 11, column: 20}}, uri: nil}
+             ]
+
+      assert Locator.references(buffer, 6, 7, trace) == [
+               %{range: %{start: %{line: 11, column: 61}, end: %{line: 11, column: 62}}, uri: nil}
+             ]
+    end
+
+    test "local call when the module changes later on the same line", %{trace: trace} do
+      buffer = """
+      defmodule LexEnvRefs.A do def x, do: :a; def f, do: x() end; defmodule LexEnvRefs.B do def x, do: :b end
+      """
+
+      assert Locator.references(buffer, 1, 31, trace) == [
+               %{range: %{start: %{line: 1, column: 53}, end: %{line: 1, column: 54}}, uri: nil}
+             ]
+
+      assert Locator.references(buffer, 1, 92, trace) == []
+    end
+
+    test "expanded call receivers are not alias-expanded again", %{trace: trace} do
+      buffer = """
+      defmodule LexEnvRefs.Target do
+        def run, do: :target
+      end
+
+      defmodule LexEnvRefs.Ctx.LexEnvRefs do
+        def run, do: :ctx
+      end
+
+      defmodule LexEnvRefs.Caller do
+        alias LexEnvRefs.Target, as: Tg
+        alias LexEnvRefs.Ctx.LexEnvRefs
+
+        def f, do: Tg.run()
+        def g, do: LexEnvRefs.run()
+      end
+      """
+
+      assert Locator.references(buffer, 2, 7, trace) == [
+               %{range: %{start: %{line: 13, column: 17}, end: %{line: 13, column: 20}}, uri: nil}
+             ]
+
+      assert Locator.references(buffer, 6, 7, trace) == [
+               %{range: %{start: %{line: 14, column: 25}, end: %{line: 14, column: 28}}, uri: nil}
+             ]
+    end
+
+    test "remote type in a spec is not a function reference", %{trace: trace} do
+      buffer = """
+      defmodule LexEnvRefs.Types do
+        @type t :: atom
+        def t, do: :t
+      end
+
+      defmodule LexEnvRefs.Spec do
+        @spec f() :: LexEnvRefs.Types.t()
+        def f, do: LexEnvRefs.Types.t()
+      end
+      """
+
+      assert Locator.references(buffer, 3, 7, trace) == [
+               %{range: %{start: %{line: 8, column: 31}, end: %{line: 8, column: 32}}, uri: nil}
+             ]
+    end
+  end
 end
