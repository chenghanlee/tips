     #[test]
+    fn beta_schema_and_decoder_allow_exactly_seven_read_operations() {
+        use clap::ValueEnum;
+        let allowed = [
+            "definition",
+            "references",
+            "hover",
+            "document_symbols",
+            "workspace_symbols",
+            "diagnostics",
+            "workspace_diagnostics",
+        ];
+        let schema = serde_json::to_value(schemars::schema_for!(LspOperation)).unwrap();
+        assert_eq!(schema["enum"], serde_json::json!(allowed));
+        for operation in LspOperation::value_variants() {
+            let name = operation.as_str();
+            let decoded = serde_json::from_value::<LspOperation>(serde_json::json!(name));
+            assert_eq!(decoded.is_ok(), allowed.contains(&name), "{name}");
+        }
+    }
