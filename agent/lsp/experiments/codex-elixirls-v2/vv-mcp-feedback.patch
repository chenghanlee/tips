+    #[test]
+    fn preserves_feedback_alongside_compact_results() {
+        let feedback = serde_json::json!({"status": "pending", "generation": 2,
+            "message": "Compilation pending; empty results do not establish absence."});
+        for operation in ["hover", "references", "diagnostics"] {
+            let mut raw = fixture();
+            raw["feedback"] = feedback.clone();
+            let output = OutputConfig::default().format_lsp(operation, raw.clone());
+            let output: Value = serde_json::from_str(&output).unwrap();
+            assert_eq!(output["feedback"], feedback);
+            let unqualified: Value = serde_json::from_str(
+                &OutputConfig::default().format_lsp(operation, fixture())
+            ).unwrap();
+            for (key, value) in unqualified.as_object().unwrap() {
+                assert_eq!(&output[key], value);
+            }
+            let markdown = OutputConfig { format: OutputFormat::Markdown, max_results: 2 }
+                .format_lsp(operation, raw);
+            assert!(markdown.starts_with("Feedback: "));
+            assert!(markdown.contains("empty results do not establish absence"));
+        }
