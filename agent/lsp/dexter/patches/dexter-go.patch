+
+	// Control: the same name used as a type still reaches the type.
+	_, line, col = arityAt{aritySite{file, "@spec start(run()) :: run()"}, "run()", 1}.resolve(t, root)
+	got := arityLocKeys(root, definitionAt(t, server, uri, line, col))
+	if want := aritySiteKeys(t, aritySite{file, "@type run :: atom()"}); !sameKeys(got, want) {
+		t.Errorf("definition of type run() = %v, want %v", got, want)
