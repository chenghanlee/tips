diff --git a/internal/treesitter/arity.go b/internal/treesitter/arity.go
new file mode 100644
index 0000000..5c42319
--- /dev/null
+++ b/internal/treesitter/arity.go
@@ -0,0 +1,487 @@
+// Package treesitter answers syntax questions about Elixir source with the
+// tree-sitter Elixir grammar.
+package treesitter
+
+import (
+	"strconv"
+
+	tree_sitter "github.com/tree-sitter/go-tree-sitter"
+)
+
+// Arity is the set of argument counts a source occurrence of a function name
+// can denote: one count for a call or capture, a range for a definition head
+// with default arguments (`def f(a, b \\ 1)` declares f/1 and f/2). The zero
+// value is unknown and matches every arity.
+type Arity struct {
+	Min, Max int
+	Known    bool
+}
+
+// ExactArity is the arity of a call with n arguments.
+func ExactArity(n int) Arity { return Arity{Min: n, Max: n, Known: true} }
+
+// Bounds returns the arity range for store queries, -1, -1 when unknown.
+func (a Arity) Bounds() (minArity, maxArity int) {
+	if !a.Known {
+		return -1, -1
+	}
+	return a.Min, a.Max
+}
+
+// Matches reports whether a definition of arity n can be the target.
+func (a Arity) Matches(n int) bool {
+	return !a.Known || (n >= a.Min && n <= a.Max)
+}
+
+// OccurrenceKind says what a function-name occurrence is.
+type OccurrenceKind uint8
+
+const (
+	// OccurrencePlain is a name that is not a function reference: a bound
+	// variable, a binding in a pattern, a module attribute or the left of a
+	// dot. Its arity is unknown.
+	OccurrencePlain OccurrenceKind = iota
+	// OccurrenceCall is a call, a pipe target, a capture, or a bare name that
+	// no variable binds, which Elixir reads as a call with no arguments.
+	OccurrenceCall
+	// OccurrenceHead is the name in a def/defp/defmacro/defguard/defdelegate head.
+	OccurrenceHead
+	// OccurrenceSpecHead is the name in a @spec head; it names the function.
+	OccurrenceSpecHead
+	// OccurrenceCallbackHead is the name in a @callback or @macrocallback head.
+	OccurrenceCallbackHead
+	// OccurrenceTypespec is a name inside a typespec or a @type head: a type.
+	OccurrenceTypespec
+)
+
+// FunctionOccurrence is one occurrence of a function name in source.
+type FunctionOccurrence struct {
+	Name string
+	Kind OccurrenceKind
+	// Qualifier is the module expression before the dot (`Alias`, `A.B`,
+	// `__MODULE__`, `:erlang`), empty for an unqualified name.
+	Qualifier string
+	// Line is the 0-based row where the expression starts: the qualifier for
+	// a qualified name, the name itself otherwise. The indexer records
+	// references on the same row.
+	Line uint
+	// NameLine, NameCol and NameEndCol span the function-name token (0-based,
+	// byte columns).
+	NameLine, NameCol, NameEndCol uint
+	Arity                         Arity
+	// Keyword is the def-family keyword of a head (`def`, `defdelegate`, ...).
+	Keyword string
+}
+
+var definitionHeadKeywords = map[string]bool{
+	"def": true, "defp": true, "defmacro": true, "defmacrop": true,
+	"defguard": true, "defguardp": true, "defdelegate": true,
+}
+
+var typespecAttributes = map[string]bool{
+	"type": true, "typep": true, "opaque": true,
+	"spec": true, "callback": true, "macrocallback": true,
+}
+
+// FunctionOccurrenceAt classifies the identifier under the cursor as a
+// function-name occurrence. A cursor just past the end of an identifier also
+// counts, as it does for the token-based expression lookup.
+func FunctionOccurrenceAt(root *tree_sitter.Node, src []byte, line, col uint) (FunctionOccurrence, bool) {
+	node := nodeAtPosition(root, line, col)
+	if (node == nil || node.Kind() != "identifier") && col > 0 {
+		node = nodeAtPosition(root, line, col-1)
+	}
+	if node == nil || node.Kind() != "identifier" {
+		return FunctionOccurrence{}, false
+	}
+	return classifyWithScope(root, node, src), true
+}
+
+// FunctionOccurrencesInSource parses src and returns every occurrence of name.
+func FunctionOccurrencesInSource(src []byte, name string) []FunctionOccurrence {
+	root, cleanup := parseElixir(src)
+	if root == nil {
+		return nil
+	}
+	defer cleanup()
+	return FunctionOccurrences(root, src, name)
+}
+
+// FunctionOccurrences returns every occurrence of name in the tree, in source
+// order, classified as FunctionOccurrenceAt would classify it.
+func FunctionOccurrences(root *tree_sitter.Node, src []byte, name string) []FunctionOccurrence {
+	var out []FunctionOccurrence
+	var walk func(n *tree_sitter.Node)
+	walk = func(n *tree_sitter.Node) {
+		if n.Kind() == "identifier" {
+			if n.Utf8Text(src) == name {
+				out = append(out, classifyWithScope(root, n, src))
+			}
+			return
+		}
+		for i := uint(0); i < n.ChildCount(); i++ {
+			walk(n.Child(i))
+		}
+	}
+	if root != nil {
+		walk(root)
+	}
+	return out
+}
+
+// classifyWithScope is classifyFunctionName plus the one case syntax alone
+// cannot settle: a bare name is a variable when one is bound and name/0
+// otherwise.
+func classifyWithScope(root, ident *tree_sitter.Node, src []byte) FunctionOccurrence {
+	occ := classifyFunctionName(ident, src)
+	if occ.Kind == OccurrencePlain && zeroArityCall(root, ident, src) {
+		occ.Kind, occ.Arity = OccurrenceCall, ExactArity(0)
+	}
+	return occ
+}
+
+// zeroArityCall reports whether a bare identifier with no call syntax calls a
+// function with no arguments. The binding check is the variable resolver's,
+// so a name counts as a call only where go-to-definition would not treat it
+// as a variable.
+func zeroArityCall(root, ident *tree_sitter.Node, src []byte) bool {
+	parent := ident.Parent()
+	if parent == nil || parent.Kind() == "dot" || parent.Kind() == "call" {
+		return false
+	}
+	if parent.Kind() == "unary_operator" {
+		// `@name` is a module attribute and `^name` a pinned variable.
+		if op := operatorText(parent, src); op == "@" || op == "^" {
+			return false
+		}
+	}
+	if inPattern(ident, src) {
+		return false
+	}
+	pos := ident.StartPosition()
+	return resolveVariableScope(root, src, pos.Row, pos.Column) == nil
+}
+
+// inPattern reports whether node sits where Elixir binds variables: the left
+// of `=` or `<-`, a clause's arguments, or a definition head. A binding that
+// is never used is still a variable, though the variable resolver, which
+// looks for a second occurrence, cannot tell.
+func inPattern(node *tree_sitter.Node, src []byte) bool {
+	child := node
+	for parent := node.Parent(); parent != nil; child, parent = parent, parent.Parent() {
+		switch parent.Kind() {
+		case "binary_operator":
+			left := sameNode(parent.ChildByFieldName("left"), child)
+			switch operatorText(parent, src) {
+			case "=", "<-":
+				if left {
+					return true
+				}
+			case "when", `\\`:
+				if !left {
+					// A guard or a default value is an expression.
+					return false
+				}
+			}
+		case "stab_clause":
+			return sameNode(parent.ChildByFieldName("left"), child)
+		case "arguments":
+			if keyword, _ := definitionHeadCall(child, src); keyword != "" {
+				return true
+			}
+		case "do_block":
+			return false
+		}
+	}
+	return false
+}
+
+// classifyFunctionName derives kind and arity for an identifier from the
+// syntax around it. Argument counting follows Elixir's AST: a trailing keyword
+// list is one argument, a do-block is one more argument (even after a trailing
+// keyword list), and a pipe supplies the first argument.
+func classifyFunctionName(ident *tree_sitter.Node, src []byte) FunctionOccurrence {
+	occ := FunctionOccurrence{
+		Name:       ident.Utf8Text(src),
+		Kind:       OccurrencePlain,
+		Line:       ident.StartPosition().Row,
+		NameLine:   ident.StartPosition().Row,
+		NameCol:    ident.StartPosition().Column,
+		NameEndCol: ident.EndPosition().Column,
+	}
+	call, ok := referenceCall(ident, src, &occ)
+	switch {
+	case !ok:
+		return occ
+	case call == nil:
+		return classifyBareName(occ, ident, src)
+	default:
+		return classifyCall(occ, call, src)
+	}
+}
+
+// referenceCall returns the call node that stands for the whole reference,
+// recording a qualifier on occ. It returns nil for a name without a call
+// node, and false for a name that is not in a function position: the left of
+// a dot or an argument inside a call node.
+func referenceCall(ident *tree_sitter.Node, src []byte, occ *FunctionOccurrence) (*tree_sitter.Node, bool) {
+	parent := ident.Parent()
+	if parent == nil {
+		return nil, false
+	}
+	switch parent.Kind() {
+	case "dot":
+		left := parent.ChildByFieldName("left")
+		if !sameNode(parent.ChildByFieldName("right"), ident) || left == nil {
+			return nil, false
+		}
+		occ.Qualifier = left.Utf8Text(src)
+		occ.Line = parent.StartPosition().Row
+		gp := parent.Parent()
+		if gp == nil || gp.Kind() != "call" || !sameNode(gp.ChildByFieldName("target"), parent) {
+			return nil, false
+		}
+		return gp, true
+	case "call":
+		if !sameNode(parent.ChildByFieldName("target"), ident) {
+			return nil, false
+		}
+		return parent, true
+	}
+	return nil, true
+}
+
+// classifyBareName classifies a name without a call node: a capture, a pipe
+// target, a zero-arity definition head or a name in a typespec.
+func classifyBareName(occ FunctionOccurrence, ident *tree_sitter.Node, src []byte) FunctionOccurrence {
+	if n, ok := captureArity(ident, src); ok {
+		occ.Kind, occ.Arity = OccurrenceCall, ExactArity(n)
+	} else if isPipeTarget(ident, src) {
+		occ.Kind, occ.Arity = OccurrenceCall, ExactArity(1)
+	} else if keyword, _ := definitionHeadCall(ident, src); keyword != "" {
+		// `def f do` / `def f, do: ...`: a zero-arity head.
+		occ.Kind, occ.Arity, occ.Keyword = OccurrenceHead, ExactArity(0), keyword
+	} else if inTypespec(ident, src) {
+		occ.Kind = OccurrenceTypespec
+	}
+	return occ
+}
+
+// classifyCall classifies the name of a call node.
+func classifyCall(occ FunctionOccurrence, call *tree_sitter.Node, src []byte) FunctionOccurrence {
+	if p := call.Parent(); p != nil && p.Kind() == "unary_operator" && operatorText(p, src) == "@" {
+		// `@name value` sets a module attribute.
+		return occ
+	}
+	if n, ok := captureArity(call, src); ok {
+		occ.Kind, occ.Arity = OccurrenceCall, ExactArity(n)
+		return occ
+	}
+	args, defaults := callArguments(call, src)
+	if occ.Qualifier == "" && classifyHead(&occ, call, src, args, defaults) {
+		return occ
+	}
+	if inTypespec(call, src) {
+		occ.Kind = OccurrenceTypespec
+		return occ
+	}
+	if hasChildKind(call, "do_block") {
+		args++
+	}
+	if isPipeTarget(call, src) {
+		args++
+	}
+	occ.Kind, occ.Arity = OccurrenceCall, ExactArity(args)
+	return occ
+}
+
+// classifyHead classifies a call that is a definition head or a typespec
+// attribute head, and reports whether it was one.
+func classifyHead(occ *FunctionOccurrence, call *tree_sitter.Node, src []byte, args, defaults int) bool {
+	if keyword, _ := definitionHeadCall(call, src); keyword != "" {
+		occ.Kind, occ.Keyword = OccurrenceHead, keyword
+		occ.Arity = Arity{Min: args - defaults, Max: args, Known: true}
+		return true
+	}
+	attr, ok := typespecHeadAttribute(call, src)
+	if !ok {
+		return false
+	}
+	switch attr {
+	case "spec":
+		occ.Kind, occ.Arity = OccurrenceSpecHead, ExactArity(args)
+	case "callback", "macrocallback":
+		occ.Kind, occ.Arity = OccurrenceCallbackHead, ExactArity(args)
+	default:
+		occ.Kind = OccurrenceTypespec
+	}
+	return true
+}
+
+// callArguments counts a call's arguments and, for a definition head, the
+// arguments that carry a `\\` default.
+func callArguments(call *tree_sitter.Node, src []byte) (count, defaults int) {
+	for i := uint(0); i < call.ChildCount(); i++ {
+		args := call.Child(i)
+		if args.Kind() != "arguments" {
+			continue
+		}
+		for j := uint(0); j < args.NamedChildCount(); j++ {
+			arg := args.NamedChild(j)
+			if arg.Kind() == "comment" {
+				continue
+			}
+			count++
+			if arg.Kind() == "binary_operator" && operatorText(arg, src) == `\\` {
+				defaults++
+			}
+		}
+	}
+	return count, defaults
+}
+
+// captureArity recognises `&name/N` and `&Mod.name/N`, where node is the
+// identifier or the call node that stands for the captured function.
+func captureArity(node *tree_sitter.Node, src []byte) (int, bool) {
+	parent := node.Parent()
+	if parent == nil {
+		return 0, false
+	}
+	if parent.Kind() == "unary_operator" && operatorText(parent, src) == "&" && node.Kind() == "call" {
+		// `&name(&1, x)` captures name with the written argument count.
+		if !hasChildKind(node, "arguments") {
+			return 0, false
+		}
+		n, _ := callArguments(node, src)
+		return n, true
+	}
+	if parent.Kind() != "binary_operator" || operatorText(parent, src) != "/" || !sameNode(parent.ChildByFieldName("left"), node) {
+		return 0, false
+	}
+	if node.Kind() == "call" && hasChildKind(node, "arguments") {
+		return 0, false
+	}
+	amp := parent.Parent()
+	if amp == nil || amp.Kind() != "unary_operator" || operatorText(amp, src) != "&" {
+		return 0, false
+	}
+	right := parent.ChildByFieldName("right")
+	if right == nil || right.Kind() != "integer" {
+		return 0, false
+	}
+	n, err := strconv.Atoi(right.Utf8Text(src))
+	if err != nil {
+		return 0, false
+	}
+	return n, true
+}
+
+// isPipeTarget reports whether node is the right-hand side of `|>`.
+func isPipeTarget(node *tree_sitter.Node, src []byte) bool {
+	parent := node.Parent()
+	return parent != nil && parent.Kind() == "binary_operator" &&
+		operatorText(parent, src) == "|>" && sameNode(parent.ChildByFieldName("right"), node)
+}
+
+// definitionHeadCall returns the def-family keyword when node is the head of
+// its call: the first argument of `def`, possibly wrapped in a `when` guard.
+// ok is false when node is not inside any argument list.
+func definitionHeadCall(node *tree_sitter.Node, src []byte) (keyword string, ok bool) {
+	parent := node.Parent()
+	if parent != nil && parent.Kind() == "binary_operator" && operatorText(parent, src) == "when" &&
+		sameNode(parent.ChildByFieldName("left"), node) {
+		node, parent = parent, parent.Parent()
+	}
+	if parent == nil || parent.Kind() != "arguments" {
+		return "", false
+	}
+	def := parent.Parent()
+	if def == nil || def.Kind() != "call" || !sameNode(firstNamedNonComment(parent), node) {
+		return "", true
+	}
+	target := def.ChildByFieldName("target")
+	if target == nil || target.Kind() != "identifier" || !definitionHeadKeywords[target.Utf8Text(src)] {
+		return "", true
+	}
+	return target.Utf8Text(src), true
+}
+
+// typespecHeadAttribute returns the attribute name when call is the head of a
+// @spec/@callback/@type declaration: `@spec f(a) :: t`, optionally followed by
+// a `when` clause.
+func typespecHeadAttribute(call *tree_sitter.Node, src []byte) (string, bool) {
+	node := call
+	parent := node.Parent()
+	if parent == nil || parent.Kind() != "binary_operator" || operatorText(parent, src) != "::" ||
+		!sameNode(parent.ChildByFieldName("left"), node) {
+		return "", false
+	}
+	node, parent = parent, parent.Parent()
+	if parent != nil && parent.Kind() == "binary_operator" && operatorText(parent, src) == "when" &&
+		sameNode(parent.ChildByFieldName("left"), node) {
+		node, parent = parent, parent.Parent()
+	}
+	if parent == nil || parent.Kind() != "arguments" || !sameNode(firstNamedNonComment(parent), node) {
+		return "", false
+	}
+	attr := parent.Parent()
+	if attr == nil || attr.Kind() != "call" {
+		return "", false
+	}
+	target := attr.ChildByFieldName("target")
+	if target == nil || target.Kind() != "identifier" || !typespecAttributes[target.Utf8Text(src)] {
+		return "", false
+	}
+	at := attr.Parent()
+	if at == nil || at.Kind() != "unary_operator" || operatorText(at, src) != "@" {
+		return "", false
+	}
+	return target.Utf8Text(src), true
+}
+
+// inTypespec reports whether node sits inside a @type/@spec/@callback
+// declaration, where names refer to types.
+func inTypespec(node *tree_sitter.Node, src []byte) bool {
+	for n := node.Parent(); n != nil; n = n.Parent() {
+		if n.Kind() != "unary_operator" || operatorText(n, src) != "@" {
+			continue
+		}
+		operand := n.ChildByFieldName("operand")
+		if operand == nil || operand.Kind() != "call" {
+			return false
+		}
+		target := operand.ChildByFieldName("target")
+		return target != nil && target.Kind() == "identifier" && typespecAttributes[target.Utf8Text(src)]
+	}
+	return false
+}
+
+func operatorText(n *tree_sitter.Node, src []byte) string {
+	op := n.ChildByFieldName("operator")
+	if op == nil {
+		return ""
+	}
+	return op.Utf8Text(src)
+}
+
+func hasChildKind(n *tree_sitter.Node, kind string) bool {
+	for i := uint(0); i < n.ChildCount(); i++ {
+		if n.Child(i).Kind() == kind {
+			return true
+		}
+	}
+	return false
+}
+
+func firstNamedNonComment(n *tree_sitter.Node) *tree_sitter.Node {
+	for i := uint(0); i < n.NamedChildCount(); i++ {
+		if c := n.NamedChild(i); c.Kind() != "comment" {
+			return c
+		}
+	}
+	return nil
+}
+
+func sameNode(a, b *tree_sitter.Node) bool {
+	return a != nil && b != nil && a.Id() == b.Id()
+}
diff --git a/internal/treesitter/arity_test.go b/internal/treesitter/arity_test.go
new file mode 100644
index 0000000..1b3d495
--- /dev/null
+++ b/internal/treesitter/arity_test.go
@@ -0,0 +1,237 @@
+package treesitter
+
+import (
+	"strings"
+	"testing"
+
+	tree_sitter "github.com/tree-sitter/go-tree-sitter"
+)
+
+// The expected arities are the argument counts in Elixir's own AST
+// (Code.string_to_quoted), not a restatement of the classifier.
+func TestFunctionOccurrenceAt(t *testing.T) {
+	src := `defmodule MyApp.Store do
+  @doc "Puts."
+  def put(key, value), do: {key, value}
+  def put(key, value, opts) when is_list(opts), do: {key, value, opts}
+  def fetch(key, default \\ nil), do: {key, default}
+  def ping, do: :pong
+  @spec save(term, term) :: :ok
+  @callback cast(term) :: term
+  @type t(a) :: {a, put}
+
+  def calls(key) do
+    put(key, :v)
+    key |> put(:v)
+    key |> put
+    &put/3
+    &MyApp.Store.put/2
+    &put(&1, :v)
+    Store.put(key, :v, [])
+    put key, :v, [:x]
+    put(key, fn a, b -> {a, b} end)
+    put(key, mode: :fast, retries: 2)
+    wrap(key, k: 1) do
+      :x
+    end
+    wrap(key, k: 1, do: :x)
+    {put(key, :a), put(key, :b, [:c])}
+  end
+end
+`
+	cases := []struct {
+		name   string
+		line   string // trimmed line text
+		anchor string // text whose first byte starts the name
+		kind   OccurrenceKind
+		arity  Arity
+		qual   string
+	}{
+		{"head", "def put(key, value), do: {key, value}", "put", OccurrenceHead, ExactArity(2), ""},
+		{"guarded head", "def put(key, value, opts) when is_list(opts), do: {key, value, opts}", "put", OccurrenceHead, ExactArity(3), ""},
+		{"default head is a range", `def fetch(key, default \\ nil), do: {key, default}`, "fetch", OccurrenceHead, Arity{Min: 1, Max: 2, Known: true}, ""},
+		{"head without parentheses", "def ping, do: :pong", "ping", OccurrenceHead, ExactArity(0), ""},
+		{"spec head names the function", "@spec save(term, term) :: :ok", "save", OccurrenceSpecHead, ExactArity(2), ""},
+		{"callback head", "@callback cast(term) :: term", "cast", OccurrenceCallbackHead, ExactArity(1), ""},
+		{"type head", "@type t(a) :: {a, put}", "t(", OccurrenceTypespec, Arity{}, ""},
+		{"name in a type body", "@type t(a) :: {a, put}", "put}", OccurrenceTypespec, Arity{}, ""},
+		{"call", "put(key, :v)", "put", OccurrenceCall, ExactArity(2), ""},
+		{"pipe supplies the first argument", "key |> put(:v)", "put", OccurrenceCall, ExactArity(2), ""},
+		{"pipe without parentheses", "key |> put", "put", OccurrenceCall, ExactArity(1), ""},
+		{"capture", "&put/3", "put", OccurrenceCall, ExactArity(3), ""},
+		{"qualified capture", "&MyApp.Store.put/2", "put", OccurrenceCall, ExactArity(2), "MyApp.Store"},
+		{"capture of a call", "&put(&1, :v)", "put", OccurrenceCall, ExactArity(2), ""},
+		{"qualified call", "Store.put(key, :v, [])", "put", OccurrenceCall, ExactArity(3), "Store"},
+		{"call without parentheses", "put key, :v, [:x]", "put", OccurrenceCall, ExactArity(3), ""},
+		{"anonymous function is one argument", "put(key, fn a, b -> {a, b} end)", "put", OccurrenceCall, ExactArity(2), ""},
+		{"trailing keyword list is one argument", "put(key, mode: :fast, retries: 2)", "put", OccurrenceCall, ExactArity(2), ""},
+		{"do-block is another argument after keywords", "wrap(key, k: 1) do", "wrap", OccurrenceCall, ExactArity(3), ""},
+		{"inline do: stays in the keyword list", "wrap(key, k: 1, do: :x)", "wrap", OccurrenceCall, ExactArity(2), ""},
+		{"same line, first call", "{put(key, :a), put(key, :b, [:c])}", "put(key, :a)", OccurrenceCall, ExactArity(2), ""},
+		{"same line, second call", "{put(key, :a), put(key, :b, [:c])}", "put(key, :b", OccurrenceCall, ExactArity(3), ""},
+	}
+
+	lines := strings.Split(src, "\n")
+	root, cleanup := parseElixir([]byte(src))
+	defer cleanup()
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			row, col := nameAt(t, lines, tc.line, tc.anchor, 0)
+			want := FunctionOccurrence{Kind: tc.kind, Arity: tc.arity, Qualifier: tc.qual}
+			checkOccurrenceAt(t, root, []byte(src), row, col, want)
+		})
+	}
+}
+
+// nameAt returns the row of the nth (0-based) line whose trimmed text is
+// line, and the column where anchor starts on it.
+func nameAt(t *testing.T, lines []string, line, anchor string, nth int) (row, col int) {
+	t.Helper()
+	for i, l := range lines {
+		if strings.TrimSpace(l) != line {
+			continue
+		}
+		if nth == 0 && strings.Contains(l, anchor) {
+			return i, strings.Index(l, anchor)
+		}
+		nth--
+	}
+	t.Fatalf("anchor %q on line %q not found", anchor, line)
+	return -1, -1
+}
+
+// checkOccurrenceAt checks the classification at the first two columns of
+// the name: every column of a name must classify the same way.
+func checkOccurrenceAt(t *testing.T, root *tree_sitter.Node, src []byte, row, col int, want FunctionOccurrence) {
+	t.Helper()
+	for _, offset := range []int{0, 1} {
+		occ, ok := FunctionOccurrenceAt(root, src, uint(row), uint(col+offset))
+		if !ok {
+			t.Fatalf("no identifier at %d:%d", row, col+offset)
+		}
+		if occ.Kind != want.Kind || occ.Arity != want.Arity || occ.Qualifier != want.Qualifier || occ.NameCol != uint(col) {
+			t.Errorf("offset %d: got kind %d arity %+v qualifier %q at col %d, want kind %d arity %+v qualifier %q at col %d",
+				offset, occ.Kind, occ.Arity, occ.Qualifier, occ.NameCol, want.Kind, want.Arity, want.Qualifier, col)
+		}
+	}
+}
+
+func TestFunctionOccurrences_ReportsEveryOccurrenceOnALine(t *testing.T) {
+	src := []byte(`defmodule MyApp.Mixer do
+  def mixed do
+    {Alpha.f(1, 2), Beta.f(1, 2, 3)}
+  end
+end
+`)
+	root, cleanup := parseElixir(src)
+	defer cleanup()
+	occs := FunctionOccurrences(root, src, "f")
+	if len(occs) != 2 {
+		t.Fatalf("got %d occurrences, want 2", len(occs))
+	}
+	want := []struct {
+		qual  string
+		arity int
+		col   uint
+	}{{"Alpha", 2, 11}, {"Beta", 3, 25}}
+	for i, w := range want {
+		if occs[i].Name != "f" || occs[i].Qualifier != w.qual || occs[i].Arity != ExactArity(w.arity) || occs[i].NameCol != w.col || occs[i].Line != 2 {
+			t.Errorf("occurrence %d = %+v, want %s.f/%d at 2:%d", i, occs[i], w.qual, w.arity, w.col)
+		}
+	}
+}
+
+func TestArityMatching(t *testing.T) {
+	head := Arity{Min: 1, Max: 2, Known: true}
+	if !head.Matches(1) || !head.Matches(2) || head.Matches(3) {
+		t.Errorf("default head %+v must match /1 and /2 only", head)
+	}
+	if !(Arity{}).Matches(7) {
+		t.Error("unknown arity must match any definition")
+	}
+}
+
+// A bare name is a variable where one is bound and a call with no arguments
+// everywhere else (Elixir reads `ping` as ping/0).
+func TestFunctionOccurrenceAt_BareName(t *testing.T) {
+	src := `defmodule MyApp.Pinger do
+  @doc "Pings."
+  def ping, do: :pong
+  def ping(x), do: x
+
+  def bare do
+    ping
+  end
+
+  def param(ping) do
+    ping
+  end
+
+  def assigned do
+    ping = 1
+    ping
+  end
+
+  def unused(other) do
+    {:ok, ping} = other
+    @ping
+  end
+end
+`
+	cases := []struct {
+		name  string
+		line  string
+		kind  OccurrenceKind
+		arity Arity
+		nth   int // which match of line, 0-based
+	}{
+		{"unbound bare name calls name/0", "ping", OccurrenceCall, ExactArity(0), 0},
+		{"parameter binding", "def param(ping) do", OccurrencePlain, Arity{}, 0},
+		{"bound parameter use", "ping", OccurrencePlain, Arity{}, 1},
+		{"assignment binding", "ping = 1", OccurrencePlain, Arity{}, 0},
+		{"assigned variable use", "ping", OccurrencePlain, Arity{}, 2},
+		{"unused pattern binding", "{:ok, ping} = other", OccurrencePlain, Arity{}, 0},
+		{"module attribute", "@ping", OccurrencePlain, Arity{}, 0},
+	}
+	lines := strings.Split(src, "\n")
+	root, cleanup := parseElixir([]byte(src))
+	defer cleanup()
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			row, col := nameAt(t, lines, tc.line, "ping", tc.nth)
+			checkOccurrenceAt(t, root, []byte(src), row, col, FunctionOccurrence{Kind: tc.kind, Arity: tc.arity})
+		})
+	}
+
+	// `@doc "..."` sets an attribute; it is not a call of doc/1.
+	if occ, _ := FunctionOccurrenceAt(root, []byte(src), 1, 3); occ.Kind != OccurrencePlain {
+		t.Errorf("@doc: got kind %d, want plain", occ.Kind)
+	}
+	// Go-to-definition asks the variable resolver first: a lone bare call is
+	// not a variable wherever the cursor sits in the name.
+	for _, col := range []uint{4, 5, 7} {
+		if occs := FindVariableOccurrencesWithTree(root, []byte(src), 6, col); len(occs) != 0 {
+			t.Errorf("col %d: bare call read as a variable: %+v", col, occs)
+		}
+	}
+}
+
+// Each defdelegate head keeps its own arity range, also with two heads on one
+// line; a head with defaults accepts a range.
+func TestFunctionOccurrences_DelegateHeads(t *testing.T) {
+	src := []byte(`defmodule MyApp.Facade do
+  defdelegate grab(a, b \\ 1), to: MyApp.Dual
+  defdelegate pick(a), to: MyApp.Dual; defdelegate pick(a, b), to: MyApp.Pair
+end
+`)
+	root, cleanup := parseElixir(src)
+	defer cleanup()
+	grab := FunctionOccurrences(root, src, "grab")
+	if len(grab) != 1 || grab[0].Kind != OccurrenceHead || grab[0].Keyword != "defdelegate" || grab[0].Arity != (Arity{Min: 1, Max: 2, Known: true}) {
+		t.Errorf("grab = %+v, want one defdelegate head /1..2", grab)
+	}
+	pick := FunctionOccurrences(root, src, "pick")
+	if len(pick) != 2 || pick[0].Arity != ExactArity(1) || pick[1].Arity != ExactArity(2) || pick[0].NameLine != pick[1].NameLine {
+		t.Errorf("pick = %+v, want heads /1 and /2 on one line", pick)
+	}
+}
diff --git a/internal/treesitter/owners.go b/internal/treesitter/owners.go
new file mode 100644
index 0000000..7f478c1
--- /dev/null
+++ b/internal/treesitter/owners.go
@@ -0,0 +1,297 @@
+package treesitter
+
+import (
+	"strings"
+
+	tree_sitter "github.com/tree-sitter/go-tree-sitter"
+)
+
+// Owner is the lexical block that owns a call in the call hierarchy: a
+// def-family clause, or an ExUnit test, setup or setup_all block. Other blocks
+// (describe, if, case, for, with, fn, ...) are transparent.
+type Owner struct {
+	// Module is the Elixir name of the enclosing module, with nested
+	// defmodule names prefixed by their parent's and Elixir.-prefixed names
+	// taken as absolute.
+	Module string
+	// Keyword is def, defp, defmacro, defmacrop, defguard, defguardp, test,
+	// setup or setup_all.
+	Keyword string
+	// Name is the function name, the test label as written (with its
+	// quotes), or empty for a setup block.
+	Name string
+	// Arity is the head's arity range for a def-family clause and unknown
+	// for a test or setup block.
+	Arity Arity
+	// Start and End span the owner's call; NameStart and NameEnd span its
+	// function name, test label or setup keyword. Rows are 0-based and
+	// columns are 0-based bytes.
+	Start, End, NameStart, NameEnd tree_sitter.Point
+
+	node *tree_sitter.Node
+}
+
+// IsFunction reports whether the owner is a def-family clause.
+func (o Owner) IsFunction() bool { return functionOwnerKeywords[o.Keyword] }
+
+var functionOwnerKeywords = map[string]bool{
+	"def": true, "defp": true, "defmacro": true, "defmacrop": true,
+	"defguard": true, "defguardp": true,
+}
+
+var blockOwnerKeywords = map[string]bool{"test": true, "setup": true, "setup_all": true}
+
+// Source is one parsed Elixir file for ownership questions.
+type Source struct {
+	root    *tree_sitter.Node
+	src     []byte
+	cleanup func()
+}
+
+// ParseSource parses src. ok is false when the file does not parse cleanly:
+// a tree recovered from a syntax error can put a call in the wrong block.
+func ParseSource(src []byte) (*Source, bool) {
+	root, cleanup := parseElixir(src)
+	if root == nil {
+		return nil, false
+	}
+	if root.HasError() {
+		cleanup()
+		return nil, false
+	}
+	return &Source{root: root, src: src, cleanup: cleanup}, true
+}
+
+// Close releases the syntax tree.
+func (s *Source) Close() { s.cleanup() }
+
+// CallOwner classifies the call whose function name starts at line:col and
+// returns its owner. ok is false when no call of name starts there, and when
+// the call has no owner an item can name: top level, module body, a quote
+// body, or a module, function or test label that only exists at compile time.
+func (s *Source) CallOwner(line, col uint, name string) (FunctionOccurrence, Owner, bool) {
+	ident := nodeAtPosition(s.root, line, col)
+	if ident == nil || ident.Kind() != "identifier" || ident.StartPosition() != (tree_sitter.Point{Row: line, Column: col}) {
+		return FunctionOccurrence{}, Owner{}, false
+	}
+	occ := classifyWithScope(s.root, ident, s.src)
+	if occ.Kind != OccurrenceCall || occ.Name != name {
+		return FunctionOccurrence{}, Owner{}, false
+	}
+	for n := ident.Parent(); n != nil; n = n.Parent() {
+		if n.Kind() != "call" || calledBy(n, ident) {
+			continue
+		}
+		keyword := bareCallName(n, s.src)
+		if keyword == "quote" {
+			return FunctionOccurrence{}, Owner{}, false
+		}
+		if !s.ownsBody(n, keyword) {
+			continue
+		}
+		owner, ok := s.owner(n, keyword)
+		return occ, owner, ok
+	}
+	return FunctionOccurrence{}, Owner{}, false
+}
+
+// Clauses returns the def-family clauses of module.name, in source order,
+// whose head accepts arity. An unknown arity accepts every clause.
+func (s *Source) Clauses(module, name string, arity Arity) []Owner {
+	var clauses []Owner
+	var walk func(n *tree_sitter.Node)
+	walk = func(n *tree_sitter.Node) {
+		if n.Kind() == "call" {
+			switch keyword := bareCallName(n, s.src); {
+			case keyword == "quote":
+				return
+			case functionOwnerKeywords[keyword]:
+				clause, ok := s.owner(n, keyword)
+				if ok && clause.Name == name && clause.Module == module && (!arity.Known || clause.Arity.Matches(arity.Min)) {
+					clauses = append(clauses, clause)
+				}
+				return
+			}
+		}
+		for i := uint(0); i < n.NamedChildCount(); i++ {
+			walk(n.NamedChild(i))
+		}
+	}
+	walk(s.root)
+	return clauses
+}
+
+// Calls returns the call occurrences inside a clause, in source order: its
+// body, guard and default arguments, but not quote bodies.
+func (s *Source) Calls(clause Owner) []FunctionOccurrence {
+	var calls []FunctionOccurrence
+	var walk func(n *tree_sitter.Node)
+	walk = func(n *tree_sitter.Node) {
+		switch n.Kind() {
+		case "call":
+			if bareCallName(n, s.src) == "quote" {
+				return
+			}
+		case "identifier":
+			if occ := classifyWithScope(s.root, n, s.src); occ.Kind == OccurrenceCall {
+				calls = append(calls, occ)
+			}
+			return
+		}
+		for i := uint(0); i < n.NamedChildCount(); i++ {
+			walk(n.NamedChild(i))
+		}
+	}
+	// The clause's own def keyword is its target, not a call it makes.
+	if args := childOfKind(clause.node, "arguments"); args != nil {
+		walk(args)
+	}
+	if block := childOfKind(clause.node, "do_block"); block != nil {
+		walk(block)
+	}
+	return calls
+}
+
+// ownsBody reports whether a call owns the calls in its body: a def-family
+// clause, or a test or setup block with a body.
+func (s *Source) ownsBody(call *tree_sitter.Node, keyword string) bool {
+	return functionOwnerKeywords[keyword] || blockOwnerKeywords[keyword] && hasBody(call, s.src)
+}
+
+// owner builds the owner for a def-family or test/setup call. ok is false
+// when its module, function name or test label is not static.
+func (s *Source) owner(call *tree_sitter.Node, keyword string) (Owner, bool) {
+	module, ok := s.enclosingModule(call)
+	if !ok {
+		return Owner{}, false
+	}
+	o := Owner{Module: module, Keyword: keyword, Start: call.StartPosition(), End: call.EndPosition(), node: call}
+	var name *tree_sitter.Node
+	switch {
+	case functionOwnerKeywords[keyword]:
+		name = s.headName(call)
+		if name == nil {
+			return Owner{}, false
+		}
+		head := classifyFunctionName(name, s.src)
+		if head.Kind != OccurrenceHead {
+			return Owner{}, false
+		}
+		o.Name, o.Arity = head.Name, head.Arity
+	case keyword == "test":
+		name = firstArgument(call)
+		if name == nil || name.Kind() != "string" || childOfKind(name, "interpolation") != nil {
+			return Owner{}, false
+		}
+		o.Name = name.Utf8Text(s.src)
+	default:
+		name = call.ChildByFieldName("target")
+	}
+	o.NameStart, o.NameEnd = name.StartPosition(), name.EndPosition()
+	return o, true
+}
+
+// headName returns the function-name identifier of a def-family call, or
+// nil for a head whose name is built at compile time (unquote) or an
+// operator definition.
+func (s *Source) headName(call *tree_sitter.Node) *tree_sitter.Node {
+	head := firstArgument(call)
+	if head != nil && head.Kind() == "binary_operator" && operatorText(head, s.src) == "when" {
+		head = head.ChildByFieldName("left")
+	}
+	if head == nil {
+		return nil
+	}
+	switch head.Kind() {
+	case "identifier":
+		return head
+	case "call":
+		if target := head.ChildByFieldName("target"); target != nil && target.Kind() == "identifier" {
+			return target
+		}
+	}
+	return nil
+}
+
+// enclosingModule composes the module name from the defmodule calls around
+// node, as Elixir does. ok is false outside any module, inside defimpl or
+// defprotocol, for a module named by an expression, and inside a quote, whose
+// code lands in whichever module expands it.
+func (s *Source) enclosingModule(node *tree_sitter.Node) (string, bool) {
+	module, absolute := "", false
+	for n := node.Parent(); n != nil; n = n.Parent() {
+		if n.Kind() != "call" {
+			continue
+		}
+		switch bareCallName(n, s.src) {
+		case "defmodule":
+			name := firstArgument(n)
+			if name == nil || name.Kind() != "alias" {
+				return "", false
+			}
+			if absolute {
+				continue
+			}
+			// Walking outwards, each enclosing name goes in front.
+			if module == "" {
+				module = name.Utf8Text(s.src)
+			} else {
+				module = name.Utf8Text(s.src) + "." + module
+			}
+			if strings.HasPrefix(module, "Elixir.") {
+				module, absolute = strings.TrimPrefix(module, "Elixir."), true
+			}
+		case "defimpl", "defprotocol", "quote":
+			return "", false
+		}
+	}
+	return module, module != ""
+}
+
+// calledBy reports whether ident is the name call calls, directly or after a
+// dot, rather than something inside it.
+func calledBy(call, ident *tree_sitter.Node) bool {
+	target := call.ChildByFieldName("target")
+	if sameNode(target, ident) {
+		return true
+	}
+	return target != nil && target.Kind() == "dot" && sameNode(target.ChildByFieldName("right"), ident)
+}
+
+// hasBody reports whether a call has a do block or a do: keyword argument.
+func hasBody(call *tree_sitter.Node, src []byte) bool {
+	if childOfKind(call, "do_block") != nil {
+		return true
+	}
+	args := childOfKind(call, "arguments")
+	if args == nil || args.NamedChildCount() == 0 {
+		return false
+	}
+	keywords := args.NamedChild(args.NamedChildCount() - 1)
+	if keywords.Kind() != "keywords" {
+		return false
+	}
+	for i := uint(0); i < keywords.NamedChildCount(); i++ {
+		if key := keywords.NamedChild(i).ChildByFieldName("key"); key != nil && strings.TrimSpace(key.Utf8Text(src)) == "do:" {
+			return true
+		}
+	}
+	return false
+}
+
+func firstArgument(call *tree_sitter.Node) *tree_sitter.Node {
+	args := childOfKind(call, "arguments")
+	if args == nil {
+		return nil
+	}
+	return firstNamedNonComment(args)
+}
+
+func childOfKind(n *tree_sitter.Node, kind string) *tree_sitter.Node {
+	for i := uint(0); i < n.ChildCount(); i++ {
+		if c := n.Child(i); c.Kind() == kind {
+			return c
+		}
+	}
+	return nil
+}
