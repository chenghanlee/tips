index 0000000..6a4571b
--- /dev/null
+++ b/internal/workspace/nested_checkout_test.go
@@ -0,0 +1,137 @@
+package workspace
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/fsnotify/fsnotify"
+	"go.lsp.dev/protocol"
+	"go.lsp.dev/uri"
+)
+
+type nestedCloneFixture struct {
+	rt                                *Runtime
+	root, parent, clone, foreign, dep string
+}
+
+func newNestedCloneFixture(t *testing.T, preindex bool) nestedCloneFixture {
+	t.Helper()
+	rt, root := newTestRuntime(t)
+	f := nestedCloneFixture{rt: rt, root: root, clone: filepath.Join(root, "tmp", "clone")}
+	f.parent = writeTestModule(t, root, "lib/worker.ex", "SharedLib.Worker")
+	f.foreign = writeTestModule(t, f.clone, "lib/worker.ex", "SharedLib.Worker")
+	f.dep = writeTestModule(t, root, "deps/library/lib/dependency.ex", "SharedLib.Dependency")
+	ctx := testContext(t, 10*time.Second)
+	if err := rt.ReindexPath(ctx, f.parent); err != nil {
+		t.Fatal(err)
+	}
+	if preindex {
+		if err := rt.ReindexPath(ctx, f.foreign); err != nil {
+			t.Fatal(err)
+		}
+		if countModule(t, rt, "SharedLib.Worker") != 2 {
+			t.Fatal("setup did not index both copies")
+		}
+	}
+	for _, dir := range []string{f.clone, filepath.Join(root, "deps", "library")} {
+		if err := os.MkdirAll(filepath.Join(dir, ".git"), 0o700); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return f
+}
+
+func (f nestedCloneFixture) reconcile(ctx context.Context, mode string) error {
+	switch mode {
+	case "full", "sweep":
+		return f.rt.Reindex(ctx)
+	case "single":
+		if err := f.rt.ReindexPath(ctx, f.foreign); err != nil {
+			return err
+		}
+		return f.rt.ReindexPath(ctx, f.dep)
+	case "client":
+		_, session, release := f.rt.AttachLSPSession()
+		defer release()
+		if err := session.DidChangeWatchedFiles(ctx, &protocol.DidChangeWatchedFilesParams{Changes: []*protocol.FileEvent{
+			{URI: uri.File(f.foreign), Type: protocol.FileChangeTypeCreated},
+			{URI: uri.File(f.dep), Type: protocol.FileChangeTypeChanged},
+		}}); err != nil {
+			return err
+		}
+		return f.rt.awaitPath(ctx, f.parent)
+	case "moved-clone":
+		stub := &watchAddStub{failing: map[string]bool{}}
+		watcher, _, _ := newRecordingWatcher(f.root, stub)
+		watcher.onChange = f.rt.ReconcileFile
+		watcher.handle(fsnotify.Event{Name: f.clone, Op: fsnotify.Create})
+		return f.rt.awaitPath(ctx, f.dep)
+	default:
+		if err := f.rt.awaitPath(ctx, f.clone); err != nil {
+			return err
+		}
+		return f.rt.ReindexPath(ctx, f.dep)
+	}
+}
+
+func TestNestedCloneIndexBoundary(t *testing.T) {
+	for _, mode := range []string{"full", "single", "client", "became-clone", "moved-clone", "sweep"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newNestedCloneFixture(t, mode == "became-clone" || mode == "moved-clone" || mode == "sweep")
+			if err := f.reconcile(testContext(t, 10*time.Second), mode); err != nil {
+				t.Fatal(err)
+			}
+			if got := countModule(t, f.rt, "SharedLib.Worker"); got != 1 {
+				t.Fatalf("nested clone poisoned parent answers: %d definitions", got)
+			}
+			if got := countModule(t, f.rt, "SharedLib.Dependency"); got != 1 {
+				t.Fatalf("dependency source lost: %d definitions", got)
+			}
+		})
+	}
+}
+
+func TestFSNotifyNestedClone(t *testing.T) {
+	for _, mode := range []string{"startup", "moved", "git-created"} {
+		t.Run(mode, func(t *testing.T) {
+			assertFSNotifyNestedClone(t, mode)
+		})
+	}
+}
+
+func assertFSNotifyNestedClone(t *testing.T, mode string) {
+	t.Helper()
+	root := t.TempDir()
+	clone := filepath.Join(root, "clone")
+	file := writeTestModule(t, clone, "lib/worker.ex", "SharedLib.Worker")
+	stub := &watchAddStub{failing: map[string]bool{}}
+	w, changed, removed := newRecordingWatcher(root, stub)
+	if mode == "git-created" {
+		w.watchTree(root)
+	}
+	if err := os.Mkdir(filepath.Join(clone, ".git"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	switch mode {
+	case "startup":
+		w.watchTree(root)
+	case "moved":
+		w.handle(fsnotify.Event{Name: clone, Op: fsnotify.Create})
+	case "git-created":
+		w.handle(fsnotify.Event{Name: filepath.Join(clone, ".git"), Op: fsnotify.Create})
+	}
+	if !w.tops.has(clone) {
+		t.Fatal("clone not excluded")
+	}
+	before := len(*changed)
+	w.handle(fsnotify.Event{Name: file, Op: fsnotify.Write})
+	if len(*changed) != before {
+		t.Fatalf("foreign event delivered: %v", *changed)
+	}
+	if mode == "git-created" && (len(*changed) != 1 || (*changed)[0] != clone || len(*removed) == 0) {
+		t.Fatalf("new clone did not remove old rows/watches: changed=%v removed=%v", *changed, *removed)
+	}
+}
