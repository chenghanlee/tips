@@ -0,0 +1,320 @@
+package lsp
+
+import (
+	"context"
+	"path/filepath"
+	"slices"
+	"strconv"
+	"strings"
+	"testing"
+
+	"go.lsp.dev/protocol"
+	"go.lsp.dev/uri"
+)
+
+// A behaviour module like Application declares a callback, offers an ordinary
+// function with the same name and arity, and injects a default through
+// `quote do @behaviour ...; def ... end`. None of those make the behaviour
+// module its own implementor; only modules that declare or use it are.
+const quoteRunnerSource = `defmodule MyApp.Runner do
+  @callback stop(term) :: term
+
+  defmacro __using__(_opts) do
+    quote location: :keep do
+      @behaviour MyApp.Runner
+
+      def stop(_state), do: :ok
+      def helper(value), do: value
+      defoverridable MyApp.Runner
+    end
+  end
+
+  def stop(app), do: {:stopped, app}
+end
+`
+
+const quoteSQLSource = `defmodule MyApp.SQL do
+  def query!(repo, sql, params \\ []), do: {repo, sql, params}
+
+  defmacro __before_compile__(_env) do
+    quote do
+      def query!(sql, params \\ []), do: MyApp.SQL.query!(__MODULE__, sql, params)
+    end
+  end
+end
+`
+
+func setupQuoteFixture(t *testing.T) *Server {
+	t.Helper()
+	server, cleanup := setupTestServer(t)
+	t.Cleanup(cleanup)
+	root := server.projectRoot
+	indexFile(t, server.store, root, "lib/my_app/runner.ex", quoteRunnerSource)
+	indexFile(t, server.store, root, "lib/my_app/sql.ex", quoteSQLSource)
+	indexFile(t, server.store, root, "lib/my_app/declared_runner.ex", `defmodule MyApp.DeclaredRunner do
+  @behaviour MyApp.Runner
+
+  def stop(_state), do: :declared
+end
+`)
+	indexFile(t, server.store, root, "lib/my_app/used_runner.ex", `defmodule MyApp.UsedRunner do
+  use MyApp.Runner
+
+  def stop(_state), do: :used
+end
+`)
+	indexFile(t, server.store, root, "lib/my_app/plain_runner.ex", `defmodule MyApp.PlainRunner do
+  use MyApp.Runner
+end
+`)
+	return server
+}
+
+func locationKeys(root string, locations []protocol.Location) []string {
+	keys := make([]string, 0, len(locations))
+	for _, loc := range locations {
+		rel, _ := filepath.Rel(root, loc.URI.Filename())
+		keys = append(keys, rel+":"+strconv.Itoa(int(loc.Range.Start.Line)+1))
+	}
+	slices.Sort(keys)
+	return keys
+}
+
+func definitionKeys(t *testing.T, server *Server, source string, line int, needle string) []string {
+	t.Helper()
+	path := filepath.Join(server.projectRoot, "lib", "my_app", "caller.ex")
+	callerURI := string(uri.File(path))
+	server.docs.seed(callerURI, source)
+	text := strings.Split(source, "\n")[line]
+	col := strings.Index(text, needle)
+	if col < 0 {
+		t.Fatalf("no %q on line %d: %q", needle, line, text)
+	}
+	return locationKeys(server.projectRoot, definitionAt(t, server, callerURI, uint32(line), uint32(col)))
+}
+
+func TestImplementationExcludesBehaviourModuleAndQuotedTemplate(t *testing.T) {
+	server := setupQuoteFixture(t)
+	runnerURI := string(uri.File(filepath.Join(server.projectRoot, "lib", "my_app", "runner.ex")))
+	server.docs.seed(runnerURI, quoteRunnerSource)
+
+	locations, err := server.Implementation(context.Background(), &protocol.ImplementationParams{
+		TextDocumentPositionParams: protocol.TextDocumentPositionParams{
+			TextDocument: protocol.TextDocumentIdentifier{URI: protocol.DocumentURI(runnerURI)},
+			Position:     protocol.Position{Line: 1, Character: uint32(strings.Index("  @callback stop(term) :: term", "stop"))},
+		},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := locationKeys(server.projectRoot, locations)
+	want := []string{"lib/my_app/declared_runner.ex:4", "lib/my_app/used_runner.ex:4"}
+	if !slices.Equal(got, want) {
+		t.Fatalf("Implementation = %v, want only declared/used implementors %v", got, want)
+	}
+}
+
+func TestQuotedBehaviourDoesNotMakeDefiningModuleAnImplementor(t *testing.T) {
+	server := setupQuoteFixture(t)
+	implementors, err := server.store.LookupBehaviourImplementors("MyApp.Runner")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, impl := range implementors {
+		if impl.Module == "MyApp.Runner" {
+			t.Fatalf("quoted @behaviour filed MyApp.Runner as its own implementor: %v", implementors)
+		}
+	}
+}
+
+func TestQualifiedDefinitionSkipsQuotedTemplateOfSameArity(t *testing.T) {
+	server := setupQuoteFixture(t)
+	const caller = "MyApp.SQL.query!(MyApp.Repo, \"select 1\")\nMyApp.Runner.stop(:app)\n"
+	if got, want := definitionKeys(t, server, caller, 0, "query!"), []string{"lib/my_app/sql.ex:2"}; !slices.Equal(got, want) {
+		t.Errorf("SQL.query!/2 = %v, want real def only %v", got, want)
+	}
+	if got, want := definitionKeys(t, server, caller, 1, "stop"), []string{"lib/my_app/runner.ex:14"}; !slices.Equal(got, want) {
+		t.Errorf("Runner.stop/1 = %v, want ordinary API only %v", got, want)
+	}
+}
+
+func TestUseChainStillResolvesQuotedTemplate(t *testing.T) {
+	server := setupQuoteFixture(t)
+	const caller = "MyApp.PlainRunner.stop(:state)\nMyApp.PlainRunner.helper(1)\nMyApp.Runner.helper(1)\n"
+	if got, want := definitionKeys(t, server, caller, 0, "stop"), []string{"lib/my_app/runner.ex:8"}; !slices.Equal(got, want) {
+		t.Errorf("PlainRunner.stop/1 = %v, want injected template %v", got, want)
+	}
+	if got, want := definitionKeys(t, server, caller, 1, "helper"), []string{"lib/my_app/runner.ex:9"}; !slices.Equal(got, want) {
+		t.Errorf("PlainRunner.helper/1 = %v, want injected template %v", got, want)
+	}
+	// helper exists only in the quote, so the provider itself has no helper.
+	if got := definitionKeys(t, server, caller, 2, "helper"); len(got) != 0 {
+		t.Errorf("Runner.helper/1 = %v, want empty for a quote-only function", got)
+	}
+}
+
+func TestQualifiedDefinitionUnknownFunctionIsEmpty(t *testing.T) {
+	server := setupQuoteFixture(t)
+	indexAndCompile(t, server, "MyApp.GenRepo", "lib/my_app/gen_repo.ex",
+		"defmodule MyApp.GenRepo do\n  use SharedLib.Repo\nend\n", beamExport{"query!", 2})
+	bumpDirMtime(t, filepath.Join(server.projectRoot, "_build", "dev", "lib", "my_app", "ebin"))
+
+	const caller = "MyApp.PlainRunner.nonexistent_zz(1)\nMyApp.PlainRunner\nMyApp.GenRepo.query!(\"x\", [])\n" +
+		"MyApp.Runner.stop(:a, :b)\nMyApp.GenRepo.query!(\"x\", [], [])\n"
+	if got := definitionKeys(t, server, caller, 0, "nonexistent_zz"); len(got) != 0 {
+		t.Errorf("unknown qualified function = %v, want empty", got)
+	}
+	if got := definitionKeys(t, server, caller, 3, "stop"); len(got) != 0 {
+		t.Errorf("source function at unknown arity = %v, want empty", got)
+	}
+	if got := definitionKeys(t, server, caller, 4, "query!"); len(got) != 0 {
+		t.Errorf("generated export at unknown arity = %v, want empty", got)
+	}
+	if got, want := definitionKeys(t, server, caller, 1, "PlainRunner"), []string{"lib/my_app/plain_runner.ex:1"}; !slices.Equal(got, want) {
+		t.Errorf("module name = %v, want %v", got, want)
+	}
+	if got, want := definitionKeys(t, server, caller, 2, "query!"), []string{"lib/my_app/gen_repo.ex:1"}; !slices.Equal(got, want) {
+		t.Errorf("BEAM-verified generated export = %v, want module anchor %v", got, want)
+	}
+}
+
+// Ecto.Repo injects insert!/2 through `quote bind_quoted: ... do`. Omitting
+// quoted rows from the provider's index must keep that template as the target
+// of a consumer's call, for Definition and for outgoing calls, with a range
+// that contains the selected name.
+func TestQuotedProviderTargetKeptForConsumerCalls(t *testing.T) {
+	server, cleanup := setupTestServer(t)
+	t.Cleanup(cleanup)
+	root := server.projectRoot
+	indexFile(t, server.store, root, "lib/my_app/repo_base.ex", `defmodule MyApp.RepoBase do
+  defmacro __using__(opts) do
+    quote bind_quoted: [opts: opts] do
+      @otp_app opts[:otp_app]
+
+      def insert!(struct, opts \\ []) do
+        MyApp.RepoBase.Schema.insert!(__MODULE__, struct, opts)
+      end
+    end
+  end
+end
+`)
+	indexFile(t, server.store, root, "lib/my_app/repo.ex", `defmodule MyApp.Repo do
+  use MyApp.RepoBase, otp_app: :my_app
+end
+`)
+	const accounts = `defmodule MyApp.Accounts do
+  def save(user), do: MyApp.Repo.insert!(user)
+end
+`
+	indexFile(t, server.store, root, "lib/my_app/accounts.ex", accounts)
+	accountsURI := uri.File(filepath.Join(root, "lib", "my_app", "accounts.ex"))
+	server.docs.seed(string(accountsURI), accounts)
+
+	const want = "lib/my_app/repo_base.ex:6"
+	callLine := strings.Split(accounts, "\n")[1]
+	if got := locationKeys(root, definitionAt(t, server, string(accountsURI), 1, uint32(strings.Index(callLine, "insert!")))); !slices.Equal(got, []string{want}) {
+		t.Errorf("Definition MyApp.Repo.insert! = %v, want template %s", got, want)
+	}
+
+	items, err := server.PrepareCallHierarchy(context.Background(), &protocol.CallHierarchyPrepareParams{
+		TextDocumentPositionParams: protocol.TextDocumentPositionParams{
+			TextDocument: protocol.TextDocumentIdentifier{URI: accountsURI},
+			Position:     protocol.Position{Line: 1, Character: 6},
+		},
+	})
+	if err != nil || len(items) != 1 {
+		t.Fatalf("prepare save/1 = %v, %v", items, err)
+	}
+	calls, err := server.OutgoingCalls(context.Background(), &protocol.CallHierarchyOutgoingCallsParams{Item: items[0]})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var found bool
+	for _, call := range calls {
+		if !strings.Contains(call.To.Name, "insert!") {
+			continue
+		}
+		found = true
+		to := call.To
+		key := locationKeys(root, []protocol.Location{{URI: to.URI, Range: to.SelectionRange}})
+		if !slices.Equal(key, []string{want}) {
+			t.Errorf("outgoing insert! selection at %v, want %s", key, want)
+		}
+		sel, rng := to.SelectionRange, to.Range
+		const line = `      def insert!(struct, opts \\ []) do`
+		if name := line[sel.Start.Character:min(int(sel.End.Character), len(line))]; name != "insert!" {
+			t.Errorf("outgoing insert! selection text %q (%v), want insert!", name, sel)
+		}
+		if rng.Start.Line > sel.Start.Line || (rng.Start.Line == sel.Start.Line && rng.Start.Character > sel.Start.Character) ||
+			rng.End.Line < sel.End.Line || (rng.End.Line == sel.End.Line && rng.End.Character < sel.End.Character) {
+			t.Errorf("outgoing insert! range %v does not contain selection %v", rng, sel)
+		}
+	}
+	if !found {
+		t.Fatalf("outgoing calls from save/1 = %+v, want MyApp.Repo.insert!", calls)
+	}
+}
+
+// Plug.Router formats quote options across lines (`quote bind_quoted: [...]
+// do`), and small macros open the quote on their own head line (`defmacro
+// ..., do: quote do`). Both quote bodies are templates; the definitions after
+// them are real.
+func TestQuoteBlockFoundAcrossOptionLinesAndHeadLines(t *testing.T) {
+	server, cleanup := setupTestServer(t)
+	t.Cleanup(cleanup)
+	indexFile(t, server.store, server.projectRoot, "lib/my_app/router_base.ex", `defmodule MyApp.RouterBase do
+  defmacro __using__(opts) do
+    quote bind_quoted: [
+            opts: Keyword.merge(opts, [
+              plug: true
+            ])
+          ] do
+      def injected(conn, opts), do: {conn, opts}
+    end
+  end
+
+  def real(conn), do: conn
+end
+`)
+	indexFile(t, server.store, server.projectRoot, "lib/my_app/inline_base.ex", `defmodule MyApp.InlineBase do
+  defmacro __using__(_opts), do: quote do
+    def inline_injected, do: :ok
+  end
+
+  def inline_real, do: :ok
+
+  @ast quote do
+    def attr_injected, do: :ok
+  end
+
+  def attr_real, do: :ok
+
+  defp wrap(x), do: quote(do: unquote(x))
+  def after_quote(conn) do
+    conn
+  end
+end
+`)
+	const caller = "MyApp.RouterBase.injected(conn, [])\nMyApp.RouterBase.real(conn)\n" +
+		"MyApp.InlineBase.inline_injected()\nMyApp.InlineBase.inline_real()\n" +
+		"MyApp.InlineBase.attr_injected()\nMyApp.InlineBase.attr_real()\nMyApp.InlineBase.after_quote(conn)\n"
+	for _, tc := range []struct {
+		line   int
+		needle string
+		want   []string
+	}{
+		{0, "injected", nil},
+		{1, "real", []string{"lib/my_app/router_base.ex:12"}},
+		{2, "inline_injected", nil},
+		{3, "inline_real", []string{"lib/my_app/inline_base.ex:6"}},
+		{4, "attr_injected", nil},
+		{5, "attr_real", []string{"lib/my_app/inline_base.ex:12"}},
+		// A quote without a block must not claim the next statement's do.
+		{6, "after_quote", []string{"lib/my_app/inline_base.ex:15"}},
+	} {
+		got := definitionKeys(t, server, caller, tc.line, tc.needle)
+		if len(got) != len(tc.want) || (len(got) > 0 && !slices.Equal(got, tc.want)) {
+			t.Errorf("Definition %s = %v, want %v", strings.Split(caller, "\n")[tc.line], got, tc.want)
+		}
+	}
+}
