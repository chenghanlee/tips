+func TestArity_NonASCIIBeforeCallsUsesUTF16Columns(t *testing.T) {
+	server, cleanup := setupTestServer(t)
+	defer cleanup()
+	root := server.projectRoot
+
+	const file = "lib/my_app/label.ex"
+	indexFile(t, server.store, root, file, arityLabelSrc)
+	uri := "file://" + filepath.Join(root, file)
+	site := aritySite{file, `{"São Tomé 🎉, ok", label(x, "é, ü"), label(x, "🎉", :c)}`}
+	line := site.line(t)
+	text := strings.Split(arityLabelSrc, "\n")[line]
+
+	for _, tc := range []struct{ name, call, head string }{
+		{"/2", `label(x, "é, ü")`, "def label(a, b), do: {a, b}"},
+		{"/3", `label(x, "🎉", :c)`, "def label(a, b, c), do: {a, b, c}"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			start := utf16Col(text, tc.call)
+			if start == byteCol(text, tc.call) {
+				t.Fatalf("UTF-16 and byte columns must differ before %q", tc.call)
+			}
+			// The client sends UTF-16 columns.
+			got := arityLocKeys(root, definitionAt(t, server, uri, line, start+1))
+			if want := aritySiteKeys(t, aritySite{file, tc.head}); !sameKeys(got, want) {
+				t.Errorf("definition = %v, want %v", got, want)
+			}
+
+			_, hl, hc := arityAt{aritySite{file, tc.head}, "label", 1}.resolve(t, root)
+			locs := arityReferences(t, server, uri, hl, hc, false)
+			if got, want := arityLocKeys(root, locs), aritySiteKeys(t, site); !sameKeys(got, want) {
+				t.Fatalf("references = %v, want %v", got, want)
+			}
+			r := locs[0].Range
+			if r.Start.Character != start || sliceUTF16(text, r.Start.Character, r.End.Character) != "label" {
+				t.Errorf("reference range [%d,%d) reads %q, want %q at %d",
+					r.Start.Character, r.End.Character, sliceUTF16(text, r.Start.Character, r.End.Character), "label", start)
+			}
+		})
+	}
