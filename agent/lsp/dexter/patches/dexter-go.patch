diff --git a/internal/workspace/saved_file_sync_test.go b/internal/workspace/saved_file_sync_test.go
new file mode 100644
index 0000000..c59dde2
--- /dev/null
+++ b/internal/workspace/saved_file_sync_test.go
@@ -0,0 +1,163 @@
+package workspace
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"go.lsp.dev/protocol"
+	"go.lsp.dev/uri"
+
+	"github.com/remoteoss/dexter/internal/lsp"
+)
+
+const (
+	syncRepo = "defmodule SharedLib.Repo do\n  def fetch(id), do: id\nend\n"
+	// syncWorker is what an agent's native edit leaves on disk and sends in
+	// didChange; syncFormatted is the same file after a formatter or generator
+	// rewrote it with no further didChange, moving the call down two lines.
+	syncWorker    = "defmodule SharedLib.Worker do\n  def run(id) do\n    SharedLib.Repo.fetch(id)\n  end\nend\n"
+	syncFormatted = "defmodule SharedLib.Worker do\n  @moduledoc false\n\n  def run(id) do\n    SharedLib.Repo.fetch(id)\n  end\nend\n"
+	// syncUnsaved is an editor buffer with an edit that was never saved.
+	syncUnsaved = "defmodule SharedLib.Worker do\n  # unsaved\n  def run(id) do\n    SharedLib.Repo.fetch(id)\n  end\nend\n"
+)
+
+// A buffer that matched the file when the editor last sent it follows later
+// disk rewrites, and so does a disk-loaded entry that no editor opened; a
+// buffer with unsaved edits keeps them. Each session keeps its own view.
+func TestDocumentsFollowSavedFilesAndKeepUnsavedBuffers(t *testing.T) {
+	rt, root := newTestRuntime(t)
+	repo := writeSyncFile(t, root, "lib/repo.ex", syncRepo)
+	worker := writeSyncFile(t, root, "lib/worker.ex", syncWorker)
+	if err := rt.Reindex(testContext(t, 30*time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	workerURI := string(uri.File(worker))
+	wantRepo := string(uri.File(repo))
+
+	_, saved, releaseSaved := rt.AttachLSPSession()
+	defer releaseSaved()
+	_, unsaved, releaseUnsaved := rt.AttachLSPSession()
+	defer releaseUnsaved()
+	headless := rt.LanguageServices()
+
+	didOpen(t, saved, workerURI, syncWorker)
+	didOpen(t, unsaved, workerURI, syncWorker)
+	didChange(t, unsaved, workerURI, syncUnsaved)
+	expectFetchDefinition(t, "headless before the rewrite", headless, workerURI, syncWorker, wantRepo)
+	expectFetchDefinition(t, "saved buffer before the rewrite", saved, workerURI, syncWorker, wantRepo)
+
+	rewriteSyncFile(t, worker, syncFormatted)
+	if err := rt.ReindexPath(testContext(t, 30*time.Second), worker); err != nil {
+		t.Fatal(err)
+	}
+
+	// Result files are read through the session's open buffers as well.
+	refs, err := saved.References(context.Background(), &protocol.ReferenceParams{
+		TextDocumentPositionParams: protocol.TextDocumentPositionParams{
+			TextDocument: protocol.TextDocumentIdentifier{URI: protocol.DocumentURI(wantRepo)},
+			Position:     protocol.Position{Line: 1, Character: uint32(strings.Index(syncRepo, "fetch") - strings.Index(syncRepo, "\n") - 1)},
+		},
+	})
+	callLine, callCol := fetchPosition(t, syncFormatted)
+	if err != nil || len(refs) != 1 || string(refs[0].URI) != workerURI || refs[0].Range.Start != (protocol.Position{Line: callLine, Character: callCol}) {
+		t.Fatalf("saved buffer references after the rewrite = %v, %v; want %s at %d:%d", refs, err, workerURI, callLine, callCol)
+	}
+
+	expectFetchDefinition(t, "saved buffer after the rewrite", saved, workerURI, syncFormatted, wantRepo)
+	expectFetchDefinition(t, "headless after the rewrite", headless, workerURI, syncFormatted, wantRepo)
+	expectFetchDefinition(t, "unsaved buffer after the rewrite", unsaved, workerURI, syncUnsaved, wantRepo)
+
+	// A disk-loaded entry must not outlive its file.
+	if err := os.Remove(worker); err != nil {
+		t.Fatal(err)
+	}
+	line, col := fetchPosition(t, syncFormatted)
+	if got := definition(t, headless, workerURI, line, col); len(got) != 0 {
+		t.Fatalf("headless answered from a deleted file: %v", got)
+	}
+}
+
+func writeSyncFile(t *testing.T, root, relative, text string) string {
+	t.Helper()
+	path := filepath.Join(root, relative)
+	if err := os.MkdirAll(filepath.Dir(path), 0o750); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, []byte(text), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+// rewriteSyncFile replaces path the way formatters and generators do: write a
+// sibling, then rename it over the original.
+func rewriteSyncFile(t *testing.T, path, text string) {
+	t.Helper()
+	tmp := path + ".tmp"
+	if err := os.WriteFile(tmp, []byte(text), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Rename(tmp, path); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func didOpen(t *testing.T, s *lsp.Server, docURI, text string) {
+	t.Helper()
+	if err := s.DidOpen(context.Background(), &protocol.DidOpenTextDocumentParams{
+		TextDocument: protocol.TextDocumentItem{URI: protocol.DocumentURI(docURI), LanguageID: "elixir", Version: 1, Text: text},
+	}); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func didChange(t *testing.T, s *lsp.Server, docURI, text string) {
+	t.Helper()
+	if err := s.DidChange(context.Background(), &protocol.DidChangeTextDocumentParams{
+		TextDocument:   protocol.VersionedTextDocumentIdentifier{TextDocumentIdentifier: protocol.TextDocumentIdentifier{URI: protocol.DocumentURI(docURI)}, Version: 2},
+		ContentChanges: []protocol.TextDocumentContentChangeEvent{{Text: text}},
+	}); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// fetchPosition is where `fetch` sits in text, as a zero-based LSP position.
+func fetchPosition(t *testing.T, text string) (line, col uint32) {
+	t.Helper()
+	for i, l := range strings.Split(text, "\n") {
+		if c := strings.Index(l, "fetch("); c >= 0 {
+			return uint32(i), uint32(c)
+		}
+	}
+	t.Fatalf("no fetch call in %q", text)
+	return 0, 0
+}
+
+func definition(t *testing.T, s *lsp.Server, docURI string, line, col uint32) []protocol.Location {
+	t.Helper()
+	got, err := s.Definition(context.Background(), &protocol.DefinitionParams{
+		TextDocumentPositionParams: protocol.TextDocumentPositionParams{
+			TextDocument: protocol.TextDocumentIdentifier{URI: protocol.DocumentURI(docURI)},
+			Position:     protocol.Position{Line: line, Character: col},
+		},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return got
+}
+
+// expectFetchDefinition asks for the definition of the fetch call at its
+// position in view, the text the caller believes the document holds.
+func expectFetchDefinition(t *testing.T, label string, s *lsp.Server, docURI, view, wantURI string) {
+	t.Helper()
+	line, col := fetchPosition(t, view)
+	got := definition(t, s, docURI, line, col)
+	if len(got) != 1 || string(got[0].URI) != wantURI || got[0].Range.Start.Line != 1 {
+		t.Fatalf("%s: definition at %d:%d = %v, want %s line 1", label, line, col, got, wantURI)
+	}
+}
diff --git a/query_integration_test.go b/query_integration_test.go
new file mode 100644
index 0000000..9749bf5
--- /dev/null
+++ b/query_integration_test.go
@@ -0,0 +1,376 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+	"unicode/utf16"
+
+	"github.com/remoteoss/dexter/internal/daemon"
+	"github.com/remoteoss/dexter/internal/lsptest"
+)
+
+// This milestone drives the shipped command against real, independent daemon
+// workspaces. The same symbol names deliberately exist in both checkouts.
+func TestQuery_WorktreeIsolationAndLSPHandlers(t *testing.T) {
+	binary := buildDexter(t)
+	root := t.TempDir()
+	writeQueryFixture(t, root)
+	queryGit(t, root, "init", "-q")
+	queryGit(t, root, "add", ".")
+	queryGit(t, root, "-c", "user.name=Test", "-c", "user.email=test@example.invalid", "commit", "-qm", "fixture")
+	leaf := filepath.Join(t.TempDir(), "leaf")
+	queryGit(t, root, "worktree", "add", "-qb", "leaf", leaf)
+	roots := []string{root, leaf}
+	for _, workspace := range roots {
+		t.Cleanup(func() { stopQueryDaemon(t, workspace) })
+	}
+
+	assertColdDefinitions(t, binary, roots)
+
+	clients := make([]*lsptest.Client, len(roots))
+	for i, workspace := range roots {
+		client, err := lsptest.Start(binary, workspace, nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		clients[i] = client
+		t.Cleanup(client.Close)
+		assertQueryDefinitionMatchesNative(t, binary, workspace, client)
+	}
+
+	for _, operation := range []struct {
+		name string
+		args []string
+		want string
+	}{
+		{"references", []string{"lib/worker.ex", "5", "7"}, "worker.ex"},
+		{"hover", []string{"lib/worker.ex", "6", "47"}, "two arguments"},
+		{"symbols", []string{"lib/worker.ex"}, "SharedLib.Worker"},
+		{"workspace-symbols", []string{"SharedLib.Worker"}, "SharedLib.Worker"},
+		{"implementation", []string{"lib/worker.ex", "10", "13"}, "worker.ex"},
+		{"prepare-call-hierarchy", []string{"lib/worker.ex", "6", "47"}, "SharedLib.Worker.fetch/"},
+		{"incoming-calls", []string{"lib/worker.ex", "6", "47"}, "SharedLib.Worker.run/1"},
+		{"outgoing-calls", []string{"lib/worker.ex", "6", "7"}, "SharedLib.Worker.fetch"},
+	} {
+		t.Run(operation.name, func(t *testing.T) {
+			raw, err := runQuery(binary, root, operation.name, operation.args...)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !json.Valid(raw) || !strings.Contains(string(raw), operation.want) || strings.Contains(string(raw), leaf) {
+				t.Fatalf("%s = %s", operation.name, raw)
+			}
+		})
+	}
+
+	// Closing the first editor releases only its session. The second daemon
+	// remains usable even after the first workspace is explicitly stopped.
+	clients[0].Close()
+	stopQueryDaemon(t, root)
+	raw, err := runQuery(binary, leaf, "definition", "lib/worker.ex", "6", "47")
+	if err != nil || !strings.Contains(string(raw), leaf) {
+		t.Fatalf("second workspace after disconnect and shutdown = %s, %v", raw, err)
+	}
+}
+
+func TestQuery_RejectsWrongRootsFilesAndWrites(t *testing.T) {
+	binary := buildDexter(t)
+	root := t.TempDir()
+	writeQueryFixture(t, root)
+	t.Cleanup(func() { stopQueryDaemon(t, root) })
+	other := t.TempDir()
+	writeQueryFixture(t, other)
+	for _, test := range []struct {
+		name string
+		root string
+		args []string
+	}{
+		{"subdirectory-root", filepath.Join(root, "lib"), []string{"definition", "worker.ex", "6", "47"}},
+		{"outside-file", root, []string{"definition", filepath.Join(other, "lib", "worker.ex"), "6", "47"}},
+		{"zero-position", root, []string{"definition", "lib/worker.ex", "0", "1"}},
+		{"write-operation", root, []string{"rename", "lib/worker.ex", "6", "47"}},
+		{"non-project", t.TempDir(), []string{"workspace-symbols", "SharedLib"}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			assertCommandRefused(t, binary, append([]string{"--root", test.root, "query"}, test.args...), "")
+		})
+	}
+}
+
+func TestQuery_RepeatedSavedFileReads(t *testing.T) {
+	binary := buildDexter(t)
+	root := t.TempDir()
+	writeQueryFixture(t, root)
+	t.Cleanup(func() { stopQueryDaemon(t, root) })
+	first, err := runQuery(binary, root, "hover", "lib/worker.ex", "6", "47")
+	if err != nil || !strings.Contains(string(first), "two arguments") {
+		t.Fatalf("initial hover = %s, %v", first, err)
+	}
+	path := filepath.Join(root, "lib", "worker.ex")
+	text, err := os.ReadFile(path) // #nosec G304 -- test-owned fixture path
+	if err != nil {
+		t.Fatal(err)
+	}
+	updated := bytes.Replace(text, []byte("two arguments"), []byte("updated saved documentation"), 1)
+	temporary := path + ".new"
+	if err := os.WriteFile(temporary, updated, 0o600); err != nil { // #nosec G703 -- atomic save of a test-owned fixture
+		t.Fatal(err)
+	}
+	if err := os.Rename(temporary, path); err != nil {
+		t.Fatal(err)
+	}
+	second, err := runQuery(binary, root, "hover", "lib/worker.ex", "6", "47")
+	if err != nil || !strings.Contains(string(second), "updated saved documentation") {
+		t.Fatalf("hover after atomic save in the same daemon = %s, %v", second, err)
+	}
+}
+
+func TestQuery_LibraryNavigation(t *testing.T) {
+	binary := buildDexter(t)
+	root, stdlib := t.TempDir(), t.TempDir()
+	writeQueryFixture(t, root)
+	t.Setenv("DEXTER_ELIXIR_LIB_ROOT", stdlib)
+	dependency := filepath.Join(root, "deps", "sample")
+	if err := os.MkdirAll(filepath.Join(dependency, ".git"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	files := map[string]string{
+		filepath.Join(dependency, "worker.ex"): "SharedLib.Dependency",
+		filepath.Join(stdlib, "sample.ex"):     "SharedLib.Standard",
+	}
+	for path, name := range files {
+		if err := os.WriteFile(path, []byte("defmodule "+name+" do\n  def run, do: :ok\nend\n"), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	t.Cleanup(func() { stopQueryDaemon(t, root) })
+	for path, name := range files {
+		raw, err := runQuery(binary, root, "symbols", path)
+		if err != nil || !strings.Contains(string(raw), name) {
+			t.Fatalf("library query %s = %s, %v", path, raw, err)
+		}
+	}
+	client, err := lsptest.Start(binary, root, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	for path, name := range files {
+		raw, err := client.Request("textDocument/documentSymbol", map[string]any{"textDocument": map[string]any{"uri": lsptest.URI(path)}})
+		if err != nil || !strings.Contains(string(raw), name) {
+			t.Fatalf("native library query %s = %s, %v", path, raw, err)
+		}
+	}
+}
+
+func TestQuery_NativeExactRootAdmission(t *testing.T) {
+	binary := buildDexter(t)
+	root := t.TempDir()
+	writeQueryFixture(t, root)
+	other := t.TempDir()
+	writeQueryFixture(t, other)
+	for _, test := range []struct {
+		name string
+		args []string
+	}{
+		{"subdirectory", []string{"--root", filepath.Join(root, "lib"), "lsp", filepath.Join(root, "lib")}},
+		{"conflicting-path", []string{"--root", root, "lsp", other}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			assertCommandRefused(t, binary, test.args, "")
+		})
+	}
+	client, err := lsptest.Start(binary, root, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	t.Cleanup(func() { stopQueryDaemon(t, root) })
+	if _, err := client.Request("initialize", map[string]any{"rootUri": lsptest.URI(filepath.Join(root, "lib"))}); err == nil {
+		t.Fatal("native initialize accepted a descendant of the exact daemon root")
+	}
+	if _, err := client.Request("initialize", map[string]any{
+		"rootUri":          lsptest.URI(other),
+		"workspaceFolders": []map[string]any{{"uri": lsptest.URI(root), "name": "fixture"}},
+	}); err == nil {
+		t.Fatal("native initialize ignored a conflicting rootUri when workspaceFolders matched")
+	}
+	if _, err := client.Request("textDocument/definition", map[string]any{
+		"textDocument": map[string]any{"uri": lsptest.URI(filepath.Join(other, "lib", "worker.ex"))},
+		"position":     map[string]any{"line": 5, "character": 46},
+	}); err == nil {
+		t.Fatal("native request accepted a file from another checkout")
+	}
+	client.Close()
+	stopQueryDaemon(t, root)
+	assertQueryParentRefused(t, binary, root)
+}
+
+func assertQueryParentRefused(t *testing.T, binary, root string) {
+	t.Helper()
+	alias := filepath.Join(t.TempDir(), "alias")
+	if err := os.Symlink(root, alias); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { stopQueryDaemon(t, alias) })
+	for _, marker := range []string{"directory", "linked-file"} {
+		t.Run(marker, func(t *testing.T) {
+			nested := filepath.Join(root, "nested")
+			if err := os.MkdirAll(nested, 0o700); err != nil {
+				t.Fatal(err)
+			}
+			git := filepath.Join(nested, ".git")
+			if marker == "directory" {
+				if err := os.Mkdir(git, 0o700); err != nil {
+					t.Fatal(err)
+				}
+			} else if err := os.WriteFile(git, []byte("gitdir: /missing/worktrees/leaf\n"), 0o600); err != nil {
+				t.Fatal(err)
+			}
+			defer func() { _ = os.RemoveAll(nested) }()
+			for _, args := range [][]string{{"--root", root, "query", "workspace-symbols"}, {"--root", root, "lsp", root}, {"--root", alias, "query", "workspace-symbols"}, {"--root", alias, "lsp", alias}} {
+				assertCommandRefused(t, binary, args, "nested checkout")
+			}
+		})
+	}
+}
+
+func assertCommandRefused(t *testing.T, binary string, args []string, message string) {
+	t.Helper()
+	cmd := exec.CommandContext(t.Context(), binary, args...) // #nosec G204 -- test-owned binary and fixture arguments
+	cmd.Env = append(os.Environ(), "DEXTER_DAEMON_IDLE_TIMEOUT=1s")
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout, cmd.Stderr = &stdout, &stderr
+	if err := cmd.Run(); err == nil || stdout.Len() != 0 || stderr.Len() == 0 || !strings.Contains(stderr.String(), message) {
+		t.Fatalf("command %v must fail with stderr and empty stdout: err=%v out=%q stderr=%q", args, err, stdout.String(), stderr.String())
+	}
+}
+
+func assertColdDefinitions(t *testing.T, binary string, roots []string) {
+	t.Helper()
+	// The very first requests race cold daemon startup and indexing, so success
+	// also verifies the command's initial readiness barrier.
+	type answer struct {
+		root string
+		raw  []byte
+		err  error
+	}
+	answers := make(chan answer, 2)
+	for _, workspace := range roots {
+		go func() {
+			raw, err := runQuery(binary, workspace, "definition", "lib/worker.ex", "6", "47")
+			answers <- answer{workspace, raw, err}
+		}()
+	}
+	for range roots {
+		got := <-answers
+		if got.err != nil {
+			t.Fatal(got.err)
+		}
+		var locations []lsptest.Location
+		if err := json.Unmarshal(got.raw, &locations); err != nil {
+			t.Fatal(err)
+		}
+		if len(locations) != 1 || locations[0].Path() != filepath.Join(got.root, "lib", "worker.ex") || locations[0].Range.Start.Line != 4 {
+			t.Fatalf("positional /2 definition for %s = %s", got.root, got.raw)
+		}
+	}
+}
+
+func assertQueryDefinitionMatchesNative(t *testing.T, binary, workspace string, client *lsptest.Client) {
+	t.Helper()
+	path := filepath.Join(workspace, "lib", "worker.ex")
+	// UTF-16 input differs from the UTF-8 byte column because of the emoji.
+	text, err := os.ReadFile(path) // #nosec G304 -- test-owned fixture path
+	if err != nil {
+		t.Fatal(err)
+	}
+	line := strings.Split(string(text), "\n")[5]
+	column := len(utf16.Encode([]rune(line[:strings.LastIndex(line, "fetch")])))
+	native, err := client.Definition(path, 5, column)
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw, err := runQuery(binary, workspace, "definition", path, "6", fmt.Sprint(column+1))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var queried []lsptest.Location
+	if err := json.Unmarshal(raw, &queried); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(queried, native) {
+		t.Fatalf("query definition spans %v differ from native %v", queried, native)
+	}
+}
+
+func runQuery(binary, root, operation string, args ...string) ([]byte, error) {
+	ctx, cancel := context.WithTimeout(context.Background(), 45*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, binary, append([]string{"--root", root, "query", operation}, args...)...) // #nosec G204 -- test-owned binary and fixture arguments
+	cmd.Env = append(os.Environ(), "DEXTER_DAEMON_IDLE_TIMEOUT=1s", "SHELL=/bin/false")
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout, cmd.Stderr = &stdout, &stderr
+	if err := cmd.Run(); err != nil {
+		return nil, fmt.Errorf("query %s: %w: %s", operation, err, stderr.String())
+	}
+	return stdout.Bytes(), nil
+}
+
+func writeQueryFixture(t *testing.T, root string) {
+	t.Helper()
+	if err := os.MkdirAll(filepath.Join(root, "lib"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	for name, text := range map[string]string{
+		"mix.exs":       "defmodule Sample.MixProject do\nend\n",
+		"lib/worker.ex": "defmodule SharedLib.Worker do\n  @doc \"one argument\"\n  def fetch(value), do: value\n  @doc \"two arguments\"\n  def fetch(left, right), do: {left, right}\n  def run(value), do: (\"😀\"; SharedLib.Worker.fetch(value, value))\nend\n\ndefmodule SharedLib.Contract do\n  @callback apply(term()) :: term()\nend\n\ndefmodule SharedLib.Integer do\n  @behaviour SharedLib.Contract\n  def apply(value), do: value\nend\n",
+	} {
+		if err := os.WriteFile(filepath.Join(root, name), []byte(text), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func queryGit(t *testing.T, root string, args ...string) {
+	t.Helper()
+	cmd := exec.CommandContext(t.Context(), "git", args...) // #nosec G204 -- test-owned binary and fixture arguments
+	cmd.Dir = root
+	if out, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("git %v: %v: %s", args, err, out)
+	}
+}
+
+func stopQueryDaemon(t *testing.T, root string) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	client, err := daemon.Dial(ctx, root)
+	if err != nil {
+		return // The test daemon may already have reached its idle timeout.
+	}
+	defer func() { _ = client.Close() }()
+	if err := client.Call(ctx, daemon.MethodShutdown, daemon.ShutdownParams{Force: true}, &struct{}{}); err != nil {
+		t.Errorf("stop test workspace: %v", err)
+	}
+	// Wait for the owned test daemon to release its workspace before TempDir
+	// removes it. This never stops a daemon outside the test's private roots.
+	for ctx.Err() == nil {
+		owner, _, err := daemon.AcquireOwnership(root)
+		if err == nil {
+			_ = owner.Release()
+			return
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Error("test daemon did not release workspace")
+}
