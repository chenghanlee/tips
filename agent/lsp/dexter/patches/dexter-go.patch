+// arityDefinitionCase expects the definition at a cursor to be exactly want.
+type arityDefinitionCase struct {
+	name string
+	at   arityAt
+	want []aritySite
+}
+
+func runArityDefinitions(t *testing.T, server *Server, prefix string, cases []arityDefinitionCase) {
+	t.Helper()
+	for _, tc := range cases {
+		t.Run(prefix+tc.name, func(t *testing.T) {
+			expectArityDefinition(t, server, tc.at, tc.want...)
+		})
+	}
+}
+
+func expectArityDefinition(t *testing.T, server *Server, at arityAt, want ...aritySite) {
+	t.Helper()
+	root := server.projectRoot
+	uri, line, col := at.resolve(t, root)
+	got := arityLocKeys(root, definitionAt(t, server, uri, line, col))
+	if keys := aritySiteKeys(t, want...); !sameKeys(got, keys) {
+		t.Errorf("definition = %v, want %v", got, keys)
+	}
+}
+
+// expectArityDefinitionWithin accepts any non-empty subset of allowed, for a
+// call that several clauses of one arity answer.
+func expectArityDefinitionWithin(t *testing.T, server *Server, at arityAt, allowed ...aritySite) {
+	t.Helper()
+	root := server.projectRoot
+	uri, line, col := at.resolve(t, root)
+	got := arityLocKeys(root, definitionAt(t, server, uri, line, col))
+	keys := aritySiteKeys(t, allowed...)
+	if len(got) == 0 {
+		t.Fatalf("no definition, want a subset of %v", keys)
+	}
+	for _, k := range got {
+		if !slices.Contains(keys, k) {
+			t.Errorf("definition = %v, want only %v", got, keys)
+		}
+	}
+}
+
+// arityHoverCase expects the hover at a cursor to contain want and, when
+// wrong is set, not to contain wrong.
+type arityHoverCase struct {
+	name        string
+	at          arityAt
+	want, wrong string
+}
+
+func runArityHovers(t *testing.T, server *Server, prefix string, cases []arityHoverCase) {
+	t.Helper()
+	for _, tc := range cases {
+		t.Run(prefix+tc.name, func(t *testing.T) {
+			expectArityHover(t, server, tc.at, tc.want, tc.wrong)
+		})
+	}
+}
+
+func expectArityHover(t *testing.T, server *Server, at arityAt, want, wrong string) {
+	t.Helper()
+	uri, line, col := at.resolve(t, server.projectRoot)
+	hover := hoverAt(t, server, uri, line, col)
+	if hover == nil {
+		t.Fatalf("no hover, want %q", want)
+	}
+	if !strings.Contains(hover.Contents.Value, want) || wrong != "" && strings.Contains(hover.Contents.Value, wrong) {
+		t.Errorf("hover = %q, want %q and not %q", hover.Contents.Value, want, wrong)
+	}
+}
+
+// arityReferenceCase expects the references at a cursor to be exactly want.
+type arityReferenceCase struct {
+	name    string
+	at      arityAt
+	include bool
+	want    []aritySite
+}
+
+func runArityReferences(t *testing.T, server *Server, prefix string, cases []arityReferenceCase) {
+	t.Helper()
+	root := server.projectRoot
+	for _, tc := range cases {
+		t.Run(prefix+tc.name, func(t *testing.T) {
+			uri, line, col := tc.at.resolve(t, root)
+			got := arityLocKeys(root, arityReferences(t, server, uri, line, col, tc.include))
+			if want := aritySiteKeys(t, tc.want...); !sameKeys(got, want) {
+				t.Errorf("references = %v, want %v", got, want)
+			}
+		})
+	}
+}
+
+// arityDelegateReferenceCase expects the references at a cursor, without
+// declarations, to hold every include line and no exclude line.
+type arityDelegateReferenceCase struct {
+	name             string
+	at               arityAt
+	include, exclude []aritySite
+}
+
+func runArityDelegateReferences(t *testing.T, server *Server, cases []arityDelegateReferenceCase) {
+	t.Helper()
+	root := server.projectRoot
+	for _, tc := range cases {
+		t.Run("delegate references/"+tc.name, func(t *testing.T) {
+			uri, line, col := tc.at.resolve(t, root)
+			got := arityLocKeys(root, arityReferences(t, server, uri, line, col, false))
+			expectArityKeysPresent(t, got, aritySiteKeys(t, tc.include...), true)
+			expectArityKeysPresent(t, got, aritySiteKeys(t, tc.exclude...), false)
+		})
+	}
+}
+
+func expectArityKeysPresent(t *testing.T, got, keys []string, present bool) {
+	t.Helper()
+	problem := "must not include"
+	if present {
+		problem = "missing"
+	}
+	for _, k := range keys {
+		if slices.Contains(got, k) != present {
+			t.Errorf("references = %v, %s %s", got, problem, k)
+		}
+	}
+}
+
+// arityOccurrenceCase expects the references of head, without declarations,
+// to hold exactly the fn token of the call written as anchor on site's line.
+type arityOccurrenceCase struct {
+	name       string
+	head       arityAt
+	site       aritySite
+	anchor, fn string
+}
+
+func runArityOccurrences(t *testing.T, server *Server, cases []arityOccurrenceCase) {
+	t.Helper()
+	root := server.projectRoot
+	for i := range cases {
+		tc := &cases[i]
+		t.Run("references/same line selects the "+tc.name+" occurrence", func(t *testing.T) {
+			uri, line, col := tc.head.resolve(t, root)
+			arityOccurrence(t, root, arityReferences(t, server, uri, line, col, false), tc.site, tc.anchor, tc.fn)
+		})
+	}
+}
