diff --git a/internal/lsp/import_references_test.go b/internal/lsp/import_references_test.go
new file mode 100644
index 0000000..2667f8b
--- /dev/null
+++ b/internal/lsp/import_references_test.go
@@ -0,0 +1,130 @@
+package lsp
+
+import (
+	"maps"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// Explicit imports of SharedLib.Pinger (arity matrix fixture) that the index
+// does not list as calls: a capture beside an indexed call, a capture in a file
+// with no other call, a one-line def body, and an import through an alias.
+
+// file: lib/my_app/ping_user.ex
+const importPingUserSrc = `defmodule MyApp.PingUser do
+  import SharedLib.Pinger
+
+  def calls(x) do
+    two = ping(x, :h)
+    captured = &ping/2
+    {two, captured}
+  end
+
+  def one_line(a, b), do: ping(a, b)
+end
+`
+
+// file: lib/my_app/ping_capture.ex
+const importPingCaptureSrc = `defmodule MyApp.PingCapture do
+  import SharedLib.Pinger
+
+  def pinger do
+    &ping/2
+  end
+end
+`
+
+// file: lib/my_app/ping_alias.ex
+const importPingAliasSrc = `defmodule MyApp.PingAlias do
+  alias SharedLib.Pinger, as: P
+  import P
+
+  def aliased(x) do
+    ping(x, :f)
+  end
+end
+`
+
+// Decoys: a local ping/1 capture in an importing file, and a same-arity local
+// ping/2 in a module that does not import Pinger.
+
+// file: lib/my_app/ping_arity.ex
+const importPingAritySrc = `defmodule MyApp.PingArity do
+  import SharedLib.Pinger
+
+  def ping(a), do: {:arity_ping, a}
+
+  def local_capture do
+    &ping/1
+  end
+end
+`
+
+// file: lib/my_app/ping_decoy.ex
+const importPingDecoySrc = `defmodule MyApp.PingDecoy do
+  def ping(a, b), do: {:decoy_ping, a, b}
+
+  def own(x) do
+    called = ping(x, :z)
+    captured = &ping/2
+    {called, captured}
+  end
+end
+`
+
+var importReferenceFiles = map[string]string{
+	"lib/my_app/ping_user.ex":    importPingUserSrc,
+	"lib/my_app/ping_capture.ex": importPingCaptureSrc,
+	"lib/my_app/ping_alias.ex":   importPingAliasSrc,
+	"lib/my_app/ping_arity.ex":   importPingAritySrc,
+	"lib/my_app/ping_decoy.ex":   importPingDecoySrc,
+}
+
+// Register the sources so aritySite and arityAt can read them.
+func init() {
+	maps.Copy(aritySingleFiles, importReferenceFiles)
+}
+
+func TestReferences_ExplicitImportsFindEveryUse(t *testing.T) {
+	server, cleanup := setupArityMatrix(t)
+	defer cleanup()
+	root := server.projectRoot
+	for rel, src := range importReferenceFiles {
+		indexFile(t, server.store, root, rel, src)
+	}
+
+	user := func(text string) aritySite { return aritySite{"lib/my_app/ping_user.ex", text} }
+	pingerHead := aritySite{"lib/shared_lib/pinger.ex", "def ping(a, b), do: {:shared_ping, a, b}"}
+	plainCall := aritySite{"lib/my_app/importer.ex", "ping(:a, :b)"}
+	aliasedCall := aritySite{"lib/my_app/ping_alias.ex", "ping(x, :f)"}
+	calls := []aritySite{
+		plainCall,
+		{"lib/my_app/only_importer.ex", "ping(:c, :d)"},
+		user("two = ping(x, :h)"),
+		user("captured = &ping/2"),
+		user("def one_line(a, b), do: ping(a, b)"),
+		{"lib/my_app/ping_capture.ex", "&ping/2"},
+		aliasedCall,
+	}
+
+	// Exact lists: a decoy line (importer.ex ping(:a), ping_arity.ex &ping/1,
+	// ping_decoy.ex ping(x, :z) and &ping/2) fails the comparison.
+	runArityReferences(t, server, "references/", []arityReferenceCase{
+		{"ping/2 head without declarations", arityAt{pingerHead, "ping", 1}, false, calls},
+		{"call through an aliased import", arityAt{aliasedCall, "ping", 1}, false, calls},
+	})
+
+	t.Run("references/every location spans the name", func(t *testing.T) {
+		uri, line, col := arityAt{pingerHead, "ping", 1}.resolve(t, root)
+		for _, loc := range arityReferences(t, server, uri, line, col, false) {
+			rel, _ := filepath.Rel(root, strings.TrimPrefix(string(loc.URI), "file://"))
+			text := strings.Split(aritySrc(t, rel), "\n")[loc.Range.Start.Line]
+			r := loc.Range
+			if r.End.Line != r.Start.Line || r.Start.Character > r.End.Character ||
+				int(r.End.Character) > len(text) || text[r.Start.Character:r.End.Character] != "ping" {
+				t.Errorf("%s:%d range %v does not span ping", rel, r.Start.Line, r)
+			}
+		}
+	})
+}
