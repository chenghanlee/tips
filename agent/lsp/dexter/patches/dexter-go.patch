diff --git a/internal/workspace/nested_checkout_darwin_test.go b/internal/workspace/nested_checkout_darwin_test.go
new file mode 100644
index 0000000..9e7270a
--- /dev/null
+++ b/internal/workspace/nested_checkout_darwin_test.go
@@ -0,0 +1,53 @@
+//go:build darwin && cgo
+
+package workspace
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/fsnotify/fsevents"
+)
+
+func TestFSEventsNestedClone(t *testing.T) {
+	for _, mode := range []string{"moved", "git-created", "existing"} {
+		t.Run(mode, func(t *testing.T) {
+			assertFSEventsNestedClone(t, mode)
+		})
+	}
+}
+
+func assertFSEventsNestedClone(t *testing.T, mode string) {
+	t.Helper()
+	root := t.TempDir()
+	clone := filepath.Join(root, "clone")
+	file := writeTestModule(t, clone, "lib/worker.ex", "SharedLib.Worker")
+	if err := os.Mkdir(filepath.Join(clone, ".git"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	var changed []string
+	full := 0
+	w := &fseventsWatcher{root: root, eventRoot: root, callbacks: WatchCallbacks{
+		PathChanged:   func(path string) { changed = append(changed, path) },
+		FullReconcile: func() { full++ },
+	}}
+	path := clone
+	if mode == "git-created" {
+		path = filepath.Join(clone, ".git")
+	}
+	if mode != "existing" {
+		w.handle(fsevents.Event{Path: path, Flags: fsevents.ItemIsDir | fsevents.ItemCreated})
+	}
+	w.handle(fsevents.Event{Path: file, Flags: fsevents.ItemIsFile | fsevents.ItemModified})
+	w.handle(fsevents.Event{Path: filepath.Dir(file), Flags: fsevents.ItemIsDir | fsevents.ItemCreated})
+	if mode == "existing" {
+		if len(changed) != 0 || full != 0 {
+			t.Fatalf("existing clone events: changed=%v full=%d", changed, full)
+		}
+		return
+	}
+	if !w.tops.has(clone) || full != 0 || len(changed) != 1 || changed[0] != clone {
+		t.Fatalf("clone events: tops=%v changed=%v full=%d", w.tops.list(), changed, full)
+	}
+}
diff --git a/internal/workspace/nested_checkout_test.go b/internal/workspace/nested_checkout_test.go
