+func assertQueryParentExcludesNested(t *testing.T, binary string) {
+	t.Helper()
+	root := t.TempDir()
+	writeQueryFixture(t, root)
+	nested := filepath.Join(root, "nested")
+	writeQueryFixture(t, nested)
+	if err := os.Mkdir(filepath.Join(nested, ".git"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	for _, workspace := range []string{root, nested} {
+		t.Cleanup(func() { stopQueryDaemon(t, workspace) })
+		client, err := lsptest.Start(binary, workspace, nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		t.Cleanup(client.Close)
+		assertColdDefinitions(t, binary, []string{workspace})
+		assertQueryDefinitionMatchesNative(t, binary, workspace, client)
+		raw, err := runQuery(binary, workspace, "workspace-symbols", "SharedLib.Worker")
+		if err != nil {
+			t.Fatal(err)
+		}
+		if workspace == root && strings.Contains(string(raw), nested) {
+			t.Fatalf("nested clone poisoned workspace symbols: %s", raw)
+		}
+		if workspace == root {
+			if _, err := runQuery(binary, root, "definition", filepath.Join(nested, "lib", "worker.ex"), "6", "47"); err == nil {
+				t.Fatal("query accepted nested checkout file")
+			}
+			if _, err := client.Definition(filepath.Join(nested, "lib", "worker.ex"), 5, 46); err == nil {
+				t.Fatal("native request accepted nested checkout file")
+			}
+		}
+	}
+}
