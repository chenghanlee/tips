+func TestReferences_ExplicitImportsFindEveryUse(t *testing.T) {
+	server, cleanup := setupArityMatrix(t)
+	defer cleanup()
+	root := server.projectRoot
+	for rel, src := range importReferenceFiles {
+		indexFile(t, server.store, root, rel, src)
+	}
+
+	user := func(text string) aritySite { return aritySite{"lib/my_app/ping_user.ex", text} }
+	pingerHead := aritySite{"lib/shared_lib/pinger.ex", "def ping(a, b), do: {:shared_ping, a, b}"}
+	plainCall := aritySite{"lib/my_app/importer.ex", "ping(:a, :b)"}
+	aliasedCall := aritySite{"lib/my_app/ping_alias.ex", "ping(x, :f)"}
+	calls := []aritySite{
+		plainCall,
+		{"lib/my_app/only_importer.ex", "ping(:c, :d)"},
+		user("two = ping(x, :h)"),
+		user("captured = &ping/2"),
+		user("def one_line(a, b), do: ping(a, b)"),
+		{"lib/my_app/ping_capture.ex", "&ping/2"},
+		aliasedCall,
+	}
+
+	// Exact lists: a decoy line (importer.ex ping(:a), ping_arity.ex &ping/1,
+	// ping_decoy.ex ping(x, :z) and &ping/2) fails the comparison.
+	runArityReferences(t, server, "references/", []arityReferenceCase{
+		{"ping/2 head without declarations", arityAt{pingerHead, "ping", 1}, false, calls},
+		{"ping/2 head with declarations", arityAt{pingerHead, "ping", 1}, true, append([]aritySite{pingerHead}, calls...)},
+		{"plain imported call", arityAt{plainCall, "ping", 1}, false, calls},
+		{"call through an aliased import", arityAt{aliasedCall, "ping", 1}, false, calls},
+	})
+
+	t.Run("references/every location spans the name", func(t *testing.T) {
+		uri, line, col := arityAt{pingerHead, "ping", 1}.resolve(t, root)
+		for _, loc := range arityReferences(t, server, uri, line, col, false) {
+			rel, _ := filepath.Rel(root, strings.TrimPrefix(string(loc.URI), "file://"))
+			text := strings.Split(aritySrc(t, rel), "\n")[loc.Range.Start.Line]
+			r := loc.Range
+			if r.End.Line != r.Start.Line || r.Start.Character > r.End.Character ||
+				int(r.End.Character) > len(text) || text[r.Start.Character:r.End.Character] != "ping" {
+				t.Errorf("%s:%d range %v does not span ping", rel, r.Start.Line, r)
+			}
+		}
+	})
+}
+
+func TestTypeDefinition_BareLocalTypes(t *testing.T) {
+	server, cleanup := setupTestServer(t)
+	defer cleanup()
+	root := server.projectRoot
+	for rel, src := range localTypeFiles {
+		indexFile(t, server.store, root, rel, src)
+	}
+
+	typed := func(text string) aritySite { return aritySite{"lib/my_app/typed.ex", text} }
+	user := func(text string) aritySite { return aritySite{"lib/my_app/type_user.ex", text} }
+	outer := func(text string) aritySite { return aritySite{"lib/my_app/outer.ex", text} }
+	typeT := typed("@type t :: %{name: String.t()}")
+	typeStatus := typed("@type status :: atom()")
+	outerT := outer("@type t :: integer()")
+	innerT := outer("@type t :: binary()")
+
+	for _, tc := range []struct {
+		name string
+		at   arityAt
+		want []aritySite
+	}{
+		{"bare local t()", arityAt{typed("@spec build(String.t()) :: t()"), ":: t()", 3}, []aritySite{typeT}},
+		{"bare local status() beside a status/1 function", arityAt{typed("@spec status(term()) :: status()"), ":: status()", 3}, []aritySite{typeStatus}},
+		{"nested: parent t() before the nested module", arityAt{outer("@spec a() :: t()"), ":: t()", 3}, []aritySite{outerT}},
+		{"nested: nested module t()", arityAt{outer("@spec i() :: t()"), ":: t()", 3}, []aritySite{innerT}},
+		{"nested: parent t() after the nested module ends", arityAt{outer("@spec b() :: t()"), ":: t()", 3}, []aritySite{outerT}},
+		{"control: qualified alias Typed.t()", arityAt{user("@spec make(String.t()) :: Typed.t()"), "Typed.t", 6}, []aritySite{typeT}},
+		{"control: qualified full MyApp.Typed.t()", arityAt{user("@spec again(MyApp.Typed.t()) :: boolean()"), "Typed.t", 6}, []aritySite{typeT}},
+		{"control: qualified function Typed.build is not a type", arityAt{user("def make(name), do: Typed.build(name)"), "build", 1}, nil},
+		{"control: ordinary status(x) call beside a status type", arityAt{typed("def check(x), do: {build(x), status(x)}"), "status(x)", 1}, nil},
+		{"control: local function build(x) is not a type", arityAt{typed("def check(x), do: {build(x), status(x)}"), "build(x)", 1}, nil},
+		{"control: built-in atom()", arityAt{typeStatus, "atom", 1}, nil},
+	} {
+		t.Run("type definition/"+tc.name, func(t *testing.T) {
+			uri, line, col := tc.at.resolve(t, root)
+			result, err := server.TypeDefinition(context.Background(), &protocol.TypeDefinitionParams{
+				TextDocumentPositionParams: protocol.TextDocumentPositionParams{
+					TextDocument: protocol.TextDocumentIdentifier{URI: protocol.DocumentURI(uri)},
+					Position:     protocol.Position{Line: line, Character: col},
+				},
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if got, want := arityLocKeys(root, result), aritySiteKeys(t, tc.want...); !sameKeys(got, want) {
+				t.Errorf("type definition = %v, want %v", got, want)
+			}
+		})
+	}
+}
