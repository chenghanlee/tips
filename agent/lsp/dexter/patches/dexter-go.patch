diff --git a/internal/lsp/workspace_root.go b/internal/lsp/workspace_root.go
new file mode 100644
index 0000000..a742303
--- /dev/null
+++ b/internal/lsp/workspace_root.go
@@ -0,0 +1,167 @@
+package lsp
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io/fs"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/remoteoss/dexter/internal/store"
+	"go.lsp.dev/jsonrpc2"
+	"go.lsp.dev/protocol"
+)
+
+// ValidateWorkspaceRoot admits the exact checkout requested by a frontend.
+// A parent containing another checkout is refused for the local beta: native
+// sessions and headless queries must never index different checkout boundaries.
+func ValidateWorkspaceRoot(root string) error {
+	info, err := os.Stat(root)
+	if err != nil {
+		return err
+	}
+	if !info.IsDir() {
+		return fmt.Errorf("workspace root %s is not a directory", root)
+	}
+	// Check the nearest checkout before database markers, which can belong to
+	// an enclosing repository when a foreign checkout is nested inside it.
+	checkout := ""
+	for dir := root; ; dir = filepath.Dir(dir) {
+		if _, err := os.Stat(filepath.Join(dir, ".git")); err == nil {
+			checkout = dir
+			break
+		}
+		if filepath.Dir(dir) == dir {
+			break
+		}
+	}
+	if checkout != "" && checkout != root {
+		return fmt.Errorf("workspace root %s must name the exact checkout %s", root, checkout)
+	}
+	if checkout == "" {
+		if discovered := store.FindProjectRoot(root, "mix.exs"); discovered != root {
+			return fmt.Errorf("workspace root %s must name the exact project %s", root, discovered)
+		}
+	}
+	return rejectNestedCheckouts(root)
+}
+
+func rejectNestedCheckouts(root string) error {
+	walkRoot, err := filepath.EvalSymlinks(root)
+	if err != nil {
+		return err
+	}
+	return filepath.WalkDir(walkRoot, func(path string, entry fs.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		if !entry.IsDir() || path == walkRoot {
+			return nil
+		}
+		switch entry.Name() {
+		case ".git", ".dexter", "_build", "deps", "node_modules":
+			return filepath.SkipDir
+		}
+		if _, err := os.Stat(filepath.Join(path, ".git")); err == nil {
+			return fmt.Errorf("workspace %s contains nested checkout %s; select that exact checkout or move it outside the workspace", root, path)
+		} else if !os.IsNotExist(err) {
+			return err
+		}
+		return nil
+	})
+}
+
+// ValidateWorkspaceFile keeps request paths in the daemon's spelling of its
+// checkout. Resolving symlinks only for comparison prevents a file alias from
+// mixing different path keys with the shared index.
+func ValidateWorkspaceFile(root, path string) error {
+	rel, err := filepath.Rel(root, path)
+	if err != nil || rel == "." || rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+		return fmt.Errorf("file %s does not belong to workspace %s", path, root)
+	}
+	resolvedRoot, err := filepath.EvalSymlinks(root)
+	if err != nil {
+		return err
+	}
+	resolvedPath, err := filepath.EvalSymlinks(path)
+	if err != nil {
+		return err
+	}
+	resolvedRel, err := filepath.Rel(resolvedRoot, resolvedPath)
+	if err != nil || resolvedRel != rel {
+		return fmt.Errorf("file %s does not use workspace %s path spelling", path, root)
+	}
+	for dir := filepath.Dir(path); dir != root && !libraryPath(rel); dir = filepath.Dir(dir) {
+		if _, err := os.Stat(filepath.Join(dir, ".git")); err == nil {
+			return fmt.Errorf("file %s belongs to nested checkout %s", path, dir)
+		} else if !os.IsNotExist(err) {
+			return err
+		}
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		return err
+	}
+	if !info.Mode().IsRegular() {
+		return fmt.Errorf("file %s is not a regular file", path)
+	}
+	return nil
+}
+
+// ValidateReadOnlyDocument shares request admission between native LSP and
+// headless queries. Other native requests retain their existing handlers.
+func ValidateReadOnlyDocument(root, stdlibRoot, method string, raw json.RawMessage) error {
+	var hierarchy bool
+	switch method {
+	case "textDocument/definition", "textDocument/references", "textDocument/hover",
+		"textDocument/documentSymbol", "textDocument/implementation", "textDocument/prepareCallHierarchy":
+	case "callHierarchy/incomingCalls", "callHierarchy/outgoingCalls":
+		hierarchy = true
+	default:
+		return nil
+	}
+	var document struct {
+		TextDocument protocol.TextDocumentIdentifier `json:"textDocument"`
+		Item         protocol.CallHierarchyItem      `json:"item"`
+	}
+	if err := json.Unmarshal(raw, &document); err != nil {
+		return err
+	}
+	documentURI := document.TextDocument.URI
+	if hierarchy {
+		documentURI = document.Item.URI
+	}
+	parsed, err := url.Parse(string(documentURI))
+	if err != nil || parsed.Scheme != "file" || parsed.Host != "" || parsed.RawQuery != "" || parsed.Fragment != "" {
+		return fmt.Errorf("request requires a local file URI, got %q", documentURI)
+	}
+	path := filepath.FromSlash(parsed.Path)
+	if err := ValidateWorkspaceFile(root, path); err != nil {
+		if stdlibRoot != "" && ValidateWorkspaceFile(stdlibRoot, path) == nil {
+			return nil
+		}
+		return err
+	}
+	return nil
+}
+
+func (s *Server) workspaceRequestHandler(next jsonrpc2.Handler) jsonrpc2.Handler {
+	return func(ctx context.Context, reply jsonrpc2.Replier, request jsonrpc2.Request) error {
+		if err := ValidateReadOnlyDocument(s.projectRoot, s.StdlibRoot(), request.Method(), request.Params()); err != nil {
+			return reply(ctx, nil, err)
+		}
+		return next(ctx, reply, request)
+	}
+}
+
+func libraryPath(relative string) bool {
+	for _, dir := range []string{"deps", "_build"} {
+		if strings.HasPrefix(relative, dir+string(filepath.Separator)) {
+			return true
+		}
+	}
+	return false
+}
