+// An item whose data this server did not write names no function. It is
+// refused, never read as some arity: check/0 has a caller that a /0 guess
+// would list.
+func TestCallHierarchyRefusesItemsWithoutIdentity(t *testing.T) {
+	server, cleanup := setupTestServer(t)
+	t.Cleanup(cleanup)
+	indexFile(t, server.store, server.projectRoot, "lib/gate.ex", "defmodule MyApp.Gate do\n  def check, do: :ok\n  def run, do: check()\nend\n")
+	item := prepareOne(t, server, "lib/gate.ex:1:6", "MyApp.Gate.check/0")
+
+	for _, data := range []map[string]interface{}{
+		{"module": "MyApp.Gate", "function": "check"},
+		{"module": "MyApp.Gate", "function": "check", "arity": 0.5},
+		{"module": "MyApp.Gate", "function": "check", "arity": -1.0},
+		{"module": "MyApp.Gate", "function": "check", "arity": "0"},
+		{"function": "check", "arity": 0.0},
+	} {
+		item.Data = data
+		in, err := server.IncomingCalls(context.Background(), &protocol.CallHierarchyIncomingCallsParams{Item: item})
+		if err == nil || in != nil {
+			t.Errorf("incoming calls of %v = %v, %v; want refused", data, in, err)
+		}
+		out, err := server.OutgoingCalls(context.Background(), &protocol.CallHierarchyOutgoingCallsParams{Item: item})
+		if err == nil || out != nil {
+			t.Errorf("outgoing calls of %v = %v, %v; want refused", data, out, err)
+		}
+	}
+}
