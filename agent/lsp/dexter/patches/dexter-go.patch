+// The references search and the owner walk read a file separately. A call
+// whose module changed in between is omitted, not credited to the old callee.
+// The owner walk is called directly: the change happens exactly at that seam.
+func TestCallHierarchyIncomingRechecksIdentity(t *testing.T) {
+	server, cleanup := setupTestServer(t)
+	t.Cleanup(cleanup)
+	indexFile(t, server.store, server.projectRoot, "lib/gate.ex", "defmodule MyApp.Gate do\n  def check(x), do: x\nend\n")
+	indexFile(t, server.store, server.projectRoot, "lib/door.ex", "defmodule MyApp.Door do\n  def check(x), do: x\nend\n")
+	indexFile(t, server.store, server.projectRoot, "lib/web.ex", `defmodule MyApp.Web do
+  defmacro __using__(_opts) do
+    quote do
+      import MyApp.Gate
+    end
+  end
+end
+`)
+	const caller = `defmodule MyApp.Caller do
+  use MyApp.Web
+  alias MyApp.Door
+  alias MyApp.Gate
+
+  def run(x), do: Gate.check(x)
+  def both(x), do: {Gate.check(x), check(x)}
+end
+`
+	indexFile(t, server.store, server.projectRoot, "lib/caller.ex", caller)
+	callerPath := filepath.Join(server.projectRoot, "lib", "caller.ex")
+
+	gate := callIdentity{module: "MyApp.Gate", function: "check", arity: treesitter.ExactArity(1)}
+	locations, err := server.ReferenceNames(gate.module, gate.function, NameReferenceOptions{
+		Kind: NameKindCallable, ExcludeStdlib: true, Arity: gate.arity,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var verified []NameLocation
+	for _, location := range locations {
+		if location.FilePath == callerPath {
+			verified = append(verified, location)
+		}
+	}
+
+	// Unchanged source: every call, the one through the use chain included.
+	// The index has no row for that bare call; sharing a line with an indexed
+	// call makes the references search check it.
+	assertRows(t, incomingRows(t, server, server.ownedCalls(callerPath, verified, gate)), []string{
+		`lib/caller.ex | def MyApp.Caller.run/1 [5:2-5:31] sel [5:6-5:9] <- 5:23-5:28`,
+		`lib/caller.ex | def MyApp.Caller.both/1 [6:2-6:44] sel [6:6-6:10] <- 6:25-6:30 6:35-6:40`,
+	})
+
+	// Gate.check becomes Door.check at the same position.
+	changed := strings.Replace(caller, "Gate.check(x)", "Door.check(x)", 1)
+	if err := os.WriteFile(callerPath, []byte(changed), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	assertRows(t, incomingRows(t, server, server.ownedCalls(callerPath, verified, gate)), []string{
+		`lib/caller.ex | def MyApp.Caller.both/1 [6:2-6:44] sel [6:6-6:10] <- 6:25-6:30 6:35-6:40`,
+	})
+}
