+		admit := prepareOne(t, server, "lib/admission.ex:1:6", "MyApp.Admission.admit/1")
+		var private protocol.CallHierarchyItem
+		for _, call := range incoming(t, server, admit) {
+			if call.From.Name == "MyApp.Gate.private/1" {
+				private = call.From
+			}
+		}
+		assertRows(t, incomingRows(t, server, incoming(t, server, private)), []string{
+			`lib/gate.ex | def MyApp.Gate.private_user/1 [43:2-43:37] sel [43:6-43:18] <- 43:27-43:34`,
+		})
+		assertRows(t, outgoingRows(outgoing(t, server, private)), []string{
+			`MyApp.Admission.admit/1 <- 29:30-29:35`,
+		})
+	})
+
+	t.Run("a test block has no follow-up", func(t *testing.T) {
+		admit := prepareOne(t, server, "lib/admission.ex:1:6", "MyApp.Admission.admit/1")
+		for _, call := range incoming(t, server, admit) {
+			if call.From.Detail != "test" {
+				continue
+			}
+			if calls := incoming(t, server, call.From); calls != nil {
+				t.Fatalf("incoming calls of %s = %#v, want null", call.From.Name, calls)
+			}
+			if calls := outgoing(t, server, call.From); calls != nil {
+				t.Fatalf("outgoing calls of %s = %#v, want null", call.From.Name, calls)
+			}
+		}
+	})
