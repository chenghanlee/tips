+// The references search and the owner walk read a file separately. A call
+// whose module changed in between is omitted, not credited to the old callee.
+// The owner walk is called directly: the change happens exactly at that seam.
+func TestCallHierarchyIncomingRechecksIdentity(t *testing.T) {
+	server, cleanup := setupTestServer(t)
+	t.Cleanup(cleanup)
+	indexFile(t, server.store, server.projectRoot, "lib/gate.ex", "defmodule MyApp.Gate do\n  def check(x), do: x\nend\n")
+	indexFile(t, server.store, server.projectRoot, "lib/door.ex", "defmodule MyApp.Door do\n  def check(x), do: x\nend\n")
+	indexFile(t, server.store, server.projectRoot, "lib/web.ex", `defmodule MyApp.Web do
+  defmacro __using__(_opts) do
+    quote do
+      import MyApp.Gate
+    end
+  end
