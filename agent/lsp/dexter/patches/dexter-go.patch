+// Outgoing calls list every call occurrence in every clause of the function,
+// each resolved the way references resolves it. Library targets are kept.
+// Absent on purpose: Erlang module calls (:inet, :ets, :crypto), anonymous
+// calls (write.()), field access (state.table), operators and language forms
+// (if, case). A guard or default argument belongs to its clause, as it does for
+// incoming calls, so is_binary/1 in the admit/3 guard is a row.
+func TestCallHierarchyOutgoing(t *testing.T) {
+	server := callHierarchyProject(t, "outgoing")
+	server.SetStdlibRoot(filepath.Join(server.projectRoot, "stdlib"))
+	indexAndCompile(t, server, "Shop.Repo", "lib/shop/repo.ex", "defmodule Shop.Repo do\n  use Shop.RepoMacro\nend\n",
+		beamExport{"delete!", 1}, beamExport{"insert!", 1}, beamExport{"one", 1})
+	bumpDirMtime(t, filepath.Join(server.projectRoot, "_build", "dev", "lib", "my_app", "ebin"))
+
+	for _, tc := range []struct {
+		name, query, caller string
+		// want nil: same rows as the previous case (another head of it).
+		want []string
+	}{
+		{"E1 deliver/1", "lib/shop/accounts.ex:3:6", "Shop.Accounts.deliver/1", []string{"Shop.Token.build/2 <- 4:18-4:23", "Shop.Repo.insert!/1 <- 5:9-5:16", "Shop.Mailer.send_login/2 <- 6:16-6:26"}},
+		{"E2 update/2 pipes", "lib/shop/accounts.ex:9:6", "Shop.Accounts.update/2", []string{"Shop.Token.changeset/2 <- 11:13-11:22", "Shop.Accounts.save_and_clear/1 <- 12:7-12:21"}},
+		{"E3 capture", "lib/shop/accounts.ex:15:6", "Shop.Accounts.normalize_all/1", []string{"Enum.map/2 <- 16:9-16:12", "Shop.Accounts.normalize/1 <- 16:22-16:31"}},
+		{"E4 default head", "lib/shop/accounts.ex:19:6", "Shop.Accounts.admit/3", []string{"Kernel.is_binary/1 <- 21:36-21:45", "Shop.Token.normalize/1 <- 22:23-22:32", "GenServer.call/2 <- 25:16-25:20"}},
+		{"E4b second head", "lib/shop/accounts.ex:21:6", "Shop.Accounts.admit/3", nil},
+		{"E5 second clause", "lib/shop/accounts.ex:35:6", "Shop.Accounts.handle/2", []string{"Enum.map/2 <- 36:19-36:22", "Shop.Accounts.entry/2 <- 36:30-36:35", "Enum.find/2 <- 38:14-38:18", "Shop.Accounts.limited/1 <- 40:23-40:30"}},
+		{"E5b first clause", "lib/shop/accounts.ex:31:6", "Shop.Accounts.handle/2", nil},
+		{"E6 no calls", "lib/shop/accounts.ex:44:6", "Shop.Accounts.version/0", []string{}},
+		{"E7 generated", "lib/shop/accounts.ex:46:7", "Shop.Accounts.save_and_clear/1", []string{"Shop.Repo.insert!/1 <- 47:15-47:22", "Shop.Repo.delete!/1 <- 48:9-48:16"}},
+		{"E8 test helper", "test/shop/accounts_test.exs:9:7", "Shop.AccountsTest.synchronized_write/2", []string{"Shop.Repo.one/1 <- 10:15-10:18", "Kernel.send/2 <- 11:4-11:8", "Kernel.self/0 <- 11:26-11:30", "Shop.AccountsTest.await/1 <- 12:4-12:9"}},
+		{"sibling deliver/2", "lib/shop/accounts.ex:56:6", "Shop.Accounts.deliver/2", []string{"Shop.Token.verify/1 <- 57:10-57:16"}},
+		{"sibling admit/1", "lib/shop/accounts.ex:60:6", "Shop.Accounts.admit/1", []string{"Shop.Token.verify/1 <- 60:30-60:36"}},
+		{"grouped by target arity", "lib/shop/mail.ex:3:6", "Shop.Mail.check/1", []string{"Shop.Token.verify/1 <- 4:10-4:16 7:10-7:16", "Shop.Token.verify/2 <- 5:10-5:16"}},
+		{"utf16 greet", "lib/shop/unicode.ex:1:6", "Shop.Unicode.greet/1", []string{"Shop.Token.build/2 <- 2:30-2:35"}},
+		{"utf16 family", "lib/shop/unicode.ex:5:6", "Shop.Unicode.family/0", []string{"Shop.Unicode.foo/1 <- 6:20-6:23"}},
+		{"quote body excluded", "lib/shop/macros.ex:1:11", "Shop.Macros.traced/1", []string{"Shop.Token.verify/1 <- 2:15-2:21"}},
+		{"utf16 cafe", "lib/shop/unicode.ex:9:6", "Shop.Unicode.cafe/0", []string{"Shop.Unicode.bar/1 <- 10:14-10:17"}},
+	} {
+		if tc.want == nil {
+			continue
+		}
+		t.Run(tc.name, func(t *testing.T) {
+			calls := outgoing(t, server, prepareOne(t, server, tc.query, tc.caller))
+			if calls == nil {
+				t.Fatal("outgoing calls = null, want a list")
+			}
+			assertRows(t, outgoingRows(calls), tc.want)
+			for _, call := range calls {
+				assertItemData(t, call.To)
+			}
+		})
+	}
+
+	t.Run("every head of a function gives the same rows", func(t *testing.T) {
+		for _, pair := range [][2]string{
+			{"lib/shop/accounts.ex:19:6", "lib/shop/accounts.ex:21:6"},
+			{"lib/shop/accounts.ex:35:6", "lib/shop/accounts.ex:31:6"},
+		} {
+			first := outgoingRows(outgoing(t, server, prepareAt(t, server, pair[0])[0]))
+			second := outgoingRows(outgoing(t, server, prepareAt(t, server, pair[1])[0]))
+			assertRows(t, second, first)
+		}
+	})
+
+	t.Run("a generated target is anchored at its module", func(t *testing.T) {
+		for _, call := range outgoing(t, server, prepareOne(t, server, "lib/shop/accounts.ex:46:7", "Shop.Accounts.save_and_clear/1")) {
+			if uriToPath(call.To.URI) != filepath.Join(server.projectRoot, "lib", "shop", "repo.ex") || call.To.Range.Start.Line != 0 {
+				t.Fatalf("%s anchored at %s line %d, want the Shop.Repo module line", call.To.Name, call.To.URI, call.To.Range.Start.Line)
+			}
+		}
+	})
+}
