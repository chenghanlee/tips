+package treesitter
+
+import (
+	"strings"
+	"testing"
+
+	tree_sitter "github.com/tree-sitter/go-tree-sitter"
+)
+
+// The expected arities are the argument counts in Elixir's own AST
+// (Code.string_to_quoted), not a restatement of the classifier.
+func TestFunctionOccurrenceAt(t *testing.T) {
+	src := `defmodule MyApp.Store do
+  @doc "Puts."
+  def put(key, value), do: {key, value}
+  def put(key, value, opts) when is_list(opts), do: {key, value, opts}
+  def fetch(key, default \\ nil), do: {key, default}
+  def ping, do: :pong
+  @spec save(term, term) :: :ok
+  @callback cast(term) :: term
+  @type t(a) :: {a, put}
+
+  def calls(key) do
+    put(key, :v)
+    key |> put(:v)
+    key |> put
+    &put/3
+    &MyApp.Store.put/2
+    &put(&1, :v)
+    Store.put(key, :v, [])
+    Store.fetch
+    ping
+    put key, :v, [:x]
+    put(key, fn a, b -> {a, b} end)
+    put(key, mode: :fast, retries: 2)
+    wrap(key, k: 1) do
+      :x
+    end
+    wrap(key, k: 1, do: :x)
+    {put(key, :a), put(key, :b, [:c])}
+  end
+end
+`
+	cases := []struct {
+		name   string
+		line   string // trimmed line text
+		anchor string // text whose first byte starts the name
+		kind   OccurrenceKind
+		arity  Arity
+		qual   string
+	}{
+		{"head", "def put(key, value), do: {key, value}", "put", OccurrenceHead, ExactArity(2), ""},
+		{"guarded head", "def put(key, value, opts) when is_list(opts), do: {key, value, opts}", "put", OccurrenceHead, ExactArity(3), ""},
+		{"default head is a range", `def fetch(key, default \\ nil), do: {key, default}`, "fetch", OccurrenceHead, Arity{Min: 1, Max: 2, Known: true}, ""},
+		{"head without parentheses", "def ping, do: :pong", "ping", OccurrenceHead, ExactArity(0), ""},
+		{"spec head names the function", "@spec save(term, term) :: :ok", "save", OccurrenceSpecHead, ExactArity(2), ""},
+		{"callback head", "@callback cast(term) :: term", "cast", OccurrenceCallbackHead, ExactArity(1), ""},
+		{"type head", "@type t(a) :: {a, put}", "t(", OccurrenceTypespec, Arity{}, ""},
+		{"name in a type body", "@type t(a) :: {a, put}", "put}", OccurrenceTypespec, Arity{}, ""},
+		{"call", "put(key, :v)", "put", OccurrenceCall, ExactArity(2), ""},
+		{"pipe supplies the first argument", "key |> put(:v)", "put", OccurrenceCall, ExactArity(2), ""},
+		{"pipe without parentheses", "key |> put", "put", OccurrenceCall, ExactArity(1), ""},
+		{"capture", "&put/3", "put", OccurrenceCall, ExactArity(3), ""},
+		{"qualified capture", "&MyApp.Store.put/2", "put", OccurrenceCall, ExactArity(2), "MyApp.Store"},
+		{"capture of a call", "&put(&1, :v)", "put", OccurrenceCall, ExactArity(2), ""},
+		{"qualified call", "Store.put(key, :v, [])", "put", OccurrenceCall, ExactArity(3), "Store"},
+		{"call without parentheses", "put key, :v, [:x]", "put", OccurrenceCall, ExactArity(3), ""},
+		{"qualified name without parentheses calls name/0", "Store.fetch", "fetch", OccurrenceCall, ExactArity(0), "Store"},
+		{"bare name without parentheses is not a call", "ping", "ping", OccurrencePlain, Arity{}, ""},
+		{"anonymous function is one argument", "put(key, fn a, b -> {a, b} end)", "put", OccurrenceCall, ExactArity(2), ""},
+		{"trailing keyword list is one argument", "put(key, mode: :fast, retries: 2)", "put", OccurrenceCall, ExactArity(2), ""},
+		{"do-block is another argument after keywords", "wrap(key, k: 1) do", "wrap", OccurrenceCall, ExactArity(3), ""},
+		{"inline do: stays in the keyword list", "wrap(key, k: 1, do: :x)", "wrap", OccurrenceCall, ExactArity(2), ""},
+		{"same line, first call", "{put(key, :a), put(key, :b, [:c])}", "put(key, :a)", OccurrenceCall, ExactArity(2), ""},
+		{"same line, second call", "{put(key, :a), put(key, :b, [:c])}", "put(key, :b", OccurrenceCall, ExactArity(3), ""},
+	}
+
+	lines := strings.Split(src, "\n")
+	root, cleanup := parseElixir([]byte(src))
+	defer cleanup()
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			row, col := nameAt(t, lines, tc.line, tc.anchor, 0)
+			want := FunctionOccurrence{Kind: tc.kind, Arity: tc.arity, Qualifier: tc.qual}
+			checkOccurrenceAt(t, root, []byte(src), row, col, want)
+		})
+	}
+}
+
+// nameAt returns the row of the nth (0-based) line whose trimmed text is
+// line, and the column where anchor starts on it.
+func nameAt(t *testing.T, lines []string, line, anchor string, nth int) (row, col int) {
+	t.Helper()
+	for i, l := range lines {
+		if strings.TrimSpace(l) != line {
+			continue
+		}
+		if nth == 0 && strings.Contains(l, anchor) {
+			return i, strings.Index(l, anchor)
+		}
+		nth--
+	}
+	t.Fatalf("anchor %q on line %q not found", anchor, line)
+	return -1, -1
+}
+
+// checkOccurrenceAt checks the classification at the first two columns of
+// the name: every column of a name must classify the same way.
+func checkOccurrenceAt(t *testing.T, root *tree_sitter.Node, src []byte, row, col int, want FunctionOccurrence) {
+	t.Helper()
+	for _, offset := range []int{0, 1} {
+		occ, ok := FunctionOccurrenceAt(root, src, uint(row), uint(col+offset))
+		if !ok {
+			t.Fatalf("no identifier at %d:%d", row, col+offset)
+		}
+		if occ.Kind != want.Kind || occ.Arity != want.Arity || occ.Qualifier != want.Qualifier || occ.NameCol != uint(col) {
+			t.Errorf("offset %d: got kind %d arity %+v qualifier %q at col %d, want kind %d arity %+v qualifier %q at col %d",
+				offset, occ.Kind, occ.Arity, occ.Qualifier, occ.NameCol, want.Kind, want.Arity, want.Qualifier, col)
+		}
+	}
+}
+
+func TestFunctionOccurrences_ReportsEveryOccurrenceOnALine(t *testing.T) {
+	src := []byte(`defmodule MyApp.Mixer do
+  def mixed do
+    {Alpha.f(1, 2), Beta.f(1, 2, 3)}
+  end
+end
+`)
+	root, cleanup := parseElixir(src)
+	defer cleanup()
+	occs := functionOccurrences(root, src, "f")
+	if len(occs) != 2 {
+		t.Fatalf("got %d occurrences, want 2", len(occs))
+	}
+	want := []struct {
+		qual  string
+		arity int
+		col   uint
+	}{{"Alpha", 2, 11}, {"Beta", 3, 25}}
+	for i, w := range want {
+		if occs[i].Name != "f" || occs[i].Qualifier != w.qual || occs[i].Arity != ExactArity(w.arity) || occs[i].NameCol != w.col || occs[i].Line != 2 {
+			t.Errorf("occurrence %d = %+v, want %s.f/%d at 2:%d", i, occs[i], w.qual, w.arity, w.col)
+		}
+	}
+}
+
+func TestArityMatching(t *testing.T) {
+	head := Arity{Min: 1, Max: 2, Known: true}
+	if !head.Matches(1) || !head.Matches(2) || head.Matches(3) {
+		t.Errorf("default head %+v must match /1 and /2 only", head)
+	}
+	if !(Arity{}).Matches(7) {
+		t.Error("unknown arity must match any definition")
+	}
+}
+
+// Each defdelegate head keeps its own arity range, also with two heads on one
+// line; a head with defaults accepts a range.
+func TestFunctionOccurrences_DelegateHeads(t *testing.T) {
+	src := []byte(`defmodule MyApp.Facade do
+  defdelegate grab(a, b \\ 1), to: MyApp.Dual
+  defdelegate pick(a), to: MyApp.Dual; defdelegate pick(a, b), to: MyApp.Pair
+end
+`)
+	root, cleanup := parseElixir(src)
+	defer cleanup()
+	grab := functionOccurrences(root, src, "grab")
+	if len(grab) != 1 || grab[0].Kind != OccurrenceHead || grab[0].Keyword != "defdelegate" || grab[0].Arity != (Arity{Min: 1, Max: 2, Known: true}) {
+		t.Errorf("grab = %+v, want one defdelegate head /1..2", grab)
+	}
+	pick := functionOccurrences(root, src, "pick")
+	if len(pick) != 2 || pick[0].Arity != ExactArity(1) || pick[1].Arity != ExactArity(2) || pick[0].NameLine != pick[1].NameLine {
+		t.Errorf("pick = %+v, want heads /1 and /2 on one line", pick)
+	}
+}
diff --git a/internal/treesitter/owners.go b/internal/treesitter/owners.go
new file mode 100644
index 0000000..6878336
--- /dev/null
+++ b/internal/treesitter/owners.go
@@ -0,0 +1,379 @@
+package treesitter
+
+import (
+	"strings"
+
+	tree_sitter "github.com/tree-sitter/go-tree-sitter"
+)
+
+// Owner is the lexical block that owns a call in the call hierarchy: a
+// def-family clause, or an ExUnit test, setup or setup_all block. Other blocks
+// (describe, if, case, for, with, fn, ...) are transparent.
+type Owner struct {
+	// Module is the Elixir name of the enclosing module, with nested
+	// defmodule names prefixed by their parent's and Elixir.-prefixed names
+	// taken as absolute.
+	Module string
+	// Keyword is def, defp, defmacro, defmacrop, defguard, defguardp, test,
+	// setup or setup_all.
+	Keyword string
+	// Name is the function name, the test label as written (with its
+	// quotes), or empty for a setup block.
+	Name string
+	// Arity is the head's arity range for a def-family clause and unknown
+	// for a test or setup block.
+	Arity Arity
+	// Start and End span the owner's call; NameStart and NameEnd span its
+	// function name, test label or setup keyword. Rows are 0-based and
+	// columns are 0-based bytes.
+	Start, End, NameStart, NameEnd tree_sitter.Point
+
+	node *tree_sitter.Node
+}
+
+// IsFunction reports whether the owner is a def-family clause.
+func (o Owner) IsFunction() bool { return functionOwnerKeywords[o.Keyword] }
+
+var functionOwnerKeywords = map[string]bool{
+	"def": true, "defp": true, "defmacro": true, "defmacrop": true,
+	"defguard": true, "defguardp": true,
+}
+
+var blockOwnerKeywords = map[string]bool{"test": true, "setup": true, "setup_all": true}
+
+// Source is one parsed Elixir file for ownership questions.
+type Source struct {
+	root    *tree_sitter.Node
+	src     []byte
+	cleanup func()
+}
+
+// ParseSource parses src. ok is false when the file does not parse cleanly:
+// a tree recovered from a syntax error can put a call in the wrong block.
+func ParseSource(src []byte) (*Source, bool) {
+	root, cleanup := parseElixir(src)
+	if root == nil {
+		return nil, false
+	}
+	if root.HasError() {
+		cleanup()
+		return nil, false
+	}
+	return &Source{root: root, src: src, cleanup: cleanup}, true
+}
+
+// Close releases the syntax tree.
+func (s *Source) Close() { s.cleanup() }
+
+// CallOwner classifies the call whose function name starts at line:col and
+// returns its owner. ok is false when no call of name starts there, and when
+// the call has no owner an item can name: top level, module body, a quote
+// body, or a module, function or test label that only exists at compile time.
+func (s *Source) CallOwner(line, col uint, name string) (FunctionOccurrence, Owner, bool) {
+	ident := nodeAtPosition(s.root, line, col)
+	if ident == nil || ident.Kind() != "identifier" || ident.StartPosition() != (tree_sitter.Point{Row: line, Column: col}) {
+		return FunctionOccurrence{}, Owner{}, false
+	}
+	occ := classifyFunctionName(ident, s.src)
+	if occ.Kind != OccurrenceCall || occ.Name != name {
+		return FunctionOccurrence{}, Owner{}, false
+	}
+	for n := ident.Parent(); n != nil; n = n.Parent() {
+		if n.Kind() != "call" || calledBy(n, ident) {
+			continue
+		}
+		keyword := bareCallName(n, s.src)
+		if keyword == "quote" {
+			return FunctionOccurrence{}, Owner{}, false
+		}
+		if !s.ownsBody(n, keyword) {
+			continue
+		}
+		owner, ok := s.owner(n, keyword)
+		return occ, owner, ok
+	}
+	return FunctionOccurrence{}, Owner{}, false
+}
+
+// Clauses returns the def-family clauses of module.name, in source order,
+// whose head accepts arity.
+func (s *Source) Clauses(module, name string, arity int) []Owner {
+	var clauses []Owner
+	var walk func(n *tree_sitter.Node)
+	walk = func(n *tree_sitter.Node) {
+		if n.Kind() == "call" {
+			switch keyword := bareCallName(n, s.src); {
+			case keyword == "quote":
+				return
+			case functionOwnerKeywords[keyword]:
+				clause, ok := s.owner(n, keyword)
+				if ok && clause.Name == name && clause.Module == module && clause.Arity.Matches(arity) {
+					clauses = append(clauses, clause)
+				}
+				return
+			}
+		}
+		for i := uint(0); i < n.NamedChildCount(); i++ {
+			walk(n.NamedChild(i))
+		}
+	}
+	walk(s.root)
+	return clauses
+}
+
+// declarationKeywords are the calls an index row for a function points at.
+var declarationKeywords = map[string]bool{
+	"def": true, "defp": true, "defmacro": true, "defmacrop": true,
+	"defguard": true, "defguardp": true, "defdelegate": true,
+}
+
+// ParseSyntax parses src for declaration geometry only. Unlike ParseSource it
+// keeps a tree recovered from a syntax error: a declaration's span is still
+// its own.
+func ParseSyntax(src []byte) (*Source, bool) {
+	root, cleanup := parseElixir(src)
+	if root == nil {
+		return nil, false
+	}
+	return &Source{root: root, src: src, cleanup: cleanup}, true
+}
+
+// Declaration returns the declaration an index row on row points at: the
+// def-family call starting there that defines name, with the span of its
+// name, or else the defmodule call starting there, with the span of its module
+// name. Keyword says which; Module and Arity are not set. It reads syntax only,
+// as the index does, so a def in a quote counts.
+func (s *Source) Declaration(row uint, name string) (Owner, bool) {
+	var def, module Owner
+	var walk func(n *tree_sitter.Node) bool
+	walk = func(n *tree_sitter.Node) bool {
+		if n.StartPosition().Row > row || n.EndPosition().Row < row {
+			return false
+		}
+		if n.Kind() == "call" && n.StartPosition().Row == row {
+			var ok bool
+			if def, ok = s.functionDeclaration(n, name); ok {
+				return true
+			}
+			if module.Keyword == "" {
+				module, _ = s.moduleDeclaration(n)
+			}
+		}
+		for i := uint(0); i < n.NamedChildCount(); i++ {
+			if walk(n.NamedChild(i)) {
+				return true
+			}
+		}
+		return false
+	}
+	if walk(s.root) {
+		return def, true
+	}
+	return module, module.Keyword != ""
+}
+
+// functionDeclaration returns call as the def-family declaration of name.
+func (s *Source) functionDeclaration(call *tree_sitter.Node, name string) (Owner, bool) {
+	keyword := bareCallName(call, s.src)
+	if !declarationKeywords[keyword] {
+		return Owner{}, false
+	}
+	head := s.headName(call)
+	if head == nil || head.Utf8Text(s.src) != name {
+		return Owner{}, false
+	}
+	return Owner{
+		Keyword: keyword, Name: name, Start: call.StartPosition(), End: call.EndPosition(),
+		NameStart: head.StartPosition(), NameEnd: head.EndPosition(),
+	}, true
+}
+
+// moduleDeclaration returns call as a defmodule declaration named by an alias.
+func (s *Source) moduleDeclaration(call *tree_sitter.Node) (Owner, bool) {
+	if bareCallName(call, s.src) != "defmodule" {
+		return Owner{}, false
+	}
+	alias := firstArgument(call)
+	if alias == nil || alias.Kind() != "alias" {
+		return Owner{}, false
+	}
+	return Owner{
+		Keyword: "defmodule", Name: alias.Utf8Text(s.src), Start: call.StartPosition(), End: call.EndPosition(),
+		NameStart: alias.StartPosition(), NameEnd: alias.EndPosition(),
+	}, true
+}
+
+// Calls returns the call occurrences inside a clause, in source order: its
+// body, guard and default arguments, but not quote bodies.
+func (s *Source) Calls(clause Owner) []FunctionOccurrence {
+	var calls []FunctionOccurrence
+	var walk func(n *tree_sitter.Node)
+	walk = func(n *tree_sitter.Node) {
+		switch n.Kind() {
+		case "call":
+			if bareCallName(n, s.src) == "quote" {
+				return
+			}
+		case "identifier":
+			if occ := classifyFunctionName(n, s.src); occ.Kind == OccurrenceCall {
+				calls = append(calls, occ)
+			}
+			return
+		}
+		for i := uint(0); i < n.NamedChildCount(); i++ {
+			walk(n.NamedChild(i))
+		}
+	}
+	// The clause's own def keyword is its target, not a call it makes.
+	if args := childOfKind(clause.node, "arguments"); args != nil {
+		walk(args)
+	}
+	if block := childOfKind(clause.node, "do_block"); block != nil {
+		walk(block)
+	}
+	return calls
+}
+
+// ownsBody reports whether a call owns the calls in its body: a def-family
+// clause, or a test or setup block with a body.
+func (s *Source) ownsBody(call *tree_sitter.Node, keyword string) bool {
+	return functionOwnerKeywords[keyword] || blockOwnerKeywords[keyword] && hasBody(call, s.src)
+}
+
+// owner builds the owner for a def-family or test/setup call. ok is false
+// when its module, function name or test label is not static.
+func (s *Source) owner(call *tree_sitter.Node, keyword string) (Owner, bool) {
+	module, ok := s.enclosingModule(call)
+	if !ok {
+		return Owner{}, false
+	}
+	o := Owner{Module: module, Keyword: keyword, Start: call.StartPosition(), End: call.EndPosition(), node: call}
+	var name *tree_sitter.Node
+	switch {
+	case functionOwnerKeywords[keyword]:
+		name = s.headName(call)
+		if name == nil {
+			return Owner{}, false
+		}
+		head := classifyFunctionName(name, s.src)
+		if head.Kind != OccurrenceHead {
+			return Owner{}, false
+		}
+		o.Name, o.Arity = head.Name, head.Arity
+	case keyword == "test":
+		name = firstArgument(call)
+		if name == nil || name.Kind() != "string" || childOfKind(name, "interpolation") != nil {
+			return Owner{}, false
+		}
+		o.Name = name.Utf8Text(s.src)
+	default:
+		name = call.ChildByFieldName("target")
+	}
+	o.NameStart, o.NameEnd = name.StartPosition(), name.EndPosition()
+	return o, true
+}
+
+// headName returns the function-name identifier of a def-family call, or
+// nil for a head whose name is built at compile time (unquote) or an
+// operator definition.
+func (s *Source) headName(call *tree_sitter.Node) *tree_sitter.Node {
+	head := firstArgument(call)
+	if head != nil && head.Kind() == "binary_operator" && operatorText(head, s.src) == "when" {
+		head = head.ChildByFieldName("left")
+	}
+	if head == nil {
+		return nil
+	}
+	switch head.Kind() {
+	case "identifier":
+		return head
+	case "call":
+		if target := head.ChildByFieldName("target"); target != nil && target.Kind() == "identifier" {
+			return target
+		}
+	}
+	return nil
+}
+
+// enclosingModule composes the module name from the defmodule calls around
+// node, as Elixir does. ok is false outside any module, inside defimpl or
+// defprotocol, for a module named by an expression, and inside a quote, whose
+// code lands in whichever module expands it.
+func (s *Source) enclosingModule(node *tree_sitter.Node) (string, bool) {
+	module, absolute := "", false
+	for n := node.Parent(); n != nil; n = n.Parent() {
+		if n.Kind() != "call" {
+			continue
+		}
+		switch bareCallName(n, s.src) {
+		case "defmodule":
+			name := firstArgument(n)
+			if name == nil || name.Kind() != "alias" {
+				return "", false
+			}
+			if absolute {
+				continue
+			}
+			// Walking outwards, each enclosing name goes in front.
+			if module == "" {
+				module = name.Utf8Text(s.src)
+			} else {
+				module = name.Utf8Text(s.src) + "." + module
+			}
+			if strings.HasPrefix(module, "Elixir.") {
+				module, absolute = strings.TrimPrefix(module, "Elixir."), true
+			}
+		case "defimpl", "defprotocol", "quote":
+			return "", false
+		}
+	}
+	return module, module != ""
+}
+
+// calledBy reports whether ident is the name call calls, directly or after a
+// dot, rather than something inside it.
+func calledBy(call, ident *tree_sitter.Node) bool {
+	target := call.ChildByFieldName("target")
+	if sameNode(target, ident) {
+		return true
+	}
+	return target != nil && target.Kind() == "dot" && sameNode(target.ChildByFieldName("right"), ident)
+}
+
+// hasBody reports whether a call has a do block or a do: keyword argument.
+func hasBody(call *tree_sitter.Node, src []byte) bool {
+	if childOfKind(call, "do_block") != nil {
+		return true
+	}
+	args := childOfKind(call, "arguments")
+	if args == nil || args.NamedChildCount() == 0 {
+		return false
+	}
+	keywords := args.NamedChild(args.NamedChildCount() - 1)
+	if keywords.Kind() != "keywords" {
+		return false
+	}
+	for i := uint(0); i < keywords.NamedChildCount(); i++ {
+		if key := keywords.NamedChild(i).ChildByFieldName("key"); key != nil && strings.TrimSpace(key.Utf8Text(src)) == "do:" {
+			return true
+		}
+	}
+	return false
+}
+
+func firstArgument(call *tree_sitter.Node) *tree_sitter.Node {
+	args := childOfKind(call, "arguments")
+	if args == nil {
+		return nil
+	}
+	return firstNamedNonComment(args)
+}
+
+func childOfKind(n *tree_sitter.Node, kind string) *tree_sitter.Node {
+	for i := uint(0); i < n.ChildCount(); i++ {
+		if c := n.Child(i); c.Kind() == kind {
+			return c
+		}
+	}
+	return nil
+}
