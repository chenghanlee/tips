+// A function's identity includes its arity: price/1 and price/2 are different
+// functions with different callers and different bodies.
+func TestCallHierarchyArity(t *testing.T) {
+	server, cleanup := setupTestServer(t)
+	t.Cleanup(cleanup)
+	indexFile(t, server.store, server.projectRoot, "lib/pricing.ex", `defmodule MyApp.Pricing do
+  def price(amount), do: price(amount, 1)
+  def price(amount, rate), do: amount * rate
+
+  def fee(amount, rate \\ 2), do: price(amount, rate)
+end
+`)
+	indexFile(t, server.store, server.projectRoot, "lib/checkout.ex", `defmodule MyApp.Checkout do
+  alias MyApp.Pricing
+
+  def one(amount), do: Pricing.price(amount)
+  def two(amount), do: Pricing.price(amount, 2)
+  def piped(amount), do: amount |> Pricing.price()
+end
+`)
+
+	price2 := prepareOne(t, server, "lib/checkout.ex:4:32", "MyApp.Pricing.price/2")
+	price1 := prepareOne(t, server, "lib/checkout.ex:3:32", "MyApp.Pricing.price/1")
+	prepareOne(t, server, "lib/checkout.ex:5:43", "MyApp.Pricing.price/1")
+	prepareOne(t, server, "lib/pricing.ex:2:6", "MyApp.Pricing.price/2")
+	// A head with a default argument names its full-arity clause.
+	fee := prepareOne(t, server, "lib/pricing.ex:4:6", "MyApp.Pricing.fee/2")
+	for _, item := range []protocol.CallHierarchyItem{price1, price2, fee} {
+		assertItemData(t, item)
+	}
+
+	assertRows(t, incomingRows(t, server, incoming(t, server, price1)), []string{
+		`lib/checkout.ex | def MyApp.Checkout.one/1 [3:2-3:44] sel [3:6-3:9] <- 3:31-3:36`,
+		`lib/checkout.ex | def MyApp.Checkout.piped/1 [5:2-5:50] sel [5:6-5:11] <- 5:43-5:48`,
+	})
+	assertRows(t, incomingRows(t, server, incoming(t, server, price2)), []string{
+		`lib/pricing.ex | def MyApp.Pricing.price/1 [1:2-1:41] sel [1:6-1:11] <- 1:25-1:30`,
+		`lib/pricing.ex | def MyApp.Pricing.fee/2 [4:2-4:53] sel [4:6-4:9] <- 4:34-4:39`,
+		`lib/checkout.ex | def MyApp.Checkout.two/1 [4:2-4:47] sel [4:6-4:9] <- 4:31-4:36`,
+	})
+	assertRows(t, outgoingRows(outgoing(t, server, price1)), []string{`MyApp.Pricing.price/2 <- 1:25-1:30`})
+	assertRows(t, outgoingRows(outgoing(t, server, fee)), []string{`MyApp.Pricing.price/2 <- 4:34-4:39`})
+
+	// No price/3 exists. Another arity's item would be a convincing wrong answer.
+	indexFile(t, server.store, server.projectRoot, "lib/wrong.ex", `defmodule MyApp.Wrong do
+  def three(amount), do: MyApp.Pricing.price(amount, 1, 2)
+end
+`)
+	if items := prepareAt(t, server, "lib/wrong.ex:1:40"); len(items) != 0 {
+		t.Fatalf("prepare at price/3 = %s, want none", itemNames(items))
+	}
+}
