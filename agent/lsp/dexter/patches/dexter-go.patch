+	// A line holding calls of both arities is a reference of each, so the
+	// location must span the matching occurrence's name, not the whole line.
+	runArityOccurrences(t, server, []arityOccurrenceCase{
+		{"local put/3", arityAt{put3Head, "put", 1}, sameLine, "put(key, :b, [:c])", "put"},
+		{"qualified Alpha f/3", arityAt{alpha3Head, "f(", 0}, alphaBoth, "Alpha.f(1, 2, 3)", "f"},
+	})
+}
