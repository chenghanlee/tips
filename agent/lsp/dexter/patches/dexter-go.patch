+)
+
+// A name after a dot on a runtime value (schema.__schema__(:source),
+// label.size) is a field or a call whose target is not known statically: it is
+// not a variable, not a binding of itself, and not the receiver. Definition
+// there is empty on every character, even when a local function or variable
+// shares the receiver's or the member's name. The receiver itself, true local
+// variables and static qualified calls still navigate.
+func TestDefinitionRuntimeMember(t *testing.T) {
+	server, cleanup := setupTestServer(t)
+	defer cleanup()
+	indexFile(t, server.store, server.projectRoot, "lib/my_app/known.ex", "defmodule MyApp.Known do\n  def fetch(value), do: value\nend\n")
+	src := `defmodule MyApp.Member do
+  alias MyApp.Known
+
+  def schema, do: :local
+  def label, do: "x"
+
+  def source(schema, label) do
+    size = 1
+    total = label.size + size
+    table = schema.__schema__(:source)
+    again = schema.__schema__(:source)
+    Known.fetch("#{schema.__schema__(:prefix)}#{table}#{again}#{total}")
+    Known.fetch(__MODULE__.label())
+    total |> Known.fetch()
+    schema.meta.state
+  end
+
+  def other, do: schema
+end
+`
+	indexFile(t, server.store, server.projectRoot, "lib/my_app/member.ex", src)
+	docURI := string(uri.File(filepath.Join(server.projectRoot, "lib", "my_app", "member.ex")))
+	server.docs.seed(docURI, src)
+	lines := strings.Split(src, "\n")
+
+	// member returns the columns of a receiver's dot and member name on a line.
+	member := func(line int, receiver, name string) []uint32 {
+		start := strings.Index(lines[line], receiver+"."+name) + len(receiver)
+		var cols []uint32
+		for c := start; c < start+1+len(name); c++ {
+			cols = append(cols, uint32(c))
+		}
+		return cols
+	}
+	col := func(line int, needle string) uint32 { return uint32(strings.Index(lines[line], needle)) }
+
+	for _, tc := range []struct {
+		line int
+		cols []uint32
+	}{
+		{8, member(8, "label", "size")},
+		{9, member(9, "schema", "__schema__")},
+		{10, member(10, "schema", "__schema__")},
+		{11, member(11, "schema", "__schema__")},
+		{14, member(14, "schema", "meta")},
+		{14, member(14, "meta", "state")},
+	} {
+		for _, c := range tc.cols {
+			if locs := definitionAt(t, server, docURI, uint32(tc.line), c); len(locs) != 0 {
+				t.Errorf("definition at %d:%d (%q) = line %d, want none", tc.line, c, lines[tc.line][c:], locs[0].Range.Start.Line)
+			}
+		}
+	}
+
+	memberFile := uri.File(filepath.Join(server.projectRoot, "lib", "my_app", "member.ex"))
+	knownFile := uri.File(filepath.Join(server.projectRoot, "lib", "my_app", "known.ex"))
+	for _, tc := range []struct {
+		name     string
+		line     int
+		col      uint32
+		wantURI  uri.URI
+		wantLine uint32
+	}{
+		{"receiver label", 8, col(8, "label") + 2, memberFile, 6},
+		{"receiver schema", 9, col(9, "schema") + 3, memberFile, 6},
+		{"receiver schema in interpolation", 11, col(11, "schema") + 1, memberFile, 6},
+		{"local size", 8, col(8, "+ size") + 3, memberFile, 7},
+		{"local table in interpolation", 11, col(11, "{table") + 2, memberFile, 9},
+		{"static qualified call", 11, col(11, "fetch") + 2, knownFile, 1},
+		{"__MODULE__ call", 12, col(12, "label") + 2, memberFile, 4},
+		{"piped qualified call", 13, col(13, "fetch") + 1, knownFile, 1},
+		{"receiver of a field chain", 14, col(14, "schema") + 2, memberFile, 6},
+		{"bare zero-arity call, middle", 17, col(17, "schema") + 3, memberFile, 3},
+	} {
+		locs := definitionAt(t, server, docURI, uint32(tc.line), tc.col)
+		if len(locs) != 1 || locs[0].URI != tc.wantURI || locs[0].Range.Start.Line != tc.wantLine {
+			t.Errorf("%s: definition at %d:%d = %v, want %s line %d", tc.name, tc.line, tc.col, locs, filepath.Base(string(tc.wantURI)), tc.wantLine)
+		}
+	}
+
+	// The local variable size is not the field in label.size.
+	field := uint32(strings.Index(lines[8], ".size") + 1)
+	for _, loc := range referencesAt(t, server, docURI, 8, col(8, "+ size")+3) {
+		if loc.Range.Start.Line == 8 && loc.Range.Start.Character == field {
+			t.Errorf("references of local size include the field label.size at 8:%d", field)
+		}
+	}
+}
