+	const caller = `defmodule MyApp.Caller do
+  use MyApp.Web
+  alias MyApp.Door
+  alias MyApp.Gate
+
+  def run(x), do: Gate.check(x)
+  def both(x), do: {Gate.check(x), check(x)}
+end
+`
+	indexFile(t, server.store, server.projectRoot, "lib/caller.ex", caller)
+	callerPath := filepath.Join(server.projectRoot, "lib", "caller.ex")
+
+	gate := callIdentity{module: "MyApp.Gate", function: "check", arity: 1}
+	locations, err := server.ReferenceNames(gate.module, gate.function, NameReferenceOptions{
+		Kind: NameKindCallable, ExcludeStdlib: true, Arity: treesitter.ExactArity(gate.arity),
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var verified []NameLocation
+	for _, location := range locations {
+		if location.FilePath == callerPath {
+			verified = append(verified, location)
+		}
+	}
+
+	// Unchanged source: every call, the one through the use chain included.
+	// The index has no row for that bare call; sharing a line with an indexed
+	// call makes the references search check it.
+	assertRows(t, incomingRows(t, server, server.ownedCalls(callerPath, verified, gate)), []string{
+		`lib/caller.ex | def MyApp.Caller.run/1 [5:2-5:31] sel [5:6-5:9] <- 5:23-5:28`,
+		`lib/caller.ex | def MyApp.Caller.both/1 [6:2-6:44] sel [6:6-6:10] <- 6:25-6:30 6:35-6:40`,
+	})
+
+	// Gate.check becomes Door.check at the same position.
+	changed := strings.Replace(caller, "Gate.check(x)", "Door.check(x)", 1)
+	if err := os.WriteFile(callerPath, []byte(changed), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	assertRows(t, incomingRows(t, server, server.ownedCalls(callerPath, verified, gate)), []string{
+		`lib/caller.ex | def MyApp.Caller.both/1 [6:2-6:44] sel [6:6-6:10] <- 6:25-6:30 6:35-6:40`,
+	})
+}
+
+// The index can lag the source. A stale row must never produce an owner that
+// does not call the target, and files scanned whole still find current owners.
+func TestCallHierarchyStaleIndex(t *testing.T) {
+	server, cleanup := setupTestServer(t)
+	t.Cleanup(cleanup)
+	indexFile(t, server.store, server.projectRoot, "lib/admission.ex", "defmodule MyApp.Admission do\n  def admit(x), do: x\nend\n")
+	indexFile(t, server.store, server.projectRoot, "lib/stale.ex", `defmodule MyApp.Stale do
+  def early(x), do: MyApp.Admission.admit(x)
+end
+`)
+	indexFile(t, server.store, server.projectRoot, "lib/stale_import.ex", `defmodule MyApp.StaleImport do
+  import MyApp.Admission
+
+  def a(x), do: admit(x)
+end
+`)
+	admit := prepareOne(t, server, "lib/admission.ex:1:6", "MyApp.Admission.admit/1")
+	caller := prepareOne(t, server, "lib/stale_import.ex:3:6", "MyApp.StaleImport.a/1")
+
+	// Edit both callers on disk without reindexing.
+	write := func(rel, content string) {
+		if err := os.WriteFile(filepath.Join(server.projectRoot, rel), []byte(content), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	write("lib/stale.ex", `defmodule MyApp.Stale do
+  def early(x), do: Other.Admission.admit(x)
+  def later(x), do: MyApp.Admission.admit(x)
+end
+`)
+	write("lib/stale_import.ex", `defmodule MyApp.StaleImport do
+  import MyApp.Admission
+
+  def b(x), do: x
+  def a(x), do: admit(x) |> MyApp.Stale.early()
+end
+`)
+
+	// early/1 no longer calls admit. later/1 does, on a line the index never
+	// saw; the index still lists the file, which is scanned whole.
+	assertRows(t, incomingRows(t, server, incoming(t, server, admit)), []string{
+		`lib/stale.ex | def MyApp.Stale.later/1 [2:2-2:44] sel [2:6-2:11] <- 2:36-2:41`,
+		`lib/stale_import.ex | def MyApp.StaleImport.a/1 [4:2-4:47] sel [4:6-4:7] <- 4:16-4:21`,
+	})
+	assertRows(t, outgoingRows(outgoing(t, server, caller)), []string{
+		`MyApp.Admission.admit/1 <- 4:16-4:21`,
+		`MyApp.Stale.early/1 <- 4:40-4:45`,
+	})
+}
+
+// Outgoing calls list every call occurrence in every clause of the function,
+// each resolved the way references resolves it. Library targets are kept.
+// Absent on purpose: Erlang module calls (:inet, :ets, :crypto), anonymous
+// calls (write.()), field access (state.table), operators and language forms
+// (if, case). A guard or default argument belongs to its clause, as it does for
+// incoming calls, so is_binary/1 in the admit/3 guard is a row.
+func TestCallHierarchyOutgoing(t *testing.T) {
+	server := callHierarchyProject(t, "outgoing")
+	server.SetStdlibRoot(filepath.Join(server.projectRoot, "stdlib"))
+	indexAndCompile(t, server, "Shop.Repo", "lib/shop/repo.ex", "defmodule Shop.Repo do\n  use Shop.RepoMacro\nend\n",
+		beamExport{"delete!", 1}, beamExport{"insert!", 1}, beamExport{"one", 1})
+	bumpDirMtime(t, filepath.Join(server.projectRoot, "_build", "dev", "lib", "my_app", "ebin"))
+
+	for _, tc := range []struct {
+		name, query, caller string
+		want                []string
+	}{
+		{"E1 deliver/1", "lib/shop/accounts.ex:3:6", "Shop.Accounts.deliver/1", []string{"Shop.Token.build/2 <- 4:18-4:23", "Shop.Repo.insert!/1 <- 5:9-5:16", "Shop.Mailer.send_login/2 <- 6:16-6:26"}},
+		{"E2 update/2 pipes", "lib/shop/accounts.ex:9:6", "Shop.Accounts.update/2", []string{"Shop.Token.changeset/2 <- 11:13-11:22", "Shop.Accounts.save_and_clear/1 <- 12:7-12:21"}},
+		{"E3 capture", "lib/shop/accounts.ex:15:6", "Shop.Accounts.normalize_all/1", []string{"Enum.map/2 <- 16:9-16:12", "Shop.Accounts.normalize/1 <- 16:22-16:31"}},
+		{"E4 default head", "lib/shop/accounts.ex:19:6", "Shop.Accounts.admit/3", []string{"Kernel.is_binary/1 <- 21:36-21:45", "Shop.Token.normalize/1 <- 22:23-22:32", "GenServer.call/2 <- 25:16-25:20"}},
+		{"E5 second clause", "lib/shop/accounts.ex:35:6", "Shop.Accounts.handle/2", []string{"Enum.map/2 <- 36:19-36:22", "Shop.Accounts.entry/2 <- 36:30-36:35", "Enum.find/2 <- 38:14-38:18", "Shop.Accounts.limited/1 <- 40:23-40:30"}},
+		{"E6 no calls", "lib/shop/accounts.ex:44:6", "Shop.Accounts.version/0", []string{}},
+		{"E7 generated", "lib/shop/accounts.ex:46:7", "Shop.Accounts.save_and_clear/1", []string{"Shop.Repo.insert!/1 <- 47:15-47:22", "Shop.Repo.delete!/1 <- 48:9-48:16"}},
+		{"E8 test helper", "test/shop/accounts_test.exs:9:7", "Shop.AccountsTest.synchronized_write/2", []string{"Shop.Repo.one/1 <- 10:15-10:18", "Kernel.send/2 <- 11:4-11:8", "Kernel.self/0 <- 11:26-11:30", "Shop.AccountsTest.await/1 <- 12:4-12:9"}},
+		{"sibling deliver/2", "lib/shop/accounts.ex:56:6", "Shop.Accounts.deliver/2", []string{"Shop.Token.verify/1 <- 57:10-57:16"}},
+		{"sibling admit/1", "lib/shop/accounts.ex:60:6", "Shop.Accounts.admit/1", []string{"Shop.Token.verify/1 <- 60:30-60:36"}},
+		{"grouped by target arity", "lib/shop/mail.ex:3:6", "Shop.Mail.check/1", []string{"Shop.Token.verify/1 <- 4:10-4:16 7:10-7:16", "Shop.Token.verify/2 <- 5:10-5:16"}},
+		{"quote body excluded", "lib/shop/macros.ex:1:11", "Shop.Macros.traced/1", []string{"Shop.Token.verify/1 <- 2:15-2:21"}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			calls := outgoing(t, server, prepareOne(t, server, tc.query, tc.caller))
