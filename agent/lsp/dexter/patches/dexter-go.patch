+// Elixir picks a bare call's provider by name and arity: a local f/1 does not
+// shadow an imported f/2.
+func TestCallHierarchyImportedArity(t *testing.T) {
+	server, cleanup := setupTestServer(t)
+	t.Cleanup(cleanup)
+	indexFile(t, server.store, server.projectRoot, "lib/provider.ex", "defmodule MyApp.Provider do\n  def f(a, b), do: {a, b}\nend\n")
+	indexFile(t, server.store, server.projectRoot, "lib/local.ex", `defmodule MyApp.Local do
+  import MyApp.Provider
+
+  def f(a), do: a
+  def run(x), do: f(x, x)
+end
+`)
+
+	imported := prepareOne(t, server, "lib/local.ex:4:18", "MyApp.Provider.f/2")
+	local := prepareOne(t, server, "lib/local.ex:3:6", "MyApp.Local.f/1")
+	run := prepareOne(t, server, "lib/local.ex:4:6", "MyApp.Local.run/1")
+
+	assertRows(t, incomingRows(t, server, incoming(t, server, imported)), []string{
+		`lib/local.ex | def MyApp.Local.run/1 [4:2-4:25] sel [4:6-4:9] <- 4:18-4:19`,
+	})
+	if calls := incoming(t, server, local); len(calls) != 0 {
+		t.Fatalf("incoming calls of MyApp.Local.f/1 = %v, want none", incomingRows(t, server, calls))
+	}
+	assertRows(t, outgoingRows(outgoing(t, server, run)), []string{`MyApp.Provider.f/2 <- 4:18-4:19`})
+}
