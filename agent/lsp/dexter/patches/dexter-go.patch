diff --git a/internal/lsp/arity_navigation.go b/internal/lsp/arity_navigation.go
new file mode 100644
index 0000000..8c45367
--- /dev/null
+++ b/internal/lsp/arity_navigation.go
@@ -0,0 +1,378 @@
+// Package lsp implements Dexter's language server.
+package lsp
+
+import (
+	"sort"
+	"strings"
+
+	"github.com/remoteoss/dexter/internal/beam"
+	"github.com/remoteoss/dexter/internal/store"
+	"github.com/remoteoss/dexter/internal/treesitter"
+	"go.lsp.dev/protocol"
+)
+
+// A function's identity is module, name and arity. The helpers here take the
+// arity from the syntax at a source occurrence and hand it to the existing
+// name lookups; an unknown arity leaves those lookups as name searches.
+
+// nameAtCursor is the namespace and arity of the name under a cursor.
+type nameAtCursor struct {
+	// inTypespec is set when the name refers to a type.
+	inTypespec bool
+	// callback is set on the name of a @callback or @macrocallback head,
+	// which declares a callback rather than referring to a function.
+	callback bool
+	arity    treesitter.Arity
+}
+
+// functionNameAt classifies the function name under the cursor with the
+// document's syntax tree. Without a tree, or on a name without call syntax,
+// it falls back to the token check for typespecs and an unknown arity.
+func (s *Server) functionNameAt(docURI string, tf *TokenizedFile, line, col int, name string) nameAtCursor {
+	occ, ok := s.cursorFunctionOccurrence(docURI, line, col, name)
+	if !ok {
+		return nameAtCursor{inTypespec: tf.InTypespec(line)}
+	}
+	switch occ.Kind {
+	case treesitter.OccurrenceTypespec:
+		return nameAtCursor{inTypespec: true}
+	case treesitter.OccurrenceCallbackHead:
+		return nameAtCursor{callback: true, arity: occ.Arity}
+	case treesitter.OccurrenceCall, treesitter.OccurrenceHead, treesitter.OccurrenceSpecHead:
+		return nameAtCursor{arity: occ.Arity}
+	}
+	return nameAtCursor{inTypespec: tf.InTypespec(line)}
+}
+
+// referenceArity returns the arity a references request at the cursor asks
+// for and whether the name is a type. A @callback head and a name in a
+// typespec keep the name search.
+func (s *Server) referenceArity(docURI string, tf *TokenizedFile, line, col int, name string) (arity treesitter.Arity, inTypespec bool) {
+	if name == "" {
+		return treesitter.Arity{}, tf.InTypespec(line)
+	}
+	cursor := s.functionNameAt(docURI, tf, line, col, name)
+	if cursor.callback {
+		return treesitter.Arity{}, tf.InTypespec(line)
+	}
+	if cursor.inTypespec {
+		return treesitter.Arity{}, true
+	}
+	return cursor.arity, false
+}
+
+// findForCursor finds the buffer definition of the name under a cursor: the
+// type in a typespec, otherwise the first function head the arity reaches.
+func (tf *TokenizedFile) findForCursor(name string, cursor nameAtCursor) (int, bool) {
+	if cursor.inTypespec {
+		return tf.FindTypeDefinition(name)
+	}
+	return tf.FindFunctionDefinitionWithArity(name, cursor.arity)
+}
+
+func (s *Server) cursorFunctionOccurrence(docURI string, line, col int, name string) (treesitter.FunctionOccurrence, bool) {
+	if line < 0 || col < 0 {
+		return treesitter.FunctionOccurrence{}, false
+	}
+	tree, src, release, ok := s.docs.GetTree(docURI)
+	if !ok {
+		return treesitter.FunctionOccurrence{}, false
+	}
+	defer release()
+	occ, ok := treesitter.FunctionOccurrenceAt(tree.RootNode(), src, uint(line), uint(col))
+	if !ok || occ.Name != name {
+		return treesitter.FunctionOccurrence{}, false
+	}
+	return occ, true
+}
+
+// hoverLookup returns the store definitions a hover on module.function can
+// show: those the cursor's arity reaches, following delegates when enabled.
+func (s *Server) hoverLookup(module, function string, cursor nameAtCursor) []store.LookupResult {
+	var results []store.LookupResult
+	var err error
+	if s.followDelegates {
+		results, err = s.followDelegatesArity(module, function, cursor.arity)
+	} else {
+		results, err = s.store.LookupFunction(module, function)
+		results = filterArity(results, cursor.arity)
+	}
+	if err != nil {
+		return nil
+	}
+	return results
+}
+
+// nameLocationRange is the protocol range of a reference: the name token when
+// it was matched as an occurrence, the whole line otherwise.
+func (s *Server) nameLocationRange(r NameLocation) protocol.Range {
+	if r.EndColumn > 0 {
+		if line, ok := s.getFileLine(r.FilePath, r.Line); ok {
+			return protocol.Range{
+				Start: s.outPosLine(line, r.Line-1, r.Column),
+				End:   s.outPosLine(line, r.Line-1, r.EndColumn),
+			}
+		}
+	}
+	return lineRange(r.Line - 1)
+}
+
+// withArity keeps the items a call of the given arity can reach. An unknown
+// arity keeps them all.
+func withArity[T any](items []T, arity treesitter.Arity, arityOf func(T) int) []T {
+	if !arity.Known {
+		return items
+	}
+	var matched []T
+	for _, item := range items {
+		if arity.Matches(arityOf(item)) {
+			matched = append(matched, item)
+		}
+	}
+	return matched
+}
+
+// filterArity keeps the definitions a call of the given arity can reach.
+func filterArity(results []store.LookupResult, arity treesitter.Arity) []store.LookupResult {
+	return withArity(results, arity, func(r store.LookupResult) int { return r.Arity })
+}
+
+// generatedWithArity keeps the generated functions a call of the given arity
+// can reach.
+func generatedWithArity(functions []beam.Function, arity treesitter.Arity) []beam.Function {
+	return withArity(functions, arity, func(f beam.Function) int { return f.Arity })
+}
+
+// inlineDefResults returns the definitions a __using__ quote block injects
+// under one name that a call of the given arity can reach.
+func inlineDefResults(filePath string, defs []inlineDef, arity treesitter.Arity) []store.LookupResult {
+	var results []store.LookupResult
+	for _, d := range withArity(defs, arity, func(d inlineDef) int { return d.arity }) {
+		results = append(results, store.LookupResult{FilePath: filePath, Line: d.line, Kind: d.kind, Arity: d.arity})
+	}
+	return results
+}
+
+// occurrenceGroup is one function whose occurrences a references request
+// collects: the looked-up function itself, or a defdelegate facade that
+// forwards to it.
+type occurrenceGroup struct {
+	function string
+	// arity is the range of calls that reach the looked-up function: the
+	// queried arity, or every arity of a delegate head.
+	arity treesitter.Arity
+	// modules are the providers an occurrence may resolve to: the looked-up
+	// module and the modules whose __using__ injects it (or the facade).
+	modules map[string]bool
+	// files are the candidate files, each scanned whole: the index misses
+	// some calls even in files it lists.
+	files map[string]bool
+}
+
+func newOccurrenceGroup(function string, arity treesitter.Arity, modules ...string) occurrenceGroup {
+	g := occurrenceGroup{function: function, arity: arity, modules: map[string]bool{}, files: map[string]bool{}}
+	for _, m := range modules {
+		g.modules[m] = true
+	}
+	return g
+}
+
+func (g occurrenceGroup) addCandidates(refs []store.ReferenceResult) {
+	for _, r := range refs {
+		g.files[r.FilePath] = true
+	}
+}
+
+// addDefinitionFiles adds the files that define module.function, as
+// findBareCallRefs does for the name search, and the files that import
+// module: the index has no row for an imported &function/arity or a call
+// after a one-line def head.
+func (g occurrenceGroup) addDefinitionFiles(s *Server, module, function string) {
+	defs, err := s.store.LookupFunction(module, function)
+	if err != nil {
+		return
+	}
+	for _, d := range defs {
+		g.files[d.FilePath] = true
+	}
+	refs, err := s.store.LookupReferences(module, "")
+	if err != nil {
+		return
+	}
+	for _, r := range refs {
+		if r.Kind == "import" {
+			g.files[r.FilePath] = true
+		}
+	}
+}
+
+// referenceOccurrences answers a references request for one function
+// identity. The indexed references, the definition files and the importing
+// files only name the files to scan. Each occurrence there is kept when its
+// written argument count matches and it resolves, with the scope rules
+// go-to-definition uses, to one of the group's modules.
+func (s *Server) referenceOccurrences(module, function string, opts NameReferenceOptions, candidates []store.ReferenceResult, injectors []string) ([]NameLocation, error) {
+	main := newOccurrenceGroup(function, opts.Arity, append([]string{module}, injectors...)...)
+	main.addCandidates(candidates)
+	main.addDefinitionFiles(s, module, function)
+	groups := []occurrenceGroup{main}
+	if opts.FollowDelegates {
+		groups = append(groups, s.delegateGroups(module, function, opts.Arity)...)
+	}
+
+	var locations []NameLocation
+	seen := map[nameLocationKey]struct{}{}
+	for _, g := range groups {
+		for _, loc := range s.groupOccurrences(g, opts.ExcludeStdlib) {
+			appendNameLocation(&locations, seen, loc)
+		}
+	}
+
+	if opts.IncludeDeclaration {
+		declarations, err := s.LookupName(module, function, NameLookupOptions{Kind: opts.Kind, ExcludeStdlib: opts.ExcludeStdlib, Arity: opts.Arity})
+		if err != nil {
+			return nil, err
+		}
+		for _, declaration := range declarations {
+			declaration.IsDeclaration = true
+			appendNameLocation(&locations, seen, declaration)
+		}
+	}
+	return locations, nil
+}
+
+// delegateGroups returns a group per defdelegate facade head that forwards to
+// module.function with the given arity. Every arity of a head forwards to its
+// full arity, so a head joins when that arity is the queried one, and then
+// calls of all its arities reach the function.
+func (s *Server) delegateGroups(module, function string, arity treesitter.Arity) []occurrenceGroup {
+	delegates, err := s.store.LookupDelegatesTo(module, function)
+	if err != nil {
+		return nil
+	}
+	var groups []occurrenceGroup
+	heads := map[delegateHead]bool{}
+	for _, delegate := range delegates {
+		headArity, ok := s.delegateHeadArity(delegate.FilePath, delegate.Line, delegate.Function)
+		head := delegateHead{delegate.Module, delegate.Function, headArity}
+		if !ok || heads[head] || !arity.Matches(head.arity.Max) {
+			continue
+		}
+		heads[head] = true
+		g := newOccurrenceGroup(head.function, head.arity, head.module)
+		if refs, err := s.store.LookupReferences(head.module, head.function); err == nil {
+			g.addCandidates(refs)
+		}
+		g.addDefinitionFiles(s, head.module, head.function)
+		groups = append(groups, g)
+	}
+	return groups
+}
+
+// groupOccurrences returns the matching occurrences in g's files, in file
+// order.
+func (s *Server) groupOccurrences(g occurrenceGroup, excludeStdlib bool) []NameLocation {
+	files := make([]string, 0, len(g.files))
+	for file := range g.files {
+		if !excludeStdlib || !s.isStdlibPath(file) {
+			files = append(files, file)
+		}
+	}
+	sort.Strings(files)
+	var out []NameLocation
+	for _, file := range files {
+		out = append(out, s.matchOccurrences(file, g)...)
+	}
+	return out
+}
+
+// matchOccurrences returns the occurrences of g.function in one file that
+// have g's arity and resolve to one of g's modules.
+func (s *Server) matchOccurrences(file string, g occurrenceGroup) []NameLocation {
+	text, _, ok := s.readFileText(file)
+	if !ok {
+		return nil
+	}
+	var tf *TokenizedFile
+	aliasesAt := map[int]map[string]string{}
+	var out []NameLocation
+	for _, occ := range treesitter.FunctionOccurrencesInSource([]byte(text), g.function) {
+		if occ.Kind != treesitter.OccurrenceCall || !g.arity.Matches(occ.Arity.Min) {
+			continue
+		}
+		line := int(occ.Line)
+		if tf == nil {
+			tf = NewTokenizedFile(text)
+		}
+		aliases, ok := aliasesAt[line]
+		if !ok {
+			aliases = tf.ExtractAliasesInScope(line)
+			s.mergeAliasesFromUseTokenized(tf, aliases)
+			aliasesAt[line] = aliases
+		}
+		if !g.modules[s.occurrenceModule(file, text, tf, occ, aliases)] {
+			continue
+		}
+		out = append(out, NameLocation{
+			FilePath:  file,
+			Line:      int(occ.NameLine) + 1,
+			Kind:      "call",
+			Column:    int(occ.NameCol),
+			EndColumn: int(occ.NameEndCol),
+		})
+	}
+	return out
+}
+
+// delegateHead is one defdelegate head and the arities it accepts.
+type delegateHead struct {
+	module, function string
+	arity            treesitter.Arity
+}
+
+// delegateHeadArity returns the arities of the defdelegate head of function
+// on line (1-based) of file. The index keeps one row per arity a head with
+// defaults accepts, so the head is read from source. ok is false without
+// readable source or such a head.
+func (s *Server) delegateHeadArity(file string, line int, function string) (treesitter.Arity, bool) {
+	text, _, ok := s.readFileText(file)
+	if !ok {
+		return treesitter.Arity{}, false
+	}
+	for _, occ := range treesitter.FunctionOccurrencesInSource([]byte(text), function) {
+		if occ.Kind == treesitter.OccurrenceHead && occ.Keyword == "defdelegate" && int(occ.NameLine)+1 == line {
+			return occ.Arity, true
+		}
+	}
+	return treesitter.Arity{}, false
+}
+
+// followDelegatesArity is store.LookupFollowDelegate for a call of the given
+// arity: a delegate row forwards to its head's full arity.
+func (s *Server) followDelegatesArity(module, function string, arity treesitter.Arity) ([]store.LookupResult, error) {
+	if !arity.Known {
+		return s.store.LookupFollowDelegate(module, function)
+	}
+	return s.store.LookupFollowDelegateArity(module, function, arity.Min, arity.Max, func(r store.LookupResult, hopFunction string) int {
+		// After an as: rename the hop's function is not the looked-up one.
+		if head, ok := s.delegateHeadArity(r.FilePath, r.Line, hopFunction); ok {
+			return head.Max
+		}
+		return r.Arity
+	})
+}
+
+// occurrenceModule resolves the module an occurrence calls, the same way
+// go-to-definition resolves it at a cursor.
+func (s *Server) occurrenceModule(path, text string, tf *TokenizedFile, occ treesitter.FunctionOccurrence, aliases map[string]string) string {
+	line := int(occ.Line)
+	if occ.Qualifier == "" {
+		module, _ := s.resolveBareFunctionModuleWithOrigin(path, text, tf, line, occ.Name, aliases, occ.Arity)
+		return module
+	}
+	qualifier := tf.ResolveModuleExpr(occ.Qualifier, line)
+	if strings.HasPrefix(qualifier, ":") {
+		return ""
+	}
+	return s.resolveModuleWithNesting(qualifier, aliases, path, line)
+}
diff --git a/internal/lsp/call_hierarchy.go b/internal/lsp/call_hierarchy.go
new file mode 100644
index 0000000..a7e5744
--- /dev/null
+++ b/internal/lsp/call_hierarchy.go
@@ -0,0 +1,492 @@
+package lsp
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+
+	"github.com/remoteoss/dexter/internal/beam"
+	"github.com/remoteoss/dexter/internal/parser"
+	"github.com/remoteoss/dexter/internal/store"
+	"github.com/remoteoss/dexter/internal/treesitter"
+	tree_sitter "github.com/tree-sitter/go-tree-sitter"
+	"go.lsp.dev/protocol"
+	"go.lsp.dev/uri"
+)
+
+// The call hierarchy works on one function identity: module, name and arity.
+// Incoming calls are the occurrence-verified references of that identity,
+// each credited to the block that lexically contains it. Outgoing calls are
+// the call occurrences in every clause of it, each resolved the way
+// references resolves it. Both read the current source; index rows only say
+// where to look.
+
+// callIdentity is the function a call-hierarchy item names.
+type callIdentity struct {
+	module, function string
+	arity            int
+}
+
+// callHierarchyData is the identity an item carries between requests.
+type callHierarchyData struct {
+	Module   string `json:"module"`
+	Function string `json:"function"`
+	Arity    int    `json:"arity"`
+}
+
+func newCallHierarchyData(module, function string, arity int) callHierarchyData {
+	return callHierarchyData{Module: module, Function: function, Arity: arity}
+}
+
+// errNoCallIdentity refuses an item that carries data this server did not
+// write: it names no module, function and arity.
+var errNoCallIdentity = errors.New("call hierarchy item names no function; prepare the call hierarchy again")
+
+// callHierarchyIdentity reads an item's data as this server wrote it or as
+// a client sends it back after a JSON round trip. ok is false unless it names
+// a module, a function and an arity.
+func callHierarchyIdentity(data interface{}) (callIdentity, bool) {
+	switch d := data.(type) {
+	case callHierarchyData:
+		return callIdentity{d.Module, d.Function, d.Arity}, d.Module != "" && d.Function != "" && d.Arity >= 0
+	case map[string]interface{}:
+		module, _ := d["module"].(string)
+		function, _ := d["function"].(string)
+		arity, ok := d["arity"].(float64)
+		ok = ok && arity >= 0 && arity == float64(int(arity))
+		return callIdentity{module, function, int(arity)}, ok && module != "" && function != ""
+	}
+	return callIdentity{}, false
+}
+
+// itemIdentity is the function a follow-up request's item names. A test or
+// setup block carries no data: nothing calls it and its calls are not listed.
+func itemIdentity(item protocol.CallHierarchyItem) (id callIdentity, ok bool, err error) {
+	if item.Data == nil {
+		return callIdentity{}, false, nil
+	}
+	if id, ok = callHierarchyIdentity(item.Data); !ok {
+		return callIdentity{}, false, errNoCallIdentity
+	}
+	return id, true, nil
+}
+
+func (s *Server) prepareCallHierarchy(params *protocol.CallHierarchyPrepareParams) ([]protocol.CallHierarchyItem, error) {
+	docURI := string(params.TextDocument.URI)
+	text, ok := s.docs.GetOrLoad(docURI)
+	if !ok {
+		return nil, nil
+	}
+
+	lines := strings.Split(text, "\n")
+	lineNum := int(params.Position.Line)
+	col := s.inCol(lines, lineNum, params.Position.Character)
+	if lineNum >= len(lines) {
+		return nil, nil
+	}
+
+	tf := s.docs.GetTokenizedFile(docURI)
+	if tf == nil {
+		tf = NewTokenizedFile(text)
+	}
+	callCtx := tf.ExpressionAtCursor(lineNum, col)
+	functionName := callCtx.FunctionName
+	if functionName == "" {
+		return nil, nil
+	}
+
+	aliases := tf.ExtractAliasesInScope(lineNum)
+	s.mergeAliasesFromUseTokenized(tf, aliases)
+	// A bare name's provider depends on its arity: a local f/1 does not shadow
+	// an imported f/2.
+	arity := s.functionNameAt(docURI, tf, lineNum, col, functionName).arity
+	var fullModule string
+	if callCtx.ModuleRef != "" {
+		fullModule = s.resolveModuleWithNesting(tf.ResolveModuleExpr(callCtx.ModuleRef, lineNum), aliases, uriToPath(protocol.DocumentURI(docURI)), lineNum)
+	} else {
+		fullModule, _ = s.resolveBareFunctionModuleWithOrigin(uriToPath(protocol.DocumentURI(docURI)), text, tf, lineNum, functionName, aliases, arity)
+	}
+	var generatedFunctions []beam.Function
+	if fullModule == "" {
+		currentModule := extractEnclosingModuleFromTokens(tf.source, tf.tokens, lineNum)
+		if provider, functions, found := s.generatedSymbolInScope(currentModule, func() []string {
+			return s.enclosingBlockPath(docURI, lineNum, col)
+		}, functionName); found {
+			fullModule, generatedFunctions = provider.module, functions
+		} else {
+			return nil, nil
+		}
+	}
+
+	defResults, err := s.store.LookupFunction(fullModule, functionName)
+	if err != nil || len(defResults) == 0 {
+		if len(generatedFunctions) == 0 {
+			generatedFunctions, _ = s.generatedSymbol(fullModule, "", functionName)
+		}
+		if len(generatedFunctions) == 0 {
+			return nil, nil
+		}
+		defResults = s.generatedDefinitionResults(fullModule)
+		if len(defResults) == 0 {
+			return nil, nil
+		}
+	}
+
+	r, ok := definitionForArity(defResults, generatedFunctions, itemArity(arity))
+	if !ok {
+		return nil, nil
+	}
+	files := itemFiles{}
+	defer files.close()
+	item, ok := s.definitionItem(files, fullModule, functionName, r)
+	if !ok {
+		return nil, nil
+	}
+	return []protocol.CallHierarchyItem{item}, nil
+}
+
+// definitionForArity picks the row an item names: the first definition with
+// the arity, or for a generated function the module row labelled with the
+// first export of it. A known arity with no such function is not this
+// function; an unknown arity keeps the first.
+func definitionForArity(rows []store.LookupResult, generated []beam.Function, arity treesitter.Arity) (store.LookupResult, bool) {
+	if len(generated) > 0 {
+		generated = generatedWithArity(generated, arity)
+		if len(generated) == 0 || len(rows) == 0 {
+			return store.LookupResult{}, false
+		}
+		r := rows[0]
+		r.Arity, r.Kind = generated[0].Arity, generated[0].Kind
+		return r, true
+	}
+	if rows = filterArity(rows, arity); len(rows) > 0 {
+		return rows[0], true
+	}
+	return store.LookupResult{}, false
+}
+
+// itemArity is the arity an item names for the syntax at a cursor: a head
+// with default arguments names its full-arity clause.
+func itemArity(arity treesitter.Arity) treesitter.Arity {
+	if arity.Known && arity.Min != arity.Max {
+		return treesitter.ExactArity(arity.Max)
+	}
+	return arity
+}
+
+// definitionItem is the item for one definition row of module.function: it
+// spans the declaration the row points at and selects its name. A generated
+// function has no declaration of its own; its row is the module that
+// generates it, so the item spans that module's declaration and selects the
+// module's name, and keeps the function's identity. ok is false when the
+// source declares neither there any more.
+func (s *Server) definitionItem(files itemFiles, module, function string, r store.LookupResult) (protocol.CallHierarchyItem, bool) {
+	file := files.get(s, r.FilePath)
+	if file == nil {
+		return protocol.CallHierarchyItem{}, false
+	}
+	decl, ok := file.source.Declaration(uint(r.Line-1), function)
+	if !ok {
+		return protocol.CallHierarchyItem{}, false
+	}
+	lines := file.lines
+	return protocol.CallHierarchyItem{
+		Name:           fmt.Sprintf("%s.%s/%d", module, function, r.Arity),
+		Kind:           protocol.SymbolKindFunction,
+		Detail:         r.Kind,
+		URI:            uri.File(r.FilePath),
+		Range:          s.pointRange(lines, decl.Start, decl.End),
+		SelectionRange: s.pointRange(lines, decl.NameStart, decl.NameEnd),
+		Data:           newCallHierarchyData(module, function, r.Arity),
+	}, true
+}
+
+// itemFiles are the files one request builds items in, each read and parsed
+// once.
+type itemFiles map[string]*itemFile
+
+type itemFile struct {
+	source *treesitter.Source
+	lines  []string
+}
+
+// get returns the parsed file at path, or nil when it cannot be read.
+func (files itemFiles) get(s *Server, path string) *itemFile {
+	if file, seen := files[path]; seen {
+		return file
+	}
+	var file *itemFile
+	if text, _, ok := s.readFileText(path); ok {
+		if source, ok := treesitter.ParseSyntax([]byte(text)); ok {
+			file = &itemFile{source: source, lines: strings.Split(text, "\n")}
+		}
+	}
+	files[path] = file
+	return file
+}
+
+func (files itemFiles) close() {
+	for _, file := range files {
+		if file != nil {
+			file.source.Close()
+		}
+	}
+}
+
+func (s *Server) incomingCalls(item protocol.CallHierarchyItem) ([]protocol.CallHierarchyIncomingCall, error) {
+	id, ok, err := itemIdentity(item)
+	if !ok {
+		return nil, err
+	}
+	// An identity search returns only occurrences matched in current source.
+	locations, err := s.ReferenceNames(id.module, id.function, NameReferenceOptions{
+		Kind:          NameKindCallable,
+		ExcludeStdlib: true,
+		Arity:         treesitter.ExactArity(id.arity),
+	})
+	if err != nil {
+		return nil, err
+	}
+	var files []string
+	byFile := map[string][]NameLocation{}
+	for _, location := range locations {
+		if _, seen := byFile[location.FilePath]; !seen {
+			files = append(files, location.FilePath)
+		}
+		byFile[location.FilePath] = append(byFile[location.FilePath], location)
+	}
+	var calls []protocol.CallHierarchyIncomingCall
+	for _, file := range files {
+		calls = append(calls, s.ownedCalls(file, byFile[file], id)...)
+	}
+	return calls, nil
+}
+
+// ownedCalls groups one file's reference occurrences by their owners. The
+// file is read again, so each occurrence is checked once more at its exact
+// position, name, arity and module: text that changed since the references
+// search is omitted rather than credited to whatever is there now.
+//
+// The module must be the function's own. The search also accepts a module
+// whose __using__ imports it, but a bare call resolves there only to a def
+// that __using__ injects: another function, so the call is not credited.
+func (s *Server) ownedCalls(file string, locations []NameLocation, id callIdentity) []protocol.CallHierarchyIncomingCall {
+	text, _, ok := s.readFileText(file)
+	if !ok {
+		return nil
+	}
+	source, ok := treesitter.ParseSource([]byte(text))
+	if !ok {
+		return nil
+	}
+	defer source.Close()
+	lines := strings.Split(text, "\n")
+	moduleOf := s.occurrenceResolver(file, text)
+
+	calls := []protocol.CallHierarchyIncomingCall{}
+	byOwner := map[tree_sitter.Point]int{}
+	for _, location := range locations {
+		if location.EndColumn == 0 {
+			continue
+		}
+		occ, owner, ok := source.CallOwner(uint(location.Line-1), uint(location.Column), id.function)
+		if !ok || !occ.Arity.Matches(id.arity) || moduleOf(&occ) != id.module {
+			continue
+		}
+		i, seen := byOwner[owner.Start]
+		if !seen {
+			i = len(calls)
+			byOwner[owner.Start] = i
+			calls = append(calls, protocol.CallHierarchyIncomingCall{From: s.ownerItem(file, lines, owner)})
+		}
+		calls[i].FromRanges = append(calls[i].FromRanges, s.nameRange(lines, &occ))
+	}
+	return calls
+}
+
+// ownerItem is the item for a call's owner. A function carries its identity
+// for follow-up requests; a test or setup block is not callable and carries
+// none.
+func (s *Server) ownerItem(file string, lines []string, o treesitter.Owner) protocol.CallHierarchyItem {
+	item := protocol.CallHierarchyItem{
+		Kind:           protocol.SymbolKindFunction,
+		Detail:         o.Keyword,
+		URI:            uri.File(file),
+		Range:          s.pointRange(lines, o.Start, o.End),
+		SelectionRange: s.pointRange(lines, o.NameStart, o.NameEnd),
+	}
+	if o.IsFunction() {
+		item.Name = fmt.Sprintf("%s.%s/%d", o.Module, o.Name, o.Arity.Max)
+		item.Data = newCallHierarchyData(o.Module, o.Name, o.Arity.Max)
+	} else {
+		item.Name = strings.TrimSpace(o.Module + " " + o.Keyword + " " + o.Name)
+	}
+	return item
+}
+
+func (s *Server) outgoingCalls(item protocol.CallHierarchyItem) ([]protocol.CallHierarchyOutgoingCall, error) {
+	id, ok, err := itemIdentity(item)
+	if !ok {
+		return nil, err
+	}
+	// The index names the files that define the function; its clauses and
+	// their calls are read from current source.
+	defs, err := s.store.LookupFunction(id.module, id.function)
+	if err != nil {
+		return nil, err
+	}
+	var sites []outgoingSite
+	found := false
+	seenFiles := map[string]bool{}
+	for _, def := range defs {
+		if seenFiles[def.FilePath] {
+			continue
+		}
+		seenFiles[def.FilePath] = true
+		if fileSites, ok := s.outgoingSites(def.FilePath, id); ok {
+			found = true
+			sites = append(sites, fileSites...)
+		}
+	}
+	if !found {
+		return nil, nil
+	}
+	// Calls are grouped by the function they reach. Its item is built once,
+	// from the first of its definition rows whose declaration is in source.
+	files := itemFiles{}
+	defer files.close()
+	calls := []protocol.CallHierarchyOutgoingCall{}
+	byTarget := map[string]int{}
+	for n := range sites {
+		site := &sites[n]
+		name := fmt.Sprintf("%s.%s/%d", site.module, site.function, site.arity)
+		i, seen := byTarget[name]
+		if !seen {
+			i = -1
+			for _, def := range site.defs {
+				if to, ok := s.definitionItem(files, site.module, site.function, def); ok {
+					i = len(calls)
+					calls = append(calls, protocol.CallHierarchyOutgoingCall{To: to})
+					break
+				}
+			}
+			byTarget[name] = i
+		}
+		if i >= 0 {
+			calls[i].FromRanges = append(calls[i].FromRanges, site.from)
+		}
+	}
+	return calls, nil
+}
+
+// outgoingSite is one resolved call: the function it reaches, that
+// function's definition rows, and where the call is made.
+type outgoingSite struct {
+	module, function string
+	arity            int
+	defs             []store.LookupResult
+	from             protocol.Range
+}
+
+// outgoingSites returns the resolved calls in the clauses of id in one file,
+// in source order, and whether the file has any such clause.
+func (s *Server) outgoingSites(file string, id callIdentity) ([]outgoingSite, bool) {
+	text, _, ok := s.readFileText(file)
+	if !ok {
+		return nil, false
+	}
+	source, ok := treesitter.ParseSource([]byte(text))
+	if !ok {
+		return nil, false
+	}
+	defer source.Close()
+	clauses := source.Clauses(id.module, id.function, id.arity)
+	if len(clauses) == 0 {
+		return nil, false
+	}
+	lines := strings.Split(text, "\n")
+	moduleOf := s.occurrenceResolver(file, text)
+	var sites []outgoingSite
+	for c := range clauses {
+		occs := source.Calls(clauses[c])
+		for i := range occs {
+			occ := &occs[i]
+			if parser.IsElixirKeyword(occ.Name) {
+				continue
+			}
+			if module, defs := s.callTarget(moduleOf(occ), occ, clauses[c].Module); len(defs) > 0 {
+				sites = append(sites, outgoingSite{module: module, function: occ.Name, arity: defs[0].Arity, defs: defs, from: s.nameRange(lines, occ)})
+			}
+		}
+	}
+	return sites, true
+}
+
+// occurrenceResolver returns the module each call occurrence in one file's
+// text calls, resolved as references resolves it with the aliases in scope.
+func (s *Server) occurrenceResolver(file, text string) func(occ *treesitter.FunctionOccurrence) string {
+	tf := NewTokenizedFile(text)
+	aliasesAt := map[int]map[string]string{}
+	return func(occ *treesitter.FunctionOccurrence) string {
+		line := int(occ.Line)
+		aliases, ok := aliasesAt[line]
+		if !ok {
+			aliases = tf.ExtractAliasesInScope(line)
+			s.mergeAliasesFromUseTokenized(tf, aliases)
+			aliasesAt[line] = aliases
+		}
+		return s.occurrenceModule(file, text, tf, *occ, aliases)
+	}
+}
+
+// callTarget resolves one call occurrence, whose resolved module is module,
+// to the module and definition rows of the function the call reaches: a
+// callable of the call's arity that the module defines, injects through use or
+// generates, looked up as go-to-definition looks it up. A module that exists
+// is not a function, and a delegate keeps its own identity. A remote call,
+// __MODULE__.f() included, and an imported call reach only public functions.
+// A bare name that no scope provides may still be a function the caller's own
+// module generates.
+func (s *Server) callTarget(module string, occ *treesitter.FunctionOccurrence, callerModule string) (string, []store.LookupResult) {
+	if module == "" {
+		if occ.Qualifier != "" {
+			return "", nil
+		}
+		module = callerModule
+	}
+	external := occ.Qualifier != "" || module != callerModule
+	locations, err := s.LookupName(module, occ.Name, NameLookupOptions{Kind: NameKindCallable, External: external, Arity: occ.Arity})
+	if err != nil {
+		return "", nil
+	}
+	var defs []store.LookupResult
+	for _, l := range locations {
+		// Given only a type or only private functions, the lookup keeps them
+		// for navigation; the call reaches neither.
+		if typeKinds[l.Kind] || external && privateKinds[l.Kind] {
+			continue
+		}
+		defs = append(defs, store.LookupResult{FilePath: l.FilePath, Line: l.Line, Kind: l.Kind, Arity: l.Arity})
+	}
+	return module, defs
+}
+
+// nameRange is the protocol range of an occurrence's name token.
+func (s *Server) nameRange(lines []string, occ *treesitter.FunctionOccurrence) protocol.Range {
+	return s.pointRange(lines,
+		tree_sitter.Point{Row: occ.NameLine, Column: occ.NameCol},
+		tree_sitter.Point{Row: occ.NameLine, Column: occ.NameEndCol})
+}
+
+// pointRange converts a syntax-tree span (byte columns) to a protocol range.
+func (s *Server) pointRange(lines []string, start, end tree_sitter.Point) protocol.Range {
+	return protocol.Range{Start: s.outPoint(lines, start), End: s.outPoint(lines, end)}
+}
+
+func (s *Server) outPoint(lines []string, p tree_sitter.Point) protocol.Position {
+	line := ""
+	if int(p.Row) < len(lines) {
+		line = lines[p.Row]
+	}
+	return s.outPosLine(line, int(p.Row), int(p.Column))
+}
diff --git a/internal/lsp/call_hierarchy_generated_arity_test.go b/internal/lsp/call_hierarchy_generated_arity_test.go
new file mode 100644
index 0000000..a13de5e
--- /dev/null
+++ b/internal/lsp/call_hierarchy_generated_arity_test.go
@@ -0,0 +1,109 @@
+package lsp
+
+import (
+	"context"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"go.lsp.dev/protocol"
+	"go.lsp.dev/uri"
+)
+
+// A generated function with default arguments compiles to one export per arity,
+// as Ecto.Repo's query!(sql, params \\ [], opts \\ []) does. Preparing the call
+// hierarchy at a call must name the arity the call reaches, not the first export.
+func TestPrepareCallHierarchyGeneratedFunctionUsesCallArity(t *testing.T) {
+	server, cleanup := setupTestServer(t)
+	t.Cleanup(cleanup)
+
+	indexAndCompile(t, server, "MyApp.Store", "lib/my_app/store.ex",
+		"defmodule MyApp.Store do\n  use SharedLib.Store\nend\n",
+		beamExport{"lookup", 1}, beamExport{"lookup", 2}, beamExport{"lookup", 3})
+	bumpDirMtime(t, filepath.Join(server.projectRoot, "_build", "dev", "lib", "my_app", "ebin"))
+
+	const callerSource = `defmodule MyApp.Caller do
+  alias MyApp.Store
+
+  def one(sql), do: Store.lookup(sql)
+  def two(sql), do: Store.lookup(sql, [])
+  def three(sql), do: Store.lookup(sql, [], [])
+  def piped(sql), do: sql |> Store.lookup([])
+  def captured, do: &Store.lookup/2
+  def unexported(sql), do: Store.lookup(sql, [], [], :extra)
+end
+`
+	indexFile(t, server.store, server.projectRoot, "lib/my_app/caller.ex", callerSource)
+	callerURI := string(uri.File(filepath.Join(server.projectRoot, "lib", "my_app", "caller.ex")))
+	server.docs.seed(callerURI, callerSource)
+
+	prepare := func(t *testing.T, line int) []protocol.CallHierarchyItem {
+		t.Helper()
+		text := strings.Split(callerSource, "\n")[line]
+		character := strings.Index(text, "lookup")
+		if character < 0 {
+			t.Fatalf("no lookup call on line %d: %q", line, text)
+		}
+		items, err := server.PrepareCallHierarchy(context.Background(), &protocol.CallHierarchyPrepareParams{
+			TextDocumentPositionParams: protocol.TextDocumentPositionParams{
+				TextDocument: protocol.TextDocumentIdentifier{URI: protocol.DocumentURI(callerURI)},
+				Position:     protocol.Position{Line: uint32(line), Character: uint32(character)},
+			},
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return items
+	}
+
+	for _, tc := range []struct {
+		name string
+		line int
+		want string
+	}{
+		{"optional argument supplied", 4, "MyApp.Store.lookup/2"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			items := prepare(t, tc.line)
+			if len(items) != 1 || items[0].Name != tc.want {
+				t.Fatalf("items = %#v, want one item named %s", items, tc.want)
+			}
+			if id, _ := callHierarchyIdentity(items[0].Data); id.module != "MyApp.Store" || id.function != "lookup" {
+				t.Fatalf("data = %s.%s, want MyApp.Store.lookup", id.module, id.function)
+			}
+			// The anchor stays on the consumer module: a generated function has no source line.
+			if !strings.HasSuffix(string(items[0].URI), "/lib/my_app/store.ex") || items[0].Range.Start.Line != 0 {
+				t.Fatalf("anchor = %s line %d, want the MyApp.Store module line", items[0].URI, items[0].Range.Start.Line)
+			}
+		})
+	}
+
+	// No export takes four arguments. Another arity's item would be a convincing
+	// wrong answer, so there is no item at all.
+	t.Run("unexported arity", func(t *testing.T) {
+		if items := prepare(t, 8); len(items) != 0 {
+			t.Fatalf("items = %#v, want none: MyApp.Store exports no lookup/4", items)
+		}
+	})
+}
+
+// After a nested module closes, a bare call in the outer module reaches the
+// outer module's generated functions.
+func TestPrepareCallHierarchyGeneratedAfterNestedModule(t *testing.T) {
+	server, cleanup := setupTestServer(t)
+	t.Cleanup(cleanup)
+
+	indexAndCompile(t, server, "MyApp.Store", "lib/my_app/store.ex", `defmodule MyApp.Store do
+  use SharedLib.Store
+
+  defmodule Inner do
+    def noop, do: :ok
+  end
+
+  def find(sql), do: lookup(sql)
+end
+`, beamExport{"lookup", 1})
+	bumpDirMtime(t, filepath.Join(server.projectRoot, "_build", "dev", "lib", "my_app", "ebin"))
+
+	prepareOne(t, server, "lib/my_app/store.ex:7:21", "MyApp.Store.lookup/1")
+}
diff --git a/internal/lsp/call_hierarchy_ranges_test.go b/internal/lsp/call_hierarchy_ranges_test.go
new file mode 100644
index 0000000..191076c
--- /dev/null
+++ b/internal/lsp/call_hierarchy_ranges_test.go
@@ -0,0 +1,241 @@
+package lsp
+
+import (
+	"io/fs"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"testing"
+	"unicode/utf16"
+
+	"go.lsp.dev/protocol"
+	"go.lsp.dev/uri"
+)
+
+// rangesSources are the files TestCallHierarchyItemRanges adds to the
+// outgoing fixture, by path relative to the project root.
+var rangesSources = map[string]string{
+	"lib/shop/sizes.ex": `defmodule Shop.Sizes do
+  def größe(value), do: value
+  def measure(value), do: größe(value)
+end
+`,
+	// A def a quote injects through use, as Ecto.Repo injects insert/2.
+	"lib/shop/store_macro.ex": `defmodule Shop.StoreMacro do
+  defmacro __using__(opts) do
+    quote do
+      if unquote(opts)[:writable] do
+        def put(value), do: value
+      end
+    end
+  end
+end
+`,
+	"lib/shop/store.ex": `defmodule Shop.Store do
+  use Shop.StoreMacro, writable: true
+
+  def save(value), do: Shop.Store.put(value)
+end
+`,
+}
+
+// Every call-hierarchy item's range contains its selection range, and both
+// cover real source: the range is the declaration, the selection its name. A
+// generated function has no declaration of its own; its item keeps the
+// function's identity, is anchored at the module that generates it and
+// selects that module's name.
+func TestCallHierarchyItemRanges(t *testing.T) {
+	server := callHierarchyProject(t, "outgoing")
+	server.SetStdlibRoot(filepath.Join(server.projectRoot, "stdlib"))
+	indexAndCompile(t, server, "Shop.Repo", "lib/shop/repo.ex", "defmodule Shop.Repo do\n  use Shop.RepoMacro\nend\n",
+		beamExport{"delete!", 1}, beamExport{"insert!", 1}, beamExport{"one", 1})
+	bumpDirMtime(t, filepath.Join(server.projectRoot, "_build", "dev", "lib", "my_app", "ebin"))
+	sources := fixtureSources(t, "outgoing")
+	for rel, src := range rangesSources {
+		indexFile(t, server.store, server.projectRoot, rel, src)
+		sources[rel] = src
+	}
+
+	anchored := map[string]bool{}
+	for _, item := range hierarchyItems(
+		t, server,
+		"lib/shop/accounts.ex:3:6",  // deliver/1, multiline
+		"lib/shop/accounts.ex:9:6",  // update/2
+		"lib/shop/accounts.ex:19:6", // admit/3, bodiless default head
+		"lib/shop/accounts.ex:35:6", // handle/2, second clause
+		"lib/shop/accounts.ex:46:7", // save_and_clear/1, generated targets
+		"lib/shop/accounts.ex:5:10", // Repo.insert!, a generated function
+		"test/shop/accounts_test.exs:9:7",
+		"lib/shop/sizes.ex:2:28", // größe, a multibyte name
+		"lib/shop/store.ex:3:6",  // save/1, whose target put/1 is a quoted def
+	) {
+		if assertItemGeometry(t, server, sources, item) {
+			anchored[item.Name] = true
+		}
+		if item.Data != nil {
+			assertItemData(t, item)
+		}
+	}
+	// Shop.Repo generates these (its BEAM exports them); nothing else is.
+	want := []string{"Shop.Repo.delete!/1", "Shop.Repo.insert!/1", "Shop.Repo.one/1"}
+	if got := sortedKeys(anchored); strings.Join(got, " ") != strings.Join(want, " ") {
+		t.Errorf("anchored at their module: %v, want %v", got, want)
+	}
+
+	put := outgoing(t, server, prepareOne(t, server, "lib/shop/store.ex:3:6", "Shop.Store.save/1"))
+	if len(put) != 1 || put[0].To.Name != "Shop.Store.put/1" || spanText(put[0].To.SelectionRange) != "4:12-4:15" {
+		t.Errorf("save/1 outgoing = %v, want Shop.Store.put/1 selecting put in the quote at 4:12-4:15", outgoingRows(put))
+	}
+	storeURI := string(uri.File(filepath.Join(server.projectRoot, "lib", "shop", "store.ex")))
+	macroURI := uri.File(filepath.Join(server.projectRoot, "lib", "shop", "store_macro.ex"))
+	if locs := definitionAt(t, server, storeURI, 3, 35); len(locs) != 1 || locs[0].URI != macroURI || locs[0].Range.Start.Line != 4 {
+		t.Errorf("definition of Shop.Store.put = %v, want the quoted def at store_macro.ex line 4", locs)
+	}
+
+	deliver := prepareOne(t, server, "lib/shop/accounts.ex:3:6", "Shop.Accounts.deliver/1")
+	if got := spanText(deliver.Range); got != "3:2-7:5" {
+		t.Fatalf("deliver/1 range = %s, want its declaration 3:2-7:5", got)
+	}
+}
+
+// fixtureSources returns a call hierarchy fixture's files by path relative to
+// the project root, as callHierarchyProject copies them.
+func fixtureSources(t *testing.T, fixture string) map[string]string {
+	t.Helper()
+	sources := map[string]string{}
+	fixtures := os.DirFS(filepath.Join("testdata", "call_hierarchy", fixture))
+	err := fs.WalkDir(fixtures, ".", func(path string, d fs.DirEntry, err error) error {
+		if err != nil || d.IsDir() {
+			return err
+		}
+		content, err := fs.ReadFile(fixtures, path)
+		sources[path] = string(content)
+		return err
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return sources
+}
+
+// hierarchyItems prepares at each position and returns every item: each
+// prepared item, its outgoing targets and its incoming callers.
+func hierarchyItems(t *testing.T, server *Server, positions ...string) []protocol.CallHierarchyItem {
+	t.Helper()
+	var items []protocol.CallHierarchyItem
+	for _, at := range positions {
+		prepared := prepareAt(t, server, at)
+		if len(prepared) == 0 {
+			t.Fatalf("prepare at %s = none", at)
+		}
+		for i := range prepared {
+			item := prepared[i]
+			items = append(items, item)
+			calls := outgoing(t, server, item)
+			for j := range calls {
+				items = append(items, calls[j].To)
+			}
+			callers := incoming(t, server, item)
+			for j := range callers {
+				items = append(items, callers[j].From)
+			}
+		}
+	}
+	return items
+}
+
+// assertItemGeometry checks one item and reports whether it is a generated
+// function anchored at its module.
+func assertItemGeometry(t *testing.T, server *Server, sources map[string]string, item protocol.CallHierarchyItem) (anchor bool) {
+	t.Helper()
+	r, sel := item.Range, item.SelectionRange
+	if !positionBefore(sel.Start, sel.End) {
+		t.Errorf("%s: selection %s is empty", item.Name, spanText(sel))
+	}
+	if positionBefore(sel.Start, r.Start) || positionBefore(r.End, sel.End) {
+		t.Errorf("%s: range %s does not contain selection %s", item.Name, spanText(r), spanText(sel))
+	}
+	rel, err := filepath.Rel(server.projectRoot, uriToPath(item.URI))
+	src, known := sources[filepath.ToSlash(rel)]
+	if err != nil || !known {
+		t.Errorf("%s: item in %s, a file the test did not write", item.Name, item.URI)
+		return false
+	}
+	lines := strings.Split(src, "\n")
+	selected, declared := rangeSource(lines, sel), rangeSource(lines, r)
+	if item.Data == nil {
+		// A test or setup block spans from its keyword and selects its label
+		// or keyword.
+		if !strings.HasPrefix(declared, item.Detail) || !strings.HasPrefix(selected, `"`) && selected != item.Detail {
+			t.Errorf("%s: range %s starts %q, selection %q, want the %s block and its label", item.Name, spanText(r), firstLine(declared), selected, item.Detail)
+		}
+		return false
+	}
+	if !strings.HasPrefix(declared, "def") {
+		t.Errorf("%s: range %s starts %q, want a declaration", item.Name, spanText(r), firstLine(declared))
+	}
+	id, _ := callHierarchyIdentity(item.Data)
+	if selected == id.function && !strings.HasPrefix(declared, "defmodule") {
+		return false
+	}
+	// A generated function: its module's declaration, selecting the module
+	// name as written there.
+	if strings.HasPrefix(declared, "defmodule "+selected+" ") && strings.HasSuffix("."+id.module, "."+selected) {
+		return true
+	}
+	t.Errorf("%s: range %s starts %q, selection %s is %q, want the function's declaration and name, or for a generated function its module's",
+		item.Name, spanText(r), firstLine(declared), spanText(sel), selected)
+	return false
+}
+
+func positionBefore(a, b protocol.Position) bool {
+	return a.Line < b.Line || a.Line == b.Line && a.Character < b.Character
+}
+
+// rangeSource is the source text a protocol range (UTF-16 columns) covers.
+func rangeSource(lines []string, r protocol.Range) string {
+	var b strings.Builder
+	for line := r.Start.Line; line <= r.End.Line && int(line) < len(lines); line++ {
+		text := lines[line]
+		start, end := 0, len(text)
+		if line == r.Start.Line {
+			start = utf16ToByte(text, r.Start.Character)
+		}
+		if line == r.End.Line {
+			end = utf16ToByte(text, r.End.Character)
+		}
+		if line > r.Start.Line {
+			b.WriteByte('\n')
+		}
+		if start < end {
+			b.WriteString(text[start:end])
+		}
+	}
+	return b.String()
+}
+
+func utf16ToByte(text string, character uint32) int {
+	units := uint32(0)
+	for i, r := range text {
+		if units >= character {
+			return i
+		}
+		units += uint32(len(utf16.Encode([]rune{r})))
+	}
+	return len(text)
+}
+
+func firstLine(text string) string {
+	line, _, _ := strings.Cut(text, "\n")
+	return line
+}
+
+func sortedKeys(set map[string]bool) []string {
+	keys := make([]string, 0, len(set))
+	for key := range set {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	return keys
+}
diff --git a/internal/lsp/call_hierarchy_target_test.go b/internal/lsp/call_hierarchy_target_test.go
new file mode 100644
index 0000000..b8dcb4b
--- /dev/null
+++ b/internal/lsp/call_hierarchy_target_test.go
@@ -0,0 +1,200 @@
+package lsp
+
+import (
+	"path/filepath"
+	"testing"
+)
+
+// A call's target is the function the call reaches in Elixir: the module
+// must define or inject that name and arity, a remote call (even through
+// __MODULE__) reaches only public functions, and a delegate keeps its own
+// identity. A name the module does not define has no target, even when the
+// module exists.
+func TestCallHierarchyOutgoingTargetIdentity(t *testing.T) {
+	server, cleanup := setupTestServer(t)
+	t.Cleanup(cleanup)
+	for rel, source := range map[string]string{
+		"lib/provider.ex": `defmodule Provider do
+  defmacro __using__(_) do
+    quote do
+      def get!(schema, id), do: {schema, id}
+      defp injected_secret(x), do: x
+    end
+  end
+end
+`,
+		"lib/repo.ex":   "defmodule Repo do\n  use Provider\nend\n",
+		"lib/facade.ex": "defmodule Facade do\n  defdelegate fetch(x), to: Impl\nend\n",
+		"lib/impl.ex":   "defmodule Impl do\n  def fetch(x), do: x\nend\n",
+		"lib/secret.ex": "defmodule Secret do\n  defp hidden(x), do: x\nend\n",
+		"lib/shapes.ex": `defmodule Shapes do
+  @type only_type(a) :: {a}
+  @type both(a) :: {a}
+  def both(a), do: {a}
+end
+`,
+		"lib/caller.ex": `defmodule Caller do
+  def run(x) do
+    Repo.get!(:user, x)
+    Repo.get!(:user)
+    Repo.missing(x, x)
+    Repo.injected_secret(x)
+    Facade.fetch(x)
+    Secret.hidden(x)
+    Shapes.only_type(x)
+    Shapes.both(x)
+    local(x)
+    __MODULE__.local(x)
+  end
+
+  defp local(x), do: x
+end
+`,
+	} {
+		indexFile(t, server.store, server.projectRoot, rel, source)
+	}
+
+	calls := outgoing(t, server, prepareOne(t, server, "lib/caller.ex:1:6", "Caller.run/1"))
+	assertRows(t, outgoingRows(calls), []string{
+		"Repo.get!/2 <- 2:9-2:13",
+		"Facade.fetch/1 <- 6:11-6:16",
+		"Shapes.both/1 <- 9:11-9:15",
+		"Caller.local/1 <- 10:4-10:9",
+	})
+
+	want := map[string]struct {
+		file   string
+		line   uint32
+		detail string
+	}{
+		// An injected def is named by the module that uses the provider and
+		// found at its line in the quote.
+		"Repo.get!/2": {"lib/provider.ex", 3, "def"},
+		// Following the delegate would name Impl.fetch/1, another function.
+		"Facade.fetch/1": {"lib/facade.ex", 1, "defdelegate"},
+		"Shapes.both/1":  {"lib/shapes.ex", 3, "def"},
+		"Caller.local/1": {"lib/caller.ex", 14, "defp"},
+	}
+	for _, call := range calls {
+		assertItemData(t, call.To)
+		w := want[call.To.Name]
+		if uriToPath(call.To.URI) != filepath.Join(server.projectRoot, w.file) || call.To.Range.Start.Line != w.line || call.To.Detail != w.detail {
+			t.Errorf("%s at %s line %d detail %q, want %s line %d detail %q",
+				call.To.Name, call.To.URI, call.To.Range.Start.Line, call.To.Detail, w.file, w.line, w.detail)
+		}
+	}
+}
+
+// __MODULE__ and a nested module's implicit alias name a module the same way
+// in the call hierarchy as they do everywhere else.
+func TestPrepareCallHierarchyModuleExpressions(t *testing.T) {
+	server, cleanup := setupTestServer(t)
+	t.Cleanup(cleanup)
+	indexFile(t, server.store, server.projectRoot, "lib/self.ex", `defmodule Self do
+  def ping(x), do: x
+  def run(x), do: __MODULE__.ping(x)
+  def sub(x), do: __MODULE__.Sub.pong(x)
+
+  defmodule Sub do
+    def pong(x), do: x
+  end
+
+  def nested(x), do: Sub.pong(x)
+end
+`)
+
+	prepareOne(t, server, "lib/self.ex:2:29", "Self.ping/1")
+	prepareOne(t, server, "lib/self.ex:3:33", "Self.Sub.pong/1")
+	prepareOne(t, server, "lib/self.ex:9:25", "Self.Sub.pong/1")
+}
+
+// An import in a __using__ quote is lexical to the module that uses it: a bare
+// call there reaches the imported function, but the module defines nothing
+// by it, so a qualified call through the module has no target. Functions the
+// quote defines, directly or through a transitive use, are the module's own.
+func TestCallHierarchyUseChainImportsAreLexical(t *testing.T) {
+	server, cleanup := setupTestServer(t)
+	t.Cleanup(cleanup)
+	for rel, source := range map[string]string{
+		"lib/helpers.ex":     "defmodule Helpers do\n  def helper(x), do: x\nend\n",
+		"lib/opt_helpers.ex": "defmodule OptHelpers do\n  def opt_helper(x), do: x\nend\n",
+		"lib/provider.ex": `defmodule Provider do
+  defmacro __using__(_) do
+    quote do
+      import Helpers
+
+      def get!(schema, id), do: {schema, id}
+    end
+  end
+end
+`,
+		"lib/opt_provider.ex": `defmodule OptProvider do
+  defmacro __using__(opts \\ []) do
+    mod = Keyword.get(opts, :mod, OptHelpers)
+
+    quote do
+      import unquote(mod)
+    end
+  end
+end
+`,
+		"lib/outer.ex": `defmodule Outer do
+  defmacro __using__(_) do
+    quote do
+      use Provider
+    end
+  end
+end
+`,
+		"lib/repo.ex":      "defmodule Repo do\n  use Provider\n  use OptProvider\nend\n",
+		"lib/deep_repo.ex": "defmodule DeepRepo do\n  use Outer\nend\n",
+		"lib/caller.ex": `defmodule Caller do
+  def run(x) do
+    Repo.helper(x)
+    Repo.opt_helper(x)
+    DeepRepo.helper(x)
+    DeepRepo.get!(:user, x)
+  end
+end
+`,
+		"lib/consumer.ex": `defmodule Consumer do
+  use Provider
+  use OptProvider
+
+  def run(x) do
+    helper(x)
+    opt_helper(x)
+  end
+end
+`,
+	} {
+		indexFile(t, server.store, server.projectRoot, rel, source)
+	}
+
+	assertRows(t, outgoingRows(outgoing(t, server, prepareOne(t, server, "lib/caller.ex:1:6", "Caller.run/1"))), []string{
+		"DeepRepo.get!/2 <- 5:13-5:17",
+	})
+	assertRows(t, outgoingRows(outgoing(t, server, prepareOne(t, server, "lib/consumer.ex:4:6", "Consumer.run/1"))), []string{
+		"Helpers.helper/1 <- 5:4-5:10",
+		"OptHelpers.opt_helper/1 <- 6:4-6:14",
+	})
+
+	// The lookup itself, which go-to-definition shares, draws the same line.
+	for _, tc := range []struct {
+		module, function string
+		found            bool
+	}{
+		{"Repo", "helper", false},
+		{"Repo", "opt_helper", false},
+		{"DeepRepo", "helper", false},
+		{"DeepRepo", "get!", true},
+	} {
+		locations, err := server.LookupName(tc.module, tc.function, NameLookupOptions{Kind: NameKindCallable})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if found := len(locations) > 0; found != tc.found {
+			t.Errorf("LookupName(%s, %s) = %+v, want found=%v", tc.module, tc.function, locations, tc.found)
+		}
+	}
+}
