index 0000000..b262b39
--- /dev/null
+++ b/internal/daemon/query.go
@@ -0,0 +1,63 @@
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"time"
+
+	"github.com/remoteoss/dexter/internal/lsp"
+)
+
+// QueryParams carries native LSP parameters to the daemon's existing headless
+// handlers. Only the nine read-only methods below are admitted.
+type QueryParams struct {
+	Method      string          `json:"method"`
+	Params      json.RawMessage `json:"params"`
+	WaitReadyMs int             `json:"waitReadyMs"`
+}
+
+func (s *server) query(mc MethodContext, params QueryParams) (any, error) {
+	if err := lsp.ValidateReadOnlyDocument(s.root, s.runtime.StdlibRoot(), params.Method, params.Params); err != nil {
+		return nil, err
+	}
+	if params.WaitReadyMs <= 0 {
+		return nil, fmt.Errorf("query waitReadyMs must be positive")
+	}
+	waitCtx, cancel := context.WithTimeout(mc.Context, time.Duration(params.WaitReadyMs)*time.Millisecond)
+	defer cancel()
+	if err := s.runtime.WaitReady(waitCtx); err != nil {
+		return nil, fmt.Errorf("workspace query index is not ready: %w", err)
+	}
+	srv := mc.LSP()
+	switch params.Method {
+	case "textDocument/definition":
+		return callQuery(mc.Context, params.Params, srv.Definition)
+	case "textDocument/references":
+		return callQuery(mc.Context, params.Params, srv.References)
+	case "textDocument/hover":
+		return callQuery(mc.Context, params.Params, srv.Hover)
+	case "textDocument/documentSymbol":
+		return callQuery(mc.Context, params.Params, srv.DocumentSymbol)
+	case "workspace/symbol":
+		return callQuery(mc.Context, params.Params, srv.Symbols)
+	case "textDocument/implementation":
+		return callQuery(mc.Context, params.Params, srv.Implementation)
+	case "textDocument/prepareCallHierarchy":
+		return callQuery(mc.Context, params.Params, srv.PrepareCallHierarchy)
+	case "callHierarchy/incomingCalls":
+		return callQuery(mc.Context, params.Params, srv.IncomingCalls)
+	case "callHierarchy/outgoingCalls":
+		return callQuery(mc.Context, params.Params, srv.OutgoingCalls)
+	default:
+		return nil, fmt.Errorf("unsupported read-only query method %q", params.Method)
+	}
+}
+
+func callQuery[P, R any](ctx context.Context, raw json.RawMessage, handler func(context.Context, *P) (R, error)) (any, error) {
+	var params P
+	if err := json.Unmarshal(raw, &params); err != nil {
+		return nil, err
+	}
+	return handler(ctx, &params)
+}
