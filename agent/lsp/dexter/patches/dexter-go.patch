new file mode 100644
index 0000000..ccc18dd
--- /dev/null
+++ b/internal/daemon/build_identity_test.go
@@ -0,0 +1,69 @@
+package daemon
+
+import (
+	"bufio"
+	"context"
+	"net"
+	"strings"
+	"testing"
+
+	"github.com/remoteoss/dexter/internal/version"
+)
+
+// A daemon serves only frontends from its own local build. Stock Dexter sends
+// no build id, so the refusal must come before contract handling: a stock
+// frontend with a newer contract would otherwise make this daemon step aside
+// and drop every editor attached to it.
+func TestPipeHandshakeRefusesOtherBuildsBeforeContract(t *testing.T) {
+	quietEnv(t)
+	root := t.TempDir()
+	s, endpoint := pipeServer(t, root)
+
+	cases := []struct {
+		name  string
+		hello hello
+	}{
+		{"stock frontend", hello{Contract: ContractVersion, Kind: kindControl, Root: endpoint.Root, Identity: endpoint.Identity}},
+		{"stock frontend with newer contract", hello{Contract: ContractVersion + 1, Kind: kindLSP, Root: endpoint.Root, Identity: endpoint.Identity}},
+		{"other local build", hello{LocalBuildID: version.LocalBuildID + "-other", Contract: ContractVersion, Kind: kindControl, Root: endpoint.Root, Identity: endpoint.Identity}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			serverConn, clientConn := net.Pipe()
+			served := make(chan error, 1)
+			go func() { served <- s.serveConn(serverConn) }()
+			defer func() {
+				_ = clientConn.Close()
+				<-served
+			}()
+			reader := bufio.NewReader(clientConn)
+			if err := writeJSONLine(clientConn, tc.hello); err != nil {
+				t.Fatal(err)
+			}
+			var res helloResponse
+			if err := readJSONLine(reader, &res); err != nil {
+				t.Fatal(err)
+			}
+			if res.OK || !res.Incompatible || res.Exiting {
+				t.Fatalf("handshake = %+v, want an incompatible refusal that does not exit", res)
+			}
+			if res.LocalBuildID != version.LocalBuildID || !strings.Contains(res.Error, "local build") {
+				t.Fatalf("refusal does not name this build: %+v", res)
+			}
+		})
+	}
+	select {
+	case <-s.stopping:
+		t.Fatal("a frontend from another build made the daemon step aside")
+	default:
+	}
+
+	// Frontends from the same build still share the workspace.
+	first, second := pipeClient(t, s, endpoint), pipeClient(t, s, endpoint)
+	for _, client := range []*Client{first, second} {
+		var status Status
+		if err := client.Call(context.Background(), MethodStatus, struct{}{}, &status); err != nil {
+			t.Fatalf("same-build client: %v", err)
+		}
+	}
+}
diff --git a/internal/daemon/build_identity_unix_test.go b/internal/daemon/build_identity_unix_test.go
new file mode 100644
index 0000000..16876a3
--- /dev/null
+++ b/internal/daemon/build_identity_unix_test.go
@@ -0,0 +1,68 @@
+//go:build darwin || linux
+
+package daemon
+
+import (
+	"context"
+	"errors"
+	"os/exec"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/remoteoss/dexter/internal/version"
+)
+
+// A frontend must refuse a daemon from another build whatever that daemon
+// answers, and must never replace it: team daemons from other builds keep
+// serving the editors attached to them. The pid in each answer is a live
+// process that the replacement path would signal.
+func TestEnsureRefusesAnotherBuildWithoutReplacingIt(t *testing.T) {
+	cases := map[string]helloResponse{
+		// Stock Dexter ignores the unknown hello field and accepts.
+		"stock daemon accepts": {OK: true, Contract: ContractVersion},
+		// A stock daemon predating the restart contract refuses without exiting;
+		// the contract-drift path would signal its pid.
+		"stock older daemon refuses": {Error: "older", Contract: ContractVersion - 1, Incompatible: true},
+		"other local build accepts":  {OK: true, Contract: ContractVersion, LocalBuildID: version.LocalBuildID + "-other"},
+	}
+	for name, res := range cases {
+		t.Run(name, func(t *testing.T) {
+			peer := exec.CommandContext(context.Background(), "sleep", "60")
+			if err := peer.Start(); err != nil {
+				t.Fatalf("cannot start the stand-in daemon process: %v", err)
+			}
+			exited := make(chan struct{})
+			go func() { _, _ = peer.Process.Wait(); close(exited) }()
+			defer func() { _ = peer.Process.Kill() }()
+
+			root := t.TempDir()
+			res.PID = peer.Process.Pid
+			fakeDaemon(t, root, res)
+
+			origSpawn := spawnDaemon
+			spawnDaemon = func(string) error {
+				t.Error("Ensure started a daemon over another build")
+				return errors.New("spawned")
+			}
+			t.Cleanup(func() { spawnDaemon = origSpawn })
+
+			client, err := Ensure(context.Background(), root)
+			if client != nil {
+				_ = client.Close()
+			}
+			var incompatible *IncompatibleDaemonError
+			if !errors.As(err, &incompatible) || !incompatible.BuildMismatch || incompatible.ClientNewer {
+				t.Fatalf("Ensure error = %#v, want a build mismatch that is not replaceable", err)
+			}
+			if !strings.Contains(err.Error(), "local build") || strings.Contains(err.Error(), "upgrade") {
+				t.Fatalf("error does not explain the build mismatch: %v", err)
+			}
+			select {
+			case <-exited:
+				t.Fatal("the other build's daemon was signaled")
+			case <-time.After(100 * time.Millisecond):
+			}
+		})
+	}
+}
