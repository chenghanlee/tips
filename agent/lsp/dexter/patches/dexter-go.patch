+func TestArity_LocalSameNameDifferentArity(t *testing.T) {
+	server, cleanup := setupTestServer(t)
+	defer cleanup()
+	root := server.projectRoot
+
+	const file = "lib/my_app/accounts.ex"
+	src := arityAccountsSrc
+	indexFile(t, server.store, root, file, src)
+	server.docs.Set("file://"+filepath.Join(root, file), src)
+
+	site := func(text string) aritySite { return aritySite{file, text} }
+	head2a := site("def create(name, attrs) when is_map(attrs) do")
+	head2b := site("def create(name, attrs) do")
+	head3 := site("defp create(name, attrs, opts) do")
+	call3a := site("create(name, attrs, [])")
+	call3b := site("create(name, %{}, [:audit])")
+	call2 := site("create(name, %{})")
+	headOnly := site("def only(value), do: {:only, value}")
+	callOnly := site("only(value)")
+
+	runArityDefinitions(t, server, "", []arityDefinitionCase{
+		{"definition of a /3 call is the /3 head", arityAt{call3b, "create", 1}, []aritySite{head3}},
+	})
+	t.Run("definition of a /2 call is a /2 head", func(t *testing.T) {
+		expectArityDefinitionWithin(t, server, arityAt{call2, "create", 1}, head2a, head2b)
+	})
+	runArityHovers(t, server, "", []arityHoverCase{
+		{"hover of a /3 call describes the /3 head", arityAt{call3b, "create", 1}, "defp create(name, attrs, opts)", "Creates with two arguments."},
+	})
+	runArityReferences(t, server, "", []arityReferenceCase{
+		{"references of a /3 call with declarations", arityAt{call3b, "create", 1}, true, []aritySite{call3a, call3b, head3}},
+		{"references of a /3 call without declarations", arityAt{call3b, "create", 1}, false, []aritySite{call3a, call3b}},
+		{"references of the /3 head with declarations", arityAt{head3, "create", 1}, true, []aritySite{call3a, call3b, head3}},
+		{"references of the /3 head without declarations", arityAt{head3, "create", 1}, false, []aritySite{call3a, call3b}},
+		{"references of a /2 call with declarations", arityAt{call2, "create", 1}, true, []aritySite{call2, head2a, head2b}},
+		{"references of a /2 call without declarations", arityAt{call2, "create", 1}, false, []aritySite{call2}},
+		{"control: single arity with declarations", arityAt{callOnly, "only", 1}, true, []aritySite{callOnly, headOnly}},
+		{"control: single arity without declarations", arityAt{callOnly, "only", 1}, false, []aritySite{callOnly}},
+	})
+	t.Run("control: single arity definition and hover", func(t *testing.T) {
+		expectArityDefinition(t, server, arityAt{callOnly, "only", 1}, headOnly)
+		expectArityHover(t, server, arityAt{callOnly, "only", 1}, "Single-arity control.", "")
+	})
+}
