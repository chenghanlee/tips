+				t.Fatal("outgoing calls = null, want a list")
+			}
+			assertRows(t, outgoingRows(calls), tc.want)
+			for _, call := range calls {
+				assertItemData(t, call.To)
+			}
+		})
+	}
+
+	t.Run("every head of a function gives the same rows", func(t *testing.T) {
+		for _, pair := range [][2]string{
+			{"lib/shop/accounts.ex:19:6", "lib/shop/accounts.ex:21:6"},
+			{"lib/shop/accounts.ex:35:6", "lib/shop/accounts.ex:31:6"},
+		} {
+			first := outgoingRows(outgoing(t, server, prepareAt(t, server, pair[0])[0]))
+			second := outgoingRows(outgoing(t, server, prepareAt(t, server, pair[1])[0]))
+			assertRows(t, second, first)
+		}
+	})
+
+	t.Run("a generated target is anchored at its module", func(t *testing.T) {
+		for _, call := range outgoing(t, server, prepareOne(t, server, "lib/shop/accounts.ex:46:7", "Shop.Accounts.save_and_clear/1")) {
+			if uriToPath(call.To.URI) != filepath.Join(server.projectRoot, "lib", "shop", "repo.ex") || call.To.Range.Start.Line != 0 {
+				t.Fatalf("%s anchored at %s line %d, want the Shop.Repo module line", call.To.Name, call.To.URI, call.To.Range.Start.Line)
+			}
+		}
+	})
+}
+
+// A bare call belongs to the module that lexically contains it. After a
+// nested module closes, the outer module resumes: its run(x) calls Outer.run/1
+// even though Inner, whose defmodule line is nearer, defines run/1 too.
+func TestCallHierarchyNestedModuleResumes(t *testing.T) {
+	server, cleanup := setupTestServer(t)
+	t.Cleanup(cleanup)
+	indexFile(t, server.store, server.projectRoot, "lib/outer.ex", `defmodule MyApp.Outer do
+  def run(x), do: x
+
+  defmodule Inner do
+    def run(x), do: x
+    def inner_call(x), do: run(x)
+  end
+
+  def call(x), do: run(x)
+end
+`)
+
+	outer := prepareOne(t, server, "lib/outer.ex:1:6", "MyApp.Outer.run/1")
+	inner := prepareOne(t, server, "lib/outer.ex:4:8", "MyApp.Outer.Inner.run/1")
+	prepareOne(t, server, "lib/outer.ex:8:20", "MyApp.Outer.run/1")
+	prepareOne(t, server, "lib/outer.ex:5:29", "MyApp.Outer.Inner.run/1")
+
+	assertRows(t, incomingRows(t, server, incoming(t, server, outer)), []string{
+		`lib/outer.ex | def MyApp.Outer.call/1 [8:2-8:25] sel [8:6-8:10] <- 8:19-8:22`,
+	})
+	assertRows(t, incomingRows(t, server, incoming(t, server, inner)), []string{
+		`lib/outer.ex | def MyApp.Outer.Inner.inner_call/1 [5:4-5:33] sel [5:8-5:18] <- 5:27-5:30`,
+	})
+	call := prepareOne(t, server, "lib/outer.ex:8:6", "MyApp.Outer.call/1")
+	assertRows(t, outgoingRows(outgoing(t, server, call)), []string{`MyApp.Outer.run/1 <- 8:19-8:22`})
+
+	// A closed nested module's function does not shadow the outer module's
+	// import of the same name and arity.
+	indexFile(t, server.store, server.projectRoot, "lib/provider.ex", "defmodule MyApp.Provider do\n  def f(a, b), do: {a, b}\nend\n")
+	indexFile(t, server.store, server.projectRoot, "lib/importer.ex", `defmodule MyApp.Importer do
+  import MyApp.Provider
+
+  defmodule Inner do
+    def f(a, b), do: {:inner, a, b}
+  end
+
+  def run(x), do: f(x, x)
+end
+`)
+	provided := prepareOne(t, server, "lib/importer.ex:7:18", "MyApp.Provider.f/2")
+	assertRows(t, incomingRows(t, server, incoming(t, server, provided)), []string{
+		`lib/importer.ex | def MyApp.Importer.run/1 [7:2-7:25] sel [7:6-7:9] <- 7:18-7:19`,
+	})
+	innerF := prepareOne(t, server, "lib/importer.ex:4:8", "MyApp.Importer.Inner.f/2")
+	assertRows(t, incomingRows(t, server, incoming(t, server, innerF)), nil)
+}
