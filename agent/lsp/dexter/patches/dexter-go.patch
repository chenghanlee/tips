diff --git a/cmd/query.go b/cmd/query.go
new file mode 100644
index 0000000..d3b23f0
--- /dev/null
+++ b/cmd/query.go
@@ -0,0 +1,176 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strconv"
+	"time"
+
+	"github.com/remoteoss/dexter/internal/daemon"
+	"github.com/remoteoss/dexter/internal/lsp"
+	"github.com/spf13/cobra"
+	"go.lsp.dev/protocol"
+	"go.lsp.dev/uri"
+)
+
+func newQueryCommand() *cobra.Command {
+	var wait time.Duration
+	var includeDeclaration bool
+	cmd := &cobra.Command{
+		Use:   "query <operation> [file line column | search]",
+		Short: "Run a read-only positional query through the workspace daemon",
+		Long: "Operations: definition, references, hover, symbols, workspace-symbols, implementation, prepare-call-hierarchy, incoming-calls, outgoing-calls.\n" +
+			"File paths are relative to --root. Input line and column are 1-based UTF-16.\n" +
+			"Output is raw LSP JSON with native 0-based UTF-16 ranges. symbols takes only a file; workspace-symbols takes an optional search.",
+		Args: cobra.MinimumNArgs(1),
+		RunE: func(cmd *cobra.Command, args []string) error {
+			return cmdQuery(cmd, args, wait, includeDeclaration)
+		},
+	}
+	cmd.Flags().DurationVar(&wait, "wait", 30*time.Second, "Wait up to this long for initial index readiness (timeout is an error)")
+	cmd.Flags().BoolVar(&includeDeclaration, "include-declaration", false, "Include declarations in references")
+	return cmd
+}
+
+func cmdQuery(cmd *cobra.Command, args []string, wait time.Duration, includeDeclaration bool) error {
+	root, err := os.Getwd()
+	if err != nil {
+		return err
+	}
+	if err := lsp.ValidateWorkspaceRoot(root); err != nil {
+		return err
+	}
+	if !looksLikeProjectRoot(root) {
+		return fmt.Errorf("workspace %s does not look like a project", root)
+	}
+	if wait < time.Millisecond || wait > time.Duration(1<<63-1)-30*time.Second {
+		return fmt.Errorf("--wait must be at least 1ms and fit in milliseconds")
+	}
+	method, params, err := queryArguments(args, includeDeclaration)
+	if err != nil {
+		return err
+	}
+	ctx, cancel := context.WithTimeout(cmd.Context(), wait+30*time.Second)
+	defer cancel()
+	client, err := daemon.Ensure(ctx, root)
+	if err != nil {
+		return err
+	}
+	defer func() { _ = client.Close() }()
+	query := func(method string, params any) (json.RawMessage, error) {
+		raw, err := json.Marshal(params)
+		if err != nil {
+			return nil, err
+		}
+		var result json.RawMessage
+		err = client.Call(ctx, daemon.MethodQuery, daemon.QueryParams{Method: method, Params: raw, WaitReadyMs: int(wait / time.Millisecond)}, &result)
+		return result, err
+	}
+	result, err := query(method, params)
+	if err != nil {
+		return err
+	}
+	if args[0] == "incoming-calls" || args[0] == "outgoing-calls" {
+		result, err = followQueryHierarchy(query, args[0], result)
+		if err != nil {
+			return err
+		}
+	}
+	if len(result) == 0 {
+		result = json.RawMessage("null")
+	}
+	_, err = fmt.Fprintln(cmd.OutOrStdout(), string(result))
+	return err
+}
+
+func queryArguments(args []string, includeDeclaration bool) (string, any, error) {
+	operation := args[0]
+	methods := map[string]string{
+		"definition": "textDocument/definition", "references": "textDocument/references",
+		"hover": "textDocument/hover", "symbols": "textDocument/documentSymbol",
+		"workspace-symbols": "workspace/symbol", "implementation": "textDocument/implementation",
+		"prepare-call-hierarchy": "textDocument/prepareCallHierarchy",
+		"incoming-calls":         "textDocument/prepareCallHierarchy", "outgoing-calls": "textDocument/prepareCallHierarchy",
+	}
+	method, ok := methods[operation]
+	if !ok {
+		return "", nil, fmt.Errorf("unsupported read-only query operation %q", operation)
+	}
+	if includeDeclaration && operation != "references" {
+		return "", nil, fmt.Errorf("--include-declaration is only valid for references")
+	}
+	if operation == "workspace-symbols" {
+		if len(args) > 2 {
+			return "", nil, fmt.Errorf("workspace-symbols takes an optional search")
+		}
+		search := ""
+		if len(args) == 2 {
+			search = args[1]
+		}
+		return method, protocol.WorkspaceSymbolParams{Query: search}, nil
+	}
+	count, usage := 4, "file line column"
+	if operation == "symbols" {
+		count, usage = 2, "file"
+	}
+	if len(args) != count {
+		return "", nil, fmt.Errorf("%s requires %s", operation, usage)
+	}
+	path, err := filepath.Abs(args[1])
+	if err != nil {
+		return "", nil, err
+	}
+	document := protocol.TextDocumentIdentifier{URI: uri.File(path)}
+	if operation == "symbols" {
+		return method, protocol.DocumentSymbolParams{TextDocument: document}, nil
+	}
+	line, lineErr := strconv.ParseUint(args[2], 10, 32)
+	column, columnErr := strconv.ParseUint(args[3], 10, 32)
+	if lineErr != nil || columnErr != nil || line == 0 || column == 0 {
+		return "", nil, fmt.Errorf("line and column must be positive 1-based UTF-16 positions")
+	}
+	position := protocol.TextDocumentPositionParams{
+		TextDocument: document,
+		Position:     protocol.Position{Line: uint32(line) - 1, Character: uint32(column) - 1},
+	}
+	if operation == "references" {
+		return method, protocol.ReferenceParams{TextDocumentPositionParams: position, Context: protocol.ReferenceContext{IncludeDeclaration: includeDeclaration}}, nil
+	}
+	return method, position, nil
+}
+
+// Sequence prepare and follow-up without interpreting opaque backend identity.
+func followQueryHierarchy(query func(string, any) (json.RawMessage, error), operation string, prepared json.RawMessage) (json.RawMessage, error) {
+	var items []json.RawMessage
+	if err := json.Unmarshal(prepared, &items); err != nil {
+		return nil, err
+	}
+	if len(items) == 0 {
+		return json.RawMessage("null"), nil
+	}
+	method := "callHierarchy/incomingCalls"
+	if operation == "outgoing-calls" {
+		method = "callHierarchy/outgoingCalls"
+	}
+	var calls []json.RawMessage
+	for _, item := range items {
+		raw, err := query(method, struct {
+			Item json.RawMessage `json:"item"`
+		}{item})
+		if err != nil {
+			return nil, err
+		}
+		var next []json.RawMessage
+		if err := json.Unmarshal(raw, &next); err != nil {
+			return nil, err
+		}
+		if next != nil && calls == nil {
+			calls = []json.RawMessage{}
+		}
+		calls = append(calls, next...)
+	}
+	return json.Marshal(calls)
+}
