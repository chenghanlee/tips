+		{"static use chain: Long tag/2 includes only the /2 call", arityAt{longHead, "tag", 1}, false, []aritySite{useLong}},
+	})
+
+	// Calls through a delegating facade reach the target only at the arity the
+	// delegate forwards to. Whether a defdelegate line itself is listed is left
+	// open, except that a line forwarding elsewhere must not be listed.
+	runArityDelegateReferences(t, server, []arityDelegateReferenceCase{
+		{"Dual pick/2 excludes facade /2 calls forwarded to Pairwise", arityAt{dualPick2Head, "pick(", 0}, []aritySite{directPickTwo}, []aritySite{viaPickTwo, viaPickOne, switchPick1, switchPick2}},
