+func TestArity_UndefinedArityIsNotAnotherArity(t *testing.T) {
+	server, cleanup := setupTestServer(t)
+	defer cleanup()
+	root := server.projectRoot
+
+	const file = "lib/my_app/broken.ex"
+	indexFile(t, server.store, root, file, arityBrokenSrc)
+	uri := "file://" + filepath.Join(root, file)
+	call := aritySite{file, "run(x)"}
+
+	_, line, col := arityAt{call, "run", 1}.resolve(t, root)
+	if got := definitionAt(t, server, uri, line, col); len(got) != 0 {
+		t.Errorf("definition of undefined run/1 = %v, want none", arityLocKeys(root, got))
+	}
+	if hover := hoverAt(t, server, uri, line, col); hover != nil {
+		t.Errorf("hover of undefined run/1 = %q, want none", hover.Contents.Value)
+	}
+	for _, head := range []string{"def run(a, b), do: {a, b}", "def run(a, b, c), do: {a, b, c}"} {
+		_, hl, hc := arityAt{aritySite{file, head}, "run", 1}.resolve(t, root)
+		for _, k := range arityLocKeys(root, arityReferences(t, server, uri, hl, hc, false)) {
+			if k == aritySiteKeys(t, call)[0] {
+				t.Errorf("references of %q include the run/1 call", head)
+			}
+		}
+	}
+}
