+		{"references of the /3 head without declarations", arityAt{head3, "create", 1}, false, []aritySite{call3a, call3b}},
+		{"references of a /2 call with declarations", arityAt{call2, "create", 1}, true, []aritySite{call2, head2a, head2b}},
+		{"references of a /2 call without declarations", arityAt{call2, "create", 1}, false, []aritySite{call2}},
