+// Explicit imports of SharedLib.Pinger (arity matrix fixture) that the index
+// does not list as calls: a capture beside an indexed call, a capture in a file
+// with no other call, a one-line def body, and an import through an alias.
+
+// file: lib/my_app/ping_user.ex
+const importPingUserSrc = `defmodule MyApp.PingUser do
+  import SharedLib.Pinger
+
+  def calls(x) do
