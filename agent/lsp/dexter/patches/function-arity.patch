+		uri, line, col := arityAt{pingerHead, "ping", 1}.resolve(t, root)
+		for _, loc := range arityReferences(t, server, uri, line, col, false) {
+			rel, _ := filepath.Rel(root, strings.TrimPrefix(string(loc.URI), "file://"))
+			text := strings.Split(aritySrc(t, rel), "\n")[loc.Range.Start.Line]
