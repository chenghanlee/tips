+
+func aritySrc(t *testing.T, file string) string {
+	t.Helper()
+	if src, ok := arityMatrixFiles[file]; ok {
+		return src
+	}
+	if src, ok := aritySingleFiles[file]; ok {
+		return src
+	}
+	t.Fatalf("unknown fixture file %q", file)
+	return ""
+}
+
+// arityLine returns the 0-based line whose trimmed text is exactly text.
+func arityLine(t *testing.T, src, text string) uint32 {
+	t.Helper()
+	found := -1
+	for i, line := range strings.Split(src, "\n") {
+		if strings.TrimSpace(line) == text {
+			if found >= 0 {
+				t.Fatalf("line %q is not unique", text)
+			}
+			found = i
+		}
+	}
+	if found < 0 {
+		t.Fatalf("line %q not found", text)
+	}
+	return uint32(found)
+}
+
+// aritySite names one source line by file and trimmed text.
+type aritySite struct{ file, text string }
+
+func (s aritySite) line(t *testing.T) uint32 {
+	t.Helper()
+	return arityLine(t, aritySrc(t, s.file), s.text)
+}
+
+// arityAt is a cursor: the anchor's first occurrence on a site's line, plus offset.
+type arityAt struct {
+	site   aritySite
+	anchor string
+	offset int
+}
+
+func (a arityAt) resolve(t *testing.T, root string) (string, uint32, uint32) {
+	t.Helper()
+	line := a.site.line(t)
+	text := strings.Split(aritySrc(t, a.site.file), "\n")[line]
+	col := strings.Index(text, a.anchor)
+	if col < 0 {
+		t.Fatalf("anchor %q not on %v", a.anchor, a.site)
+	}
+	// The cursor must sit on an identifier that is not a keyword such as def.
+	pos := col + a.offset
+	start, end := pos, pos
+	for start > 0 && isArityIdent(text[start-1]) {
+		start--
+	}
+	for end < len(text) && isArityIdent(text[end]) {
+		end++
+	}
+	switch word := text[start:end]; word {
+	case "", "def", "defp", "do", "end", "fn":
+		t.Fatalf("cursor %v lands on %q", a, word)
+	}
+	return "file://" + filepath.Join(root, a.site.file), line, uint32(pos)
+}
+
+func isArityIdent(c byte) bool {
+	return c == '_' || c == '?' || c == '!' || c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9'
+}
+
+func aritySiteKeys(t *testing.T, sites ...aritySite) []string {
+	t.Helper()
+	keys := make([]string, 0, len(sites))
+	for _, s := range sites {
+		keys = append(keys, fmt.Sprintf("%s:%d", s.file, s.line(t)))
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+// arityLocKeys keeps every returned location, including duplicates.
+func arityLocKeys(root string, locs []protocol.Location) []string {
+	keys := make([]string, 0, len(locs))
+	for _, loc := range locs {
+		rel, err := filepath.Rel(root, strings.TrimPrefix(string(loc.URI), "file://"))
+		if err != nil || strings.HasPrefix(rel, "..") {
+			rel = string(loc.URI)
+		}
+		keys = append(keys, fmt.Sprintf("%s:%d", rel, loc.Range.Start.Line))
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+func arityReferences(t *testing.T, server *Server, uri string, line, col uint32, includeDeclaration bool) []protocol.Location {
+	t.Helper()
+	result, err := server.References(context.Background(), &protocol.ReferenceParams{
+		TextDocumentPositionParams: protocol.TextDocumentPositionParams{
+			TextDocument: protocol.TextDocumentIdentifier{URI: protocol.DocumentURI(uri)},
+			Position:     protocol.Position{Line: line, Character: col},
+		},
+		Context: protocol.ReferenceContext{IncludeDeclaration: includeDeclaration},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return result
+}
+
+func sameKeys(got, want []string) bool {
+	return strings.Join(got, " ") == strings.Join(want, " ")
+}
+
+// arityOccurrence checks that locs hold exactly one location on the site's
+// line and that it spans the function name inside the call written as anchor.
+func arityOccurrence(t *testing.T, root string, locs []protocol.Location, site aritySite, anchor, name string) {
+	t.Helper()
+	line := site.line(t)
+	text := strings.Split(aritySrc(t, site.file), "\n")[line]
+	callAt, nameAt := strings.Index(text, anchor), strings.Index(anchor, name+"(")
+	if callAt < 0 || nameAt < 0 {
+		t.Fatalf("call %q with %q not on %v", anchor, name, site)
+	}
+	start := uint32(callAt + nameAt)
+	var hits []protocol.Range
+	for _, loc := range locs {
+		if loc.URI == protocol.DocumentURI("file://"+filepath.Join(root, site.file)) && loc.Range.Start.Line == line {
+			hits = append(hits, loc.Range)
+		}
+	}
+	if len(hits) != 1 || hits[0].Start.Character != start || hits[0].End.Line != line ||
+		hits[0].End.Character != start+uint32(len(name)) {
+		t.Errorf("ranges on %v = %v, want exactly %d:%d-%d", site, hits, line, start, start+uint32(len(name)))
+	}
+}
+
+func setupArityMatrix(t *testing.T) (*Server, func()) {
+	t.Helper()
+	server, cleanup := setupTestServer(t)
+	for rel, src := range arityMatrixFiles {
+		indexFile(t, server.store, server.projectRoot, rel, src)
+	}
+	return server, cleanup
+}
+
+// arityDefinitionCase expects the definition at a cursor to be exactly want.
+type arityDefinitionCase struct {
+	name string
+	at   arityAt
+	want []aritySite
+}
+
+func runArityDefinitions(t *testing.T, server *Server, prefix string, cases []arityDefinitionCase) {
+	t.Helper()
+	for _, tc := range cases {
+		t.Run(prefix+tc.name, func(t *testing.T) {
+			expectArityDefinition(t, server, tc.at, tc.want...)
+		})
+	}
+}
+
+func expectArityDefinition(t *testing.T, server *Server, at arityAt, want ...aritySite) {
+	t.Helper()
+	root := server.projectRoot
+	uri, line, col := at.resolve(t, root)
+	got := arityLocKeys(root, definitionAt(t, server, uri, line, col))
+	if keys := aritySiteKeys(t, want...); !sameKeys(got, keys) {
+		t.Errorf("definition = %v, want %v", got, keys)
+	}
+}
+
+// expectArityDefinitionWithin accepts any non-empty subset of allowed, for a
+// call that several clauses of one arity answer.
+func expectArityDefinitionWithin(t *testing.T, server *Server, at arityAt, allowed ...aritySite) {
+	t.Helper()
+	root := server.projectRoot
+	uri, line, col := at.resolve(t, root)
+	got := arityLocKeys(root, definitionAt(t, server, uri, line, col))
+	keys := aritySiteKeys(t, allowed...)
+	if len(got) == 0 {
+		t.Fatalf("no definition, want a subset of %v", keys)
+	}
+	for _, k := range got {
+		if !slices.Contains(keys, k) {
+			t.Errorf("definition = %v, want only %v", got, keys)
+		}
+	}
+}
+
+// arityHoverCase expects the hover at a cursor to contain want and, when
+// wrong is set, not to contain wrong.
+type arityHoverCase struct {
+	name        string
+	at          arityAt
+	want, wrong string
+}
+
+func runArityHovers(t *testing.T, server *Server, prefix string, cases []arityHoverCase) {
+	t.Helper()
+	for _, tc := range cases {
+		t.Run(prefix+tc.name, func(t *testing.T) {
+			expectArityHover(t, server, tc.at, tc.want, tc.wrong)
+		})
+	}
+}
+
+func expectArityHover(t *testing.T, server *Server, at arityAt, want, wrong string) {
+	t.Helper()
+	uri, line, col := at.resolve(t, server.projectRoot)
+	hover := hoverAt(t, server, uri, line, col)
+	if hover == nil {
+		t.Fatalf("no hover, want %q", want)
+	}
+	if !strings.Contains(hover.Contents.Value, want) || wrong != "" && strings.Contains(hover.Contents.Value, wrong) {
+		t.Errorf("hover = %q, want %q and not %q", hover.Contents.Value, want, wrong)
+	}
+}
+
+// arityReferenceCase expects the references at a cursor to be exactly want.
+type arityReferenceCase struct {
+	name    string
+	at      arityAt
+	include bool
+	want    []aritySite
+}
+
+func runArityReferences(t *testing.T, server *Server, prefix string, cases []arityReferenceCase) {
+	t.Helper()
+	root := server.projectRoot
+	for _, tc := range cases {
+		t.Run(prefix+tc.name, func(t *testing.T) {
+			uri, line, col := tc.at.resolve(t, root)
+			got := arityLocKeys(root, arityReferences(t, server, uri, line, col, tc.include))
+			if want := aritySiteKeys(t, tc.want...); !sameKeys(got, want) {
+				t.Errorf("references = %v, want %v", got, want)
+			}
+		})
+	}
+}
+
+// arityDelegateReferenceCase expects the references at a cursor, without
+// declarations, to hold every include line and no exclude line.
+type arityDelegateReferenceCase struct {
+	name             string
+	at               arityAt
+	include, exclude []aritySite
+}
+
+func runArityDelegateReferences(t *testing.T, server *Server, cases []arityDelegateReferenceCase) {
+	t.Helper()
+	root := server.projectRoot
+	for _, tc := range cases {
+		t.Run("delegate references/"+tc.name, func(t *testing.T) {
+			uri, line, col := tc.at.resolve(t, root)
+			got := arityLocKeys(root, arityReferences(t, server, uri, line, col, false))
+			expectArityKeysPresent(t, got, aritySiteKeys(t, tc.include...), true)
+			expectArityKeysPresent(t, got, aritySiteKeys(t, tc.exclude...), false)
+		})
+	}
+}
+
+func expectArityKeysPresent(t *testing.T, got, keys []string, present bool) {
+	t.Helper()
+	problem := "must not include"
+	if present {
+		problem = "missing"
+	}
+	for _, k := range keys {
+		if slices.Contains(got, k) != present {
+			t.Errorf("references = %v, %s %s", got, problem, k)
+		}
+	}
+}
+
+// arityOccurrenceCase expects the references of head, without declarations,
+// to hold exactly the fn token of the call written as anchor on site's line.
+type arityOccurrenceCase struct {
+	name       string
+	head       arityAt
+	site       aritySite
+	anchor, fn string
+}
+
+func runArityOccurrences(t *testing.T, server *Server, cases []arityOccurrenceCase) {
+	t.Helper()
+	root := server.projectRoot
+	for i := range cases {
+		tc := &cases[i]
+		t.Run("references/same line selects the "+tc.name+" occurrence", func(t *testing.T) {
+			uri, line, col := tc.head.resolve(t, root)
+			arityOccurrence(t, root, arityReferences(t, server, uri, line, col, false), tc.site, tc.anchor, tc.fn)
+		})
+	}
+}
