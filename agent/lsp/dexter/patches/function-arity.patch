+		{"control: qualified full MyApp.Typed.t()", arityAt{user("@spec again(MyApp.Typed.t()) :: boolean()"), "Typed.t", 6}, []aritySite{typeT}},
+		{"control: qualified function Typed.build is not a type", arityAt{user("def make(name), do: Typed.build(name)"), "build", 1}, nil},
