+package lsp
+
+import (
+	"encoding/json"
+	"fmt"
+	"path/filepath"
+)
+
+// ConfigureElixirLS selects the saved-file lifecycle before initialization.
+// Keep settings in the LSP client: editor configuration files are not read by MCP.
+func (c *Client) ConfigureElixirLS(workspace, mixEnv string) {
+	if mixEnv == "" {
+		mixEnv = "test"
+	}
+	c.elixirLSRoot = workspace
+	c.elixirLSMixEnv = mixEnv
+}
+
+func (c *Client) IsElixirLS() bool { return c.elixirLSRoot != "" }
+
+func (c *Client) elixirLSConfiguration(raw json.RawMessage) (any, error) {
+	var params struct {
+		Items []struct {
+			Section string `json:"section"`
+		} `json:"items"`
+	}
+	if err := json.Unmarshal(raw, &params); err != nil {
+		return nil, err
+	}
+	result := make([]any, len(params.Items))
+	settings := map[string]any{
+		"autoBuild": true, "fetchDeps": false, "dialyzerEnabled": false,
+		"suggestSpecs": false, "enableTestLenses": false, "mcpEnabled": false,
+		"mixEnv": c.elixirLSMixEnv,
+	}
+	for i, item := range params.Items {
+		switch item.Section {
+		case "elixirLS":
+			result[i] = settings
+		case "":
+			result[i] = map[string]any{"elixirLS": settings}
+		default:
+			result[i] = nil
+		}
+	}
+	return result, nil
+}
+
+func (c *Client) checkElixirLSWorkspace(path string) error {
+	if !c.IsElixirLS() {
+		return nil
+	}
+	root, err := filepath.EvalSymlinks(c.elixirLSRoot)
+	if err != nil {
+		return err
+	}
+	file, err := filepath.Abs(path)
+	if err != nil {
+		return err
+	}
+	file, err = filepath.EvalSymlinks(file)
+	if err != nil {
+		return err
+	}
+	relative, err := filepath.Rel(root, file)
+	if err != nil || !filepath.IsLocal(relative) {
+		return fmt.Errorf("file %q is outside this ElixirLS session's workspace %q", path, root)
+	}
+	return nil
+}
