+package lsp
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestDexterSavedDocuments(t *testing.T) {
+	root := t.TempDir()
+	path := filepath.Join(root, "sample.ex")
+	if err := os.WriteFile(path, []byte("defmodule Sample do\nend\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	c, pipe := testClient()
+	c.ConfigureDexter(root)
+	if err := c.OpenFile(context.Background(), path); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, []byte("defmodule Sample do\n def value, do: :new\nend\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.SyncFile(context.Background(), path); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.SyncFile(context.Background(), path); err != nil {
+		t.Fatal(err)
+	}
+	got := syncMessages(t, pipe)
+	methods := []string{}
+	for _, message := range got {
+		methods = append(methods, message.Method)
+	}
+	encoded, _ := json.Marshal(methods)
+	if string(encoded) != `["textDocument/didOpen","textDocument/didChange","textDocument/didSave"]` {
+		t.Fatalf("missing save or duplicate rebuild: %s", encoded)
+	}
+}
+
+func TestDexterRejectsOtherWorktreeAndEscapingSymlink(t *testing.T) {
+	root := t.TempDir()
+	outside := filepath.Join(t.TempDir(), "other.ex")
+	if err := os.WriteFile(outside, []byte("defmodule Other do\nend\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	alias := filepath.Join(root, "alias.ex")
+	if err := os.Symlink(outside, alias); err != nil {
+		t.Fatal(err)
+	}
+	c, _ := testClient()
+	c.ConfigureDexter(root)
+	for _, path := range []string{outside, alias} {
+		if err := c.OpenFile(context.Background(), path); err == nil {
+			t.Fatalf("accepted outside input: %s", path)
+		}
+	}
+}
