+package watcher
+
+import (
+	"context"
+	"testing"
+
+	"github.com/isaacphi/mcp-language-server/internal/protocol"
+)
+
+type dexterRecordingClient struct {
+	recordingClient
+	synced []string
+}
+
+func (c *dexterRecordingClient) IsDexter() bool         { return true }
+func (c *dexterRecordingClient) IsFileOpen(string) bool { return true }
+func (c *dexterRecordingClient) NotifyChange(_ context.Context, path string) error {
+	c.synced = append(c.synced, path)
+	return nil
+}
+
+func TestDexterAtomicReplacementRefreshesOpenDocument(t *testing.T) {
+	client := &dexterRecordingClient{}
+	watcher := NewWorkspaceWatcher(client)
+	watcher.handleFileEvent(context.Background(), "file:///fixture.ex", protocol.FileChangeType(protocol.Created))
+	if len(client.synced) != 1 || client.synced[0] != "/fixture.ex" {
+		t.Fatalf("atomic replacement did not refresh the document: %v", client.synced)
+	}
+	if len(client.events) != 1 || client.events[0].Type != protocol.FileChangeType(protocol.Created) {
+		t.Fatalf("replacement did not trigger index update: %v", client.events)
+	}
+}
