+package lsp
+
+import (
+	"fmt"
+	"path/filepath"
+)
+
+// ConfigureDexter enables worktree checks and saved-document synchronization.
+func (c *Client) ConfigureDexter(workspace string) {
+	c.dexterRoot = workspace
+}
+
+func (c *Client) IsDexter() bool { return c.dexterRoot != "" }
+
+func (c *Client) checkDexterWorkspace(path string) error {
+	if !c.IsDexter() {
+		return nil
+	}
+	root, err := filepath.EvalSymlinks(c.dexterRoot)
+	if err != nil {
+		return err
+	}
+	file, err := filepath.Abs(path)
+	if err != nil {
+		return err
+	}
+	file, err = filepath.EvalSymlinks(file)
+	if err != nil {
+		return err
+	}
+	relative, err := filepath.Rel(root, file)
+	if err != nil || !filepath.IsLocal(relative) {
+		return fmt.Errorf("file %q is outside this Dexter session's workspace %q", path, root)
+	}
+	return nil
+}
