@@ -0,0 +1,38 @@
+defmodule Engine.Search.Store.Backends.ProjectIsolationTest do
+  use ExUnit.Case, async: false
+  use Patch
+
+  import Engine.Test.Entry.Builder
+  import Forge.Test.Fixtures
+
+  alias Engine.Dispatch
+  alias Engine.Search.Store.Backends.Ets
+  alias Forge.Project
+
+  setup do
+    project = project()
+    Engine.set_project(project)
+    Ets.destroy_all(project)
+
+    patch(Dispatch, :erpc_call, fn Expert.Progress, :begin, [_title, _opts] ->
+      {:ok, System.unique_integer([:positive])}
+    end)
+
+    patch(Dispatch, :erpc_cast, fn Expert.Progress, _function, _args -> true end)
+    on_exit(fn -> Ets.destroy_all(project) end)
+    {:ok, project: project}
+  end
+
+  test "another project's basename registration cannot take over this store", %{project: project} do
+    foreign_name = {:ets_search, Project.name(project)}
+    :yes = :global.register_name(foreign_name, self())
+    on_exit(fn -> :global.unregister_name(foreign_name) end)
+
+    backend = start_supervised!(Ets)
+    assert {:ok, _status} = Ets.prepare(backend)
+
+    entry = definition(path: Path.join(Project.root_path(project), "owned.ex"))
+    assert :ok = Ets.insert([entry])
+    assert [^entry] = Ets.reduce([], fn item, entries -> [item | entries] end)
+  end
+end
