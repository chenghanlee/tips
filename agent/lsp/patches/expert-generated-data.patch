--- a/apps/forge/test/forge/project_test.exs
+++ b/apps/forge/test/forge/project_test.exs
@@ -198,0 +199,22 @@
+    test "creates isolated generated data under each checkout's _build", %{tmp_dir: tmp_dir} do
+      for side <- ["left", "right"] do
+        root = Path.join([tmp_dir, side, "app"])
+        File.mkdir_p!(root)
+        project = root |> Document.Path.to_uri() |> Project.new()
+        workspace = Path.join(root, "_build/expert")
+
+        assert :ok = Project.ensure_workspace(project)
+        assert Project.workspace_path(project) == workspace
+        assert File.read!(Path.join(workspace, ".gitignore")) == "*\n"
+        assert Project.build_path(project) == Path.join(workspace, "build")
+        assert Project.workspace_path(project, "indexes") == Path.join(workspace, "indexes")
+        refute File.exists?(Path.join(root, ".expert"))
+
+        marker = Path.join(workspace, "existing-index")
+        File.write!(marker, side)
+        assert :ok = Project.ensure_workspace(project)
+        assert File.read!(marker) == side
+      end
+    end
+
+    @tag :tmp_dir
